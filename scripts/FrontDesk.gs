/**
 * build 24.1: the feed outgrew one cell (Sheets holds 50,000 characters in a cell; the feed passed it on Oct 15, 2026). It is written across
 * row 1 of the feed tab in pieces of 45,000 characters, A1 then B1 then C1, and read back by joining them left to right until an empty cell.
 * Every reader and writer goes through this one pair of calls, so the rest of the script is unchanged.
 */
const FEED_CHUNK_ = 45000;
function feedCell_(ss) {
  const sh = ss.getSheetByName('feed');
  return {
    getValue: function () {
      const width = Math.max(1, sh.getLastColumn());
      const row = sh.getRange(1, 1, 1, width).getValues()[0];
      let s = '';
      for (let i = 0; i < row.length; i++) { const v = row[i]; if (v === '' || v == null) break; s += String(v); }
      return s;
    },
    setValue: function (v) {
      const s = String(v == null ? '' : v);
      const parts = [];
      let i = 0;
      while (i < s.length) {
        let end = Math.min(s.length, i + FEED_CHUNK_);
        const c = s.charCodeAt(end - 1);
        if (end < s.length && c >= 0xD800 && c <= 0xDBFF) end--; // never split a surrogate pair across two cells
        parts.push(s.slice(i, end)); i = end;
      }
      if (!parts.length) parts.push('');
      const width = Math.max(parts.length, sh.getLastColumn(), 1);
      if (sh.getMaxColumns() < width) sh.insertColumnsAfter(sh.getMaxColumns(), width - sh.getMaxColumns());
      const row = parts.concat(new Array(width - parts.length).fill(''));
      sh.getRange(1, 1, 1, width).setValues([row]);
    }
  };
}

