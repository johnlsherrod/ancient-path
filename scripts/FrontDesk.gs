      const id = readConfig_().acSheetId;
      const hist = id ? rows_(SpreadsheetApp.openById(id).getSheetByName('history')) : [];
      const same = hist.filter(h => Number(h['men_on_the_list']) === Number(men.on_the_list) && Number(h['hand_raised']) === Number(men.hand_raised) && Number(h['wait_list']) === Number(men.wait_list));
      if (hist.length > 1 && same.length === hist.length) since = ' None of the three has moved since the first count on ' + Utilities.formatDate(toDate_(hist[0]['generated']), FD.TZ, 'MMM d') + '.';
      else if (same.length >= 2) since = ' Unchanged since ' + Utilities.formatDate(toDate_(same[0]['generated']), FD.TZ, 'MMM d') + '.';
    } catch (e) {}
    rows.push({ kind: 'The list',
      fact: 'The email list holds ' + times_(Number(men.on_the_list || 0), 'man', 'men') + '. ' + Number(men.hand_raised || 0) + ' ' + (Number(men.hand_raised) === 1 ? 'has' : 'have') + ' raised a hand to talk; ' + Number(men.wait_list || 0) + ' ' + (Number(men.wait_list) === 1 ? 'is' : 'are') + ' waiting for the next cohort.',
      means: 'The list is the men in ActiveCampaign who hear from us. A hand raised is a man who replied asking to talk; the wait list is men who asked for a seat after the room filled. Counted weekly' + (ac.generated ? ', last on ' + Utilities.formatDate(toDate_(ac.generated), FD.TZ, 'EEE MMM d') : '') + '.' + since,
      go: '#ac-sec', label: 'See the count', ask: 'Who has a hand raised, and what did he ask for?' });
  }
  // the money
  let plan = '';
  try {
    const sp = SpreadsheetApp.openById(cfg.forecastSheetId || FD.FORECAST_SHEET_ID).getSheetByName('2027 Target');
    if (sp) {
      const d = sp.getDataRange().getDisplayValues();
      const cellAfter = (label) => { const r = d.find(x => String(x[0] || '').trim().toLowerCase() === label); return r ? String(r[1] || '').trim() : ''; };
      const target = cellAfter('target for 2027');
      const hdr = d.findIndex(x => String(x[0] || '').trim().toLowerCase() === 'quarter');
      let q = null, yearPace = '';
      if (hdr >= 0) {
        const Hq = {}; d[hdr].forEach((h, i) => { Hq[String(h).trim().toLowerCase()] = i; });
        const row = d.slice(hdr + 1).find(x => /^q1\b/i.test(String(x[0] || '')));
        if (row) q = { name: String(row[0]).replace(/\s*\(.*$/, ''), goal: row[Hq['goal']] || '', takes: row[Hq['what it takes']] || '' };
        const yr = d.slice(hdr + 1).find(x => /^year$/i.test(String(x[0] || '').trim()));
        if (yr && Hq['monthly pace'] !== undefined) yearPace = yr[Hq['monthly pace']] || '';
      }
      if (target) plan = 'The plan expects nothing to book before January, the first paid cohort. The 2027 target is ' + target + (yearPace ? ', about ' + yearPace + ' a month once it starts' : '') + (q ? '; ' + q.name + '’s goal is ' + q.goal + (q.takes ? ', and it takes ' + String(q.takes).replace(/\.$/, '').replace(/^([a-z])/, (m) => m.toLowerCase()) : '') : '') + '. The pathway below is how those groups and clients get filled.';
    }
  } catch (e) { plan = 'The 2027 target sheet could not be read this run.'; }
  // build 22 — the road to January: the Q1 math, the leading counts with the week's change, the levers
  const payNote = (pay.recent || []).slice(0, 1).map(p => (p.what || '').replace(/^Payment of \$[\d.,]+ from /, '').replace(/ for Ancient Path Biblical Coaching$/, '')).filter(Boolean)[0];
  const road = roadCounts_(cfg, feed, ac);
  const seatedRows = (feed.roster || []).filter(r => r.seated);
  const byPerson = seatedRows.filter(r => r.referredBy).length;
  const finding = seatedRows.length ? 'Of the ' + seatedRows.length + ' men in the room, ' + byPerson + ' came through a person' + (seatedRows.length - byPerson ? ' and ' + (seatedRows.length - byPerson) + ' left no referrer' : '') + '; none came through search. Referrals are the lever.' : '';
  // build 26 — the road, tool by tool (put out · came · became), where it landed, what it cost, and the one move
  const planText = plan ? plan.replace(/ The pathway below is how those groups and clients get filled\.$/, '') : 'The 2027 target sheet could not be read this run.';
  let roadModel = null;
  try { roadModel = roadModel_(roadInputs_(ss, cfg, search, ac, { counts: road.counts, plan: planText, coachingAhead: ((feed.coaching && feed.coaching.upcoming) || []).length })); }
  catch (e) { alert_('The road could not be written: ' + e + '\n' + (e.stack || '')); }
  rows.push({ kind: 'The road to January',
    fact: (plan ? plan.replace(/ The pathway below is how those groups and clients get filled\.$/, '') : 'The 2027 target sheet could not be read this run.') + ' ' + money(pay.total30) + ' came in over the last thirty days — ' + times_(pay.count30 || 0, 'payment', 'payments') + (payNote && (pay.count30 || 0) === 1 ? ' (' + payNote + ')' : '') + '.',
    means: 'The leading counts, with the week\'s change, and the lever each one answers to. ' + finding,
    counts: road.counts, road: roadModel, pay: (pay.recent || []).slice(0, 5),
    go: 'https://docs.google.com/spreadsheets/d/' + (cfg.forecastSheetId || FD.FORECAST_SHEET_ID) + '/edit', label: 'Open the plan', ask: 'What has to be true by January to hit the first-quarter goal, and which lever is behind?' });
  // the search
  rows.push({ kind: 'The search',
    fact: search && search.sentences && search.sentences[0] ? search.sentences[0] : 'The search story is not on the desk yet; it appears once the monthly refresh has put a month on the Search profile.',
    means: search && search.rec ? 'The pages Google shows and men pass by are the pathway’s first signals. The first one to fix: ' + search.rec.for + ' — the new words are on its card.' : 'The pages Google shows and men pass by are the pathway’s first signals.',
    go: '#search-sec', label: 'See the search story', ask: 'Which page do men see most and never click?' });
  // the next step: the soonest taken move, else the first proposed move, else the search card, else the oldest card on the lane
  let next = null;
  const mv = feed.moves || {};
  const taken = (mv.taken || []).filter(t => t.status === 'taken').sort((a, b) => (a.due || '9').localeCompare(b.due || '9'));
  const open = (feed.actions || []).slice().sort((a, b) => String(a.firstSeen || '').localeCompare(String(b.firstSeen || '')));
  if (taken.length) next = { title: 'Make the move: ' + taken[0].move, body: taken[0].signal + (taken[0].due ? ' · due ' + Utilities.formatDate(dayDate_(taken[0].due), FD.TZ, 'MMM d') : '') + ' · ' + (taken[0].owner || ''), go: '#moves-sec', label: 'Open the moves' };
  else if ((mv.proposed || []).length) next = { title: 'Take the first move: ' + mv.proposed[0].move, body: mv.proposed[0].signal, go: '#moves-sec', label: 'See the pathway', move: mv.proposed[0] };
  else if (search && search.rec) next = { title: search.rec.do, body: search.rec.for, go: '#search-sec', label: 'Open the search story' };
  else if (open.length) next = { title: open[0].do, body: (open[0].for || '') + ' · for ' + open[0].owner, go: '#apc0', label: 'Show me the first one' };
  else next = { title: 'Nothing is waiting', body: 'The lane is clear and no move is open. Read what came in.', go: '#week-sec', label: 'Read what came in' };
  return { rows: rows, sentences: rows.map(r => r.fact), next: next, asOf: new Date().toISOString() };
}

/** build 22: the four leading counts with the week's change (from the AC history and the roster dates). Build 26: the levers moved into roadModel_ (the tool rows and the one move). */
function roadCounts_(cfg, feed, ac) {
  const men = (ac && ac.stages && ac.stages.men) || {};
  const roster = feed.roster || [];
  const now = Date.now(), wk = now - 7 * 864e5;
  let prev = null;
  try {
    const id = cfg.acSheetId;
    const hist = id ? rows_(SpreadsheetApp.openById(id).getSheetByName('history')) : [];
    const older = hist.filter(h => h['generated'] && (now - toDate_(h['generated'])) >= 6 * 864e5);
    prev = older.length ? older[older.length - 1] : null;
  } catch (e) {}
  const delta = (cur, p) => (p == null || cur == null) ? 'first week on the record' : (Number(cur) - Number(p) === 0 ? 'no change this week' : (Number(cur) - Number(p) > 0 ? '+' : '') + (Number(cur) - Number(p)) + ' this week');
  const signed = roster.filter(r => r.agreementSigned || r.handledAgreement);
  const signedWk = signed.filter(r => r.agreementSigned && new Date(r.agreementSigned).getTime() >= wk).length;
  const seatedMails = new Set(roster.filter(r => r.seated).map(r => String(r.email).toLowerCase()));
  const held = new Set(roster.filter(r => r.waitList && !r.seated).map(r => String(r.email).toLowerCase()));
  ((ac && ac.carrying_tags) || []).forEach(t => { if (/waitlist/i.test(String(t.tag || '')) && t.email && !seatedMails.has(String(t.email).toLowerCase())) held.add(String(t.email).toLowerCase()); });
  const counts = [
    { label: 'men on the list', n: men.on_the_list != null ? Number(men.on_the_list) : '—', change: delta(men.on_the_list, prev && prev['men_on_the_list']) },
    { label: 'conversations started', n: men.hand_raised != null ? Number(men.hand_raised || 0) + Number(men.in_conversation || 0) : '—', change: delta(men.hand_raised != null ? Number(men.hand_raised || 0) + Number(men.in_conversation || 0) : null, prev && (Number(prev['hand_raised'] || 0) + Number(prev['in_conversation'] || 0))) },
    { label: 'agreements signed', n: signed.length, change: signedWk ? '+' + signedWk + ' this week' : 'no change this week' },
    { label: 'January seats held', n: held.size, change: held.size ? 'the wait list, until January\'s seat link exists' : 'none yet — January\'s seat link is not open' }
  ];
  return { counts: counts };
}

// ───────────────────────────── build 26 · the road to January: put out · came · became ─────────────────────────────

/** A link that says where it was posted, so the next count can name where a man came from. Source and medium for email match what
 *  ActiveCampaign already adds (GA4 shows "activecampaign / email"). Any note already on the link is replaced, never doubled. */
function tagLink_(url, source, medium, campaign) {
  const full = String(url || '').trim();
  if (!/^https?:\/\//i.test(full)) return '';
  const hashAt = full.indexOf('#'), hash = hashAt >= 0 ? full.slice(hashAt) : '', noHash = hashAt >= 0 ? full.slice(0, hashAt) : full;
  const qAt = noHash.indexOf('?'), path = qAt >= 0 ? noHash.slice(0, qAt) : noHash;
  const keep = qAt >= 0 ? noHash.slice(qAt + 1).split('&').filter(p => p && !/^utm_/i.test(p)) : [];
  keep.push('utm_source=' + encodeURIComponent(source), 'utm_medium=' + encodeURIComponent(medium));
  if (campaign) keep.push('utm_campaign=' + encodeURIComponent(campaign));
  return path + '?' + keep.join('&') + hash;
}

/** The ISO week of a day in Central time, as 2026-W43: the move card's key carries it, so a card pressed Done stays done for that week. */
function isoWeekKey_(d) {
  const p = Utilities.formatDate(d, FD.TZ, 'yyyy-MM-dd').split('-').map(Number);
  const t = new Date(Date.UTC(p[0], p[1] - 1, p[2]));
  t.setUTCDate(t.getUTCDate() + 4 - (t.getUTCDay() || 7));
  const jan1 = new Date(Date.UTC(t.getUTCFullYear(), 0, 1));
  const wk = Math.ceil(((t - jan1) / 864e5 + 1) / 7);
  return t.getUTCFullYear() + '-W' + (wk < 10 ? '0' : '') + wk;
}

/** Everything the road reads, gathered once from the record and handed to roadModel_ as plain data (so the model can be tested without a sheet).
 *  Nothing here is typed by hand: the roster, the Inbound notices, the Payments, the AC count, the Search profile, the Sends property,
 *  and an optional Reach tab that a reader script fills (day · tool · visits · views · spend) when site visits, video and ads are connected. */
function roadInputs_(ss, cfg, search, ac, extra) {
  extra = extra || {};
  const now = new Date(), d30 = new Date(now - 30 * 864e5);
  const tab = (name) => { const sh = ss.getSheetByName(name); return sh && sh.getLastRow() > 1 ? rows_(sh) : []; };
  const roster = tab('Roster').map(r => ({ seated: !!r['seated'], referredBy: String(r['referred by'] || '').trim(), waitList: !!r['wait list'] && !r['seated'] }));
  const takers = new Set();
  tab('Inbound').forEach(r => {
    if (String(r['kind']) !== 'Enrolled' || String(r['handling'] || '').indexOf('ours') >= 0) return;
    if (!r['received'] || toDate_(r['received']) < d30) return;
    if (isOurs_(cfg, r['email'], r['name'])) return;
    if (/breaking free/i.test(String(r['summary'] || ''))) return; // the cohort's own seat is not a self-directed course
    takers.add(String(r['email'] || r['name'] || '').toLowerCase());
  });
  const pay = tab('Payments').filter(r => r['received'] && toDate_(r['received']) >= d30);
  let reach = null;
  const rs = ss.getSheetByName('Reach');
  if (rs && rs.getLastRow() > 1) {
    reach = {};
    rows_(rs).forEach(r => {
      const when = r['day'] ? toDate_(r['day']) : null, t = String(r['tool'] || '').toLowerCase().trim();
      if (!when || when < d30 || !t) return;
      const o = reach[t] || (reach[t] = { visits: 0, views: 0, spend: 0 });
      o.visits += numOr_(r['visits']) || 0; o.views += numOr_(r['views']) || 0; o.spend += numOr_(r['spend']) || 0;
    });
  }
  const men = (ac && ac.stages && ac.stages.men) || {}, ch = (ac && ac.stages && ac.stages.churches) || {}, tags = (ac && ac.tags) || {};
  const carrying = (ac && ac.carrying_tags) || [];
  // a church tag on one of our own test contacts is not a church that replied
  const churchTests = carrying.filter(t => /^church: (no-program|has-program|referred|not us)/i.test(String(t.tag || '')) && isOurs_(cfg, t.email, t.name)).length;
  const replyTags = (Number(ch.has_program) || 0) + (Number(ch.no_program) || 0) + (Number(ch.referred) || 0) + (Number(ch.not_us) || 0);
  const seatedRows = roster.filter(r => r.seated);
  const pageSet = {};
  (extra.counts || []).forEach(c => { pageSet[c.label] = c; });
  let ask = null;
  try { ask = PropertiesService.getScriptProperties().getProperty('asked:referral:room'); } catch (e) {}
  return {
    now: now.toISOString(), roomSize: cfg.roomSize || 0,
    seated: seatedRows.length, byPerson: seatedRows.filter(r => r.referredBy).length,
    bySearch: seatedRows.filter(r => /google|search|article|blog|online/i.test(r.referredBy)).length,
    waitList: roster.filter(r => r.waitList).length,
    lastRoomAsk: ask || null,
    onList: men.on_the_list != null ? Number(men.on_the_list) : null,
    handRaised: Number(men.hand_raised || 0), inConversation: Number(men.in_conversation || 0),
    optIns: (Number(tags['Opt-in: email']) || 0) + (Number(tags['Opt-in: text']) || 0),
    prospects: Number(tags['Partner: prospect']) || 0,
    churchTotal: Number(tags['Church']) || (Number(ch.no_reply) || 0) + replyTags,
    churchReplies: Math.max(0, replyTags - churchTests),
    churchMix: { has: Number(ch.has_program) || 0, start: Number(ch.no_program) || 0, referred: Number(ch.referred) || 0 },
    campaigns: Array.isArray(ac && ac.campaigns) ? ac.campaigns : [], windowDays: Number(ac && ac.window_days) || 7, acAt: (ac && ac.generated) || null,
    search: search && search.totals ? { month: search.month, imp: search.totals.imp, clk: search.totals.clk, asOf: search.asOf || '', live: search.live || [] } : null,
    reach: reach, courses30: takers.size,
    pay: { total30: pay.reduce((s, r) => s + Number(r['amount'] || 0), 0), count30: pay.length },
    coachingAhead: extra.coachingAhead != null ? extra.coachingAhead : null,
    counts: extra.counts || [], plan: extra.plan || '',
    links: { search: 'https://docs.google.com/spreadsheets/d/' + (cfg.searchSheetId || FD.SEARCH_SHEET_ID) + '/edit', plan: 'https://docs.google.com/spreadsheets/d/' + (cfg.forecastSheetId || FD.FORECAST_SHEET_ID) + '/edit', ac: cfg.acSheetId ? 'https://docs.google.com/spreadsheets/d/' + cfg.acSheetId + '/edit' : '' }
  };
}

/** The road, tool by tool: what we put out, what came, what became of it; then where it landed, what it cost, and the one move.
 *  Plain data in, plain data out. Every sentence is built from the record; where the record cannot see a tool the row says "not connected". */
function roadModel_(inp) {
  const now = new Date(inp.now), n = (v) => Number(v) || 0;
  const MONTHS = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
  const dayText = (iso) => { const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso || '')); return m ? MONTHS[Number(m[2]) - 1] + ' ' + Number(m[3]) : ''; };
  const ageDays = (iso) => { const m = /^(\d{4})-(\d{2})-(\d{2})/.exec(String(iso || '')); return m ? Math.floor((now - new Date(Date.UTC(+m[1], +m[2] - 1, +m[3], 12))) / 864e5) : null; };
  const one = (c, a, b) => c + ' ' + (c === 1 ? a : b);
  const money = (v) => '$' + Number(v || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const reach = inp.reach || {};
  const tools = [];

  // ── Articles
  const s = inp.search, live = s ? s.live : [];
  let art = { key: 'articles', tool: 'Articles', state: s ? 'counted' : 'waiting', go: inp.links.search, goLabel: 'Open the search sheet', ask: 'Which page do men see most and never click?' };
  art.put = live.length ? one(live.length, 'article is', 'articles are') + ' live on the blog.' : 'No article is live yet.';
  if (s) {
    const age = ageDays(s.asOf);
    art.came = 'Google showed our pages ' + one(s.imp, 'time', 'times') + ' in ' + s.month + ' and ' + (s.clk === 1 ? '1 person' : s.clk + ' people') + ' clicked through' +
      (s.asOf ? ' (counted ' + dayText(s.asOf) + (age != null && age > 10 ? '; the monthly count has not run since' : '') + ')' : '') + '.' +
      (reach.articles ? ' The site counted ' + one(Math.round(reach.articles.visits), 'visit', 'visits') + ' from articles in the last thirty days.' : '');
    if (age != null && age > 10) art.state = 'older';
  } else art.came = 'The search count is not on the desk yet; it appears after the monthly count.';
  art.became = n(inp.seated) ? inp.bySearch + ' of the ' + inp.seated + ' men in the room came through search.' : 'No one is seated yet.';
  if (!s) art.means = 'Articles are the doors a man finds at night. The first month of numbers will show which doors are found.';
  else if (s.clk === 0 && s.imp >= 20) art.means = 'Men see the pages and pass them by. The title and the line under it are what to change; the search story names the first page to fix.';
  else if (!inp.bySearch) art.means = 'Search has not brought a man into the room yet. A new article takes months to rank, so this lever works on a longer clock than January; keep adding doors, and let the pages already shown earn their clicks.';
  else art.means = inp.bySearch + ' of the room found us through search. Keep adding doors.';
  art.links = live.map(a => {
    const slug = String(a.url).replace(/^.*\/blog\//, '').replace(/[^a-z0-9-]/gi, '').toLowerCase();
    return { title: a.title, url: a.url, email: tagLink_(a.url, 'activecampaign', 'email', slug), video: tagLink_(a.url, 'youtube', 'video', slug), social: tagLink_(a.url, 'social', 'social', slug) };
  });
  tools.push(art);

  // ── Email
  const camps = inp.campaigns || [], w = inp.windowDays || 7;
  const sum = (f) => { let t = null; camps.forEach(c => { for (const k of f) { const v = Number(c[k]); if (isFinite(v) && c[k] !== '' && c[k] != null) { t = (t || 0) + v; break; } } }); return t; };
  const opens = sum(['uniqueopens', 'unique_opens', 'opens']), clicks = sum(['uniquelinkclicks', 'unique_link_clicks', 'linkclicks', 'clicks']);
  const mail = { key: 'email', tool: 'Email', state: 'counted', go: inp.links.ac, goLabel: 'Open the count', ask: 'Which segment should hear from us next, and what should the email say?' };
  mail.put = camps.length ? one(camps.length, 'email was', 'emails were') + ' sent in the last ' + w + ' days.' : 'No email has gone to the list in the last ' + w + ' days.' + (inp.onList != null ? ' The list holds ' + one(inp.onList, 'man', 'men') + '.' : '');
  mail.came = camps.length ? (opens != null || clicks != null ? [opens != null ? opens + ' opened' : '', clicks != null ? clicks + ' clicked' : ''].filter(Boolean).join(' and ') + '.' : 'Opens and clicks are on the campaigns line of the count.') : 'Nothing went out, so nothing came.';
  if (reach.email) mail.came += ' The site counted ' + one(Math.round(reach.email.visits), 'visit', 'visits') + ' from email in the last thirty days.';
  mail.became = one(inp.handRaised, 'man has', 'men have') + ' raised a hand and ' + one(inp.optIns, 'man has', 'men have') + ' opted in by email or text.';
  mail.means = !camps.length && n(inp.onList) >= 100 ? 'Email is the one tool that reaches men who already asked to hear from us, and it has been quiet. One note to one segment, not the whole list, is the next step.' : 'Each email is a door back into the work. Watch which one a man acts on and write the next to it.';
  tools.push(mail);

  // ── Churches
  const chu = { key: 'churches', tool: 'Churches', state: 'counted', go: inp.links.ac, goLabel: 'Open the count', ask: 'Which churches opened our emails and never replied?' };
  chu.put = inp.churchTotal ? one(inp.churchTotal, 'church is', 'churches are') + ' on the list' + (inp.prospects ? ', and ' + inp.prospects + ' more partner prospects are loaded for the next note.' : '.') : 'No partner or church is on the list yet.';
  chu.came = inp.churchReplies ? inp.churchReplies + ' of ' + inp.churchTotal + ' have replied: ' + inp.churchMix.has + ' already have a program, ' + inp.churchMix.start + ' would like to start one, ' + inp.churchMix.referred + ' referred us on.' : (inp.churchTotal ? 'None of the ' + inp.churchTotal + ' has replied yet.' : '');
  chu.became = inp.churchReplies ? 'Each reply is a conversation to hold.' : 'No church has asked for a group yet.';
  chu.means = inp.churchReplies ? 'A reply is a church that may lead its own group with us. Hold each conversation before sending the next note.' : (inp.churchTotal ? 'Silence after one note is common. The next note goes to the churches that opened ours and did not answer, written to them, not to the list.' : '');
  tools.push(chu);

  // ── People: a man telling a man
  const ppl = { key: 'people', tool: 'People', state: 'counted', go: '', ask: 'Who in the room came through a friend, and who was sent by someone else?' };
  const lastAskAge = inp.lastRoomAsk ? Math.floor((now - new Date(inp.lastRoomAsk)) / 864e5) : null;
  ppl.put = inp.lastRoomAsk ? 'The room was last asked for a name ' + (lastAskAge <= 0 ? 'today' : lastAskAge === 1 ? 'yesterday' : lastAskAge + ' days ago') + '.' : 'The room has not been asked for a name yet.';
  ppl.came = n(inp.seated) ? inp.byPerson + ' of the ' + inp.seated + ' men in the room came through a person.' : 'No one is seated yet.';
  ppl.became = n(inp.roomSize) ? inp.seated + ' of ' + inp.roomSize + ' seats are taken' + (inp.waitList ? ', and ' + inp.waitList + ' ' + (inp.waitList === 1 ? 'man waits' : 'men wait') + ' for a seat.' : '.') : '';
  ppl.means = n(inp.seated) && inp.byPerson * 2 >= inp.seated ? 'This is the channel that has worked: a man who trusts the room tells a man he trusts. The ask goes to the room once a week at most.' : 'Most of the room did not come through a person, so the ask to the room is not the lever yet.';
  tools.push(ppl);

  // ── Video and ads: shown as not connected until the desk can read them
  const vid = { key: 'video', tool: 'Video', state: reach.video ? 'counted' : 'not connected', go: '', ask: 'Which course should get the first video?' };
  vid.put = reach.video ? '' : 'Not connected.';
  vid.came = reach.video ? one(Math.round(reach.video.views), 'view', 'views') + ' and ' + one(Math.round(reach.video.visits), 'visit', 'visits') + ' to the site in the last thirty days.' : 'Views and visits appear here once a video channel exists that the desk can read.';
  vid.became = reach.video ? '' : 'Nothing is typed here by hand.';
  vid.means = 'A first video for each course is the open door the plan wants, posted where men already look.';
  tools.push(vid);
  const ads = { key: 'ads', tool: 'Ads', state: reach.ads && reach.ads.spend ? 'counted' : 'not connected', go: inp.links.plan, goLabel: 'Open the plan', ask: 'What do the ads have to do for the plan to hold in January?' };
  ads.put = reach.ads && reach.ads.spend ? money(reach.ads.spend) + ' spent in the last thirty days.' : 'Not connected.';
  ads.came = reach.ads && reach.ads.visits ? one(Math.round(reach.ads.visits), 'visit', 'visits') + ' to the site from ads in the last thirty days.' : 'Spend and clicks appear here once the ads account is read.';
  ads.became = reach.ads && reach.ads.spend ? '' : 'The plan starts Google Ads in November.';
  ads.means = 'Ads buy a door to a page that already answers the search. The pages are being fixed first, so the money lands on words that work.';
  tools.push(ads);

  // ── Where it landed (the three doors the site converts to)
  const cnt = {}; (inp.counts || []).forEach(c => { cnt[c.label] = c; });
  const conv = n(inp.handRaised) + n(inp.inConversation), signed = cnt['agreements signed'] ? n(cnt['agreements signed'].n) : 0, held = cnt['January seats held'] ? n(cnt['January seats held'].n) : 0;
  const became = {
    list: inp.onList != null ? one(inp.onList, 'man is', 'men are') + ' on the email list' + (cnt['men on the list'] && cnt['men on the list'].change ? ' (' + cnt['men on the list'].change + ')' : '') + '.' : '',
    group: inp.seated + ' of ' + inp.roomSize + ' seats are taken; ' + one(signed, 'agreement is', 'agreements are') + ' signed' + (cnt['agreements signed'] && /\+/.test(cnt['agreements signed'].change || '') ? ' (' + cnt['agreements signed'].change + ')' : '') + '; ' + one(held, 'man holds', 'men hold') + ' a place for January.',
    oneOnOne: inp.coachingAhead != null ? (inp.coachingAhead ? one(inp.coachingAhead, 'coaching session is', 'coaching sessions are') + ' ahead.' : 'No coaching session is ahead.') : '',
    course: one(inp.courses30, 'man started', 'men started') + ' a self-directed course in the last thirty days.',
    conversations: conv
  };
  became.means = n(inp.onList) >= 100 && conv <= 2
    ? inp.onList + ' men are on the list and ' + conv + ' ' + (conv === 1 ? 'has' : 'have') + ' started a conversation. More names will not move January as much as a clear ask to the men already there.'
    : 'Each step down this list is a man choosing the next one. Watch where the numbers thin out; that is where the next move goes.';

  // ── What it cost, and what came in
  const spend = reach.ads ? reach.ads.spend : 0;
  const cost = { spend: spend ? money(spend) + ' on ads in the last thirty days' + (conv ? ', ' + money(spend / conv) + ' for each conversation started' : '') + (signed ? ', ' + money(spend / signed) + ' for each agreement signed' : '') + '.' : 'The ads account is not connected, so no spend is counted. The desk will not guess a cost.', came: money(inp.pay.total30) + ' came in over the last thirty days from ' + one(inp.pay.count30, 'payment', 'payments') + '.' };
  cost.means = spend ? 'Cost for each man is what the ads spent divided by the men who became a conversation or an agreement.' : 'Cost for each man is spend divided by men who became a conversation or an agreement. It shows here the day the ads account is read, never before.';

  // ── The one move: the lever the record proves, then the quiet channels, then the doors
  let move;
  if (n(inp.seated) >= 3 && inp.byPerson * 2 >= inp.seated && (lastAskAge == null || lastAskAge >= 7)) {
    move = { lever: 'referral', title: 'Ask the room for one name', reason: inp.byPerson + ' of the ' + inp.seated + ' men in the room came through a person, and the room ' + (lastAskAge == null ? 'has not been asked for a name.' : 'was last asked ' + lastAskAge + ' days ago.'), label: 'See the email' };
  } else if (!camps.length && n(inp.onList) >= 100) {
    move = { lever: 'email', title: 'Send the next email to one segment', reason: inp.onList + ' men are on the list and no email has gone out in the last ' + w + ' days.', label: 'Ask the desk', ask: mail.ask };
  } else if (n(inp.churchTotal) >= 50 && !inp.churchReplies) {
    move = { lever: 'churches', title: 'Write to the churches again', reason: 'None of the ' + inp.churchTotal + ' churches has replied; the next note goes to the ones that opened and did not answer.', label: 'Ask the desk', ask: chu.ask };
  } else {
    move = { lever: 'article', title: 'Post the next article', reason: one(live.length, 'article is', 'articles are') + ' live. Every new one is another door a man can find at night.', label: 'Open the search sheet', go: inp.links.search };
  }
  move.key = 'road:' + move.lever + ':' + isoWeekKey_(now);

  // ── the summary line the closed section shows
  const summary = [
    'Put out: ' + one(live.length, 'article', 'articles') + ' live, ' + (camps.length ? one(camps.length, 'email', 'emails') + ' this week' : 'no email in ' + w + ' days') + '.',
    s ? 'Came: Google showed our pages ' + one(s.imp, 'time', 'times') + ' in ' + s.month + ' and ' + (s.clk === 1 ? '1 person' : s.clk + ' people') + ' clicked.' : 'Came: the search count is not on the desk yet.',
    'Became: ' + one(conv, 'conversation', 'conversations') + ' started, ' + one(signed, 'agreement', 'agreements') + ' signed, ' + one(held, 'man', 'men') + ' holding a place for January.'
  ];
  return { asOf: inp.now, tools: tools, became: became, cost: cost, move: move, summary: summary, plan: inp.plan || '' };
}

