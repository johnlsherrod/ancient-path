}
/** The Done this week row for how a card closed: the word, and what it went on to say. */
function honestRow_(o, how) {
  const h = String(how || '');
  if (h === CLOSED_PROVEN_) { o.word = CLOSED_PROVEN_; const wp = /^move:page:|^search:/.test(String(o.key || '')) && o.rec && o.rec.kind === 'words' ? 'The desk read the live page and found the new search title and description on it. The Moves, below, shows the move Made, Waiting for the Check.' : provenWent_(o.key); o.went = wp; o.fwent = wp; }
