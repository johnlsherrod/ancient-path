      if (how === 'Waiting') { o.went = 'Approved. The row is ticked on the Actions tab. The Publisher posts it the next weekday at 7:10 AM Central, and this card closes as Proven when the article is live.'; o.fwent = o.went; } // build 36.1
      return honestRow_(o, how);
