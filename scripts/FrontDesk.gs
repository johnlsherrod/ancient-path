    const base = row[H['kept on']] || row[H['first seen']];
    if (!base) return;
    const age = daysBetween_(dayOf_(base), today);
    if (age < CARD_STALE_DAYS_ + CARD_STALE_GRACE_DAYS_) return;
    row[H['status']] = 'done'; row[H['done at']] = now; row[H['mark done by hand']] = true; row[H['closed how']] = CLOSED_DROPPED_;
    if (/^move:/.test(key)) { try { const mv = ss.getSheetByName('Moves'); if (mv) ensureMovesCols_(mv); moveStatus_(ss, key.slice(5), 'dropped', { reason: 'Left untouched for ' + age + ' days' }); } catch (e) {} }
    try { cardLog_('card dropped', key + ' (untouched ' + age + ' days)', null); } catch (e) {}
  });
}
