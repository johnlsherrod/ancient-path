function cardStale_(who, b) { return pressLock_('card_stale', who, b, () => cardStaleDo_(who, b)); }
function cardStaleDo_(who, b) {
  const key = String(b.actionKey || ''), what = String(b.what || '');
  if (!/^[a-z]+:\S+$/.test(key) || key.length > 200 || (what !== 'keep' && what !== 'drop')) throw { code: 'bad_action' };
  if (!canClose_(who, key)) throw { code: 'not_yours' };
  const ss = SpreadsheetApp.openById(FD.SHEET_ID);
  ensureBuild30_(ss);
  if (what === 'drop') {
    const mk = /^move:(.+)$/.exec(key);
    if (mk) { try { const mv = ss.getSheetByName('Moves'); if (mv) ensureMovesCols_(mv); moveStatus_(ss, mk[1], 'dropped', { reason: 'Left untouched for 30 days' }); } catch (e) {} }
    const r = actionClose_(who, key, { keepMove: true, how: CLOSED_DROPPED_, word: CLOSED_DROPPED_, went: 'Nothing was done. You dropped it after it waited more than 30 days.' });
    cardLog_('card dropped', key, who);
