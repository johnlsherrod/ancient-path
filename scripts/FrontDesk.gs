  const ss = SpreadsheetApp.openById(FD.SHEET_ID), cell = feedCell_(ss);
  let closed = null, card = null;
  if (ruled) {
    closed = actionClose_(who, key, { how: accepted ? CLOSED_CONCERNS_ : CLOSED_SAID_, word: accepted ? CLOSED_CONCERNS_ : 'Set aside',
      went: accepted ? 'Every line is ruled. The accepted lines are written on the Concerns tab of the Guide sheet; the Read door follows within ten minutes.' : 'Every line is set aside. Nothing was written on the Concerns tab.' });
  } else {
    try { // the card stays on the lane with its lines as they stand
      const feed = JSON.parse(cell.getValue() || 'null');
