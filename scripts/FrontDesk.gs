    if (s.a === 'accept' && s.rec) concernUndo_(s.rec);
    delete st[line.i]; concernStateSet_(key, st);
  } else {
    if (st[line.i]) throw { code: 'bad_action' }; // ruled once; Undo takes it back for ten minutes
    st[line.i] = { a: act, at: Date.now() };
    if (act === 'accept') st[line.i].rec = concernWrite_(line);
