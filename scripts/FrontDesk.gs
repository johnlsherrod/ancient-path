 * ("63 min, about 20 to hear" → 20, "59 min, free" → 59, "A short read · about 5 minutes" → 5), else null.
 */
function minutesOf_(cut, cost) {
  const n = '(\\d{1,3}|[a-z]+(?:[\\s-][a-z]+)?)';
  let m, last = null;
  const re = new RegExp('\\babout\\s+' + n + '\\s+min(?:ute)?s?\\b', 'gi');
  const c = String(cut == null ? '' : cut);
  while ((m = re.exec(c))) { const v = numberOf_(m[1]); if (v) last = v; }
  if (last) return last;
  const t = String(cost == null ? '' : cost);
  m = new RegExp('\\babout\\s+' + n + '\\s+to\\s+(?:hear|read|watch|listen)\\b', 'i').exec(t);
  if (m && numberOf_(m[1])) return numberOf_(m[1]);
  m = new RegExp('\\babout\\s+' + n + '\\s+min(?:ute)?s?\\b', 'i').exec(t);
  if (m && numberOf_(m[1])) return numberOf_(m[1]);
  const hr = /(\d+)\s*(?:hrs?|hours?)\b/i.exec(t), mn = /(\d+)\s*min/i.exec(t);
  if (hr || mn) { const v = (hr ? Number(hr[1]) * 60 : 0) + (mn ? Number(mn[1]) : 0); return v > 0 ? v : null; }
  return null;
}

// ---- the Release List: the Research Engine's Entries, read and written by the desk ----
/** "Oct 21, 2026 8:35 PM" (Central, the Research reader's stamp) or a real Date → a Date, else null. */
function stampDate_(v) {
  if (v instanceof Date) return isNaN(v) ? null : v;
  const t = String(v == null ? '' : v).trim();
  const m = /^([A-Za-z]{3,9})\.?\s+(\d{1,2}),\s+(\d{4})\s+(\d{1,2}):(\d{2})\s*([AaPp])\.?[Mm]/.exec(t);
  if (!m) return null;
  const mo = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'].indexOf(m[1].slice(0, 3).toLowerCase());
  if (mo < 0) return null;
  let h = Number(m[4]) % 12; if (m[6].toLowerCase() === 'p') h += 12;
  const guess = Date.UTC(Number(m[3]), mo, Number(m[2]), h, Number(m[5]));
