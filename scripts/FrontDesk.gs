}
/** What the record showed, per kind, for a card closed as Proven. */
function provenWent_(key) {
  const k = (/^([a-z]+):/.exec(String(key || '')) || [])[1] || '';
  const w = { first: 'A session is on the calendar now.', seat: 'He is enrolled, or the seat email is in sent mail.', styling: 'The page reports every style rule accepted.', bwm: 'His signed agreement is on file, or our ask to him is in sent mail.', agr: 'His signed agreement is on file, or our ask to him is in sent mail.',
    wl: 'His signed agreement is on file, or our reply to him is in sent mail.', askans: 'His answers are in, or our ask to him is in sent mail.', pay: 'The payment is matched to a man.', cal: 'The desk can read the calendar now.',
    room: 'A seat opened.', hand: 'He is no longer waiting on a hand raised.', move: 'The Moves shows it done.', check: 'The Moves shows it checked.', search: 'The live page carries the new search title and description.',
    bug: 'The message is no longer left in the inbox.', testimony: 'His offer has a decision on the testimony sheet.', look: 'The message is no longer left in the inbox.', contact: 'The message is handled in the record.' };
