/** Runs fn holding the script lock. op, who and b describe the press so it can be kept when the lock is busy; kept is what the caller is told then. With no op (a caller that cannot be replayed) a busy lock still throws busy. */
function pressLock_(op, who, b, fn, kept) {
  if (PRESS_HELD_) return fn(); // replaying inside run() or a press that already holds the lock
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(PRESS_WAIT_MS_)) {
    if (!op || !PRESS_OPS_[op]) throw { code: 'busy' };
    return pressKeep_(op, who, b, kept);
