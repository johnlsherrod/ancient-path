  // build 34: Done is retired. The card carries the acts that do its work (acts), or says it has none yet (noAct); the page draws no Done either way.
  delete out.acts; delete out.noAct;
  let acts = null; try { acts = actsOf_(x, out, w); } catch (e) { acts = null; }
  if (Array.isArray(acts)) { out.acts = acts; delete out.button; if (acts[0] && acts[0].word) out.word = acts[0].word; } else if (acts === null) { out.noAct = true; delete out.button; out.then = NO_ACT_THEN_; out.fthen = NO_ACT_THEN_; delete out.went; delete out.fwent; }
  if (out.owner) out.owner = ownerFirst_(out.owner, ctx.people); // build 32: one owner, one name (“John Sherrod” is “John”)
  // build 33: every fourth line opens with its lead word (build 33.1: and nothing in front of it); the press word is the honest one; a card past its day says so; a card untouched for 30 days asks Drop or keep
  if (out.then && !out.noAct) out.then = withLead_(x.kind, out.then);
  if (out.fthen && !out.noAct) out.fthen = withLead_(x.kind, out.fthen);
  if (out.word && !out.acts && !(out.rec && out.rec.kind === 'words')) out.word = honestWord_(out.key, out.word); // a page-words card keeps Proven: the live page is what closes it
