function ro_(ro, field, words) { return ro && ro[field] ? [words.charAt(0).toUpperCase() + words.slice(1) + ' ' + fmtC_(ro[field], 'MMM d')] : []; }

const CARD_FIELDS_ = ['title', 'ftitle', 'fwhy', 'why', 'then', 'fthen', 'button', 'word', 'went', 'fwent', 'dropWent', 'wordBy', 'when', 'serves', 'moment', 'kind', 'from', 'rec', 'start', 'moves', 'checkButtons', 'linkLabel', 'notice', 'reply', 'pic'];
/**
 * The new fields for one action. The action's own fields (key owner do for because link firstSeen rule asked note raised touched) stay exactly as they are.
 * Never throws: a card whose words cannot be written keeps the generic five lines.
