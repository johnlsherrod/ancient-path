/** Counts from our own records (the skill ap-segments holds the words). members = names only, for Ask the desk. */
function segments_(ss, cfg, feed, search, ac) {
  const roster = feed.roster || [];
  const nm = (r) => r.name || r.email;
  const sentBy = /wife|spouse|husband|pastor|church|mother|father|parent/i;
  const friend = roster.filter(r => (r.referredBy && !sentBy.test(r.referredBy)) || (r.cameAsWitness && !(r.referredBy && sentBy.test(r.referredBy)))); // build 37: a witness who took a step of their own is Brought by a friend
  const sent = roster.filter(r => r.referredBy && sentBy.test(r.referredBy));
  const group = roster.filter(r => /breaking free/i.test(r.hereFor || '') || r.waitList || r.seated);
  const coach = roster.filter(r => /one-on-one/i.test(r.door || ''));
  let pain = 0, painPhrases = [];
  try {
    const sp = SpreadsheetApp.openById(cfg.searchSheetId || FD.SEARCH_SHEET_ID);
    const t = (name) => { const sh = sp.getSheetByName(name); if (!sh || sh.getLastRow() < 2) return []; const d = sh.getDataRange().getDisplayValues(), H = d[0]; return d.slice(1).map(r => { const o = {}; H.forEach((h, i) => { o[h] = r[i]; }); return o; }); };
    const prof = t('Profile'), log = t('Monthly log');
    const keys = Array.from(new Set(log.map(r => monthKey_(r['Month'])).filter(Boolean))).sort();
    const cur = keys[keys.length - 1];
    const painSet = new Set(prof.filter(r => /^2/.test(String(r['Ring'] || '').trim())).map(r => String(r['Phrase'] || '').trim()));
    log.filter(r => monthKey_(r['Month']) === cur && painSet.has(String(r['Phrase'] || '').trim())).forEach(r => { const n = numOr_(r['Impressions']) || 0; pain += n; if (n) painPhrases.push(String(r['Phrase']).trim()); });
  } catch (e) {}
  const ch = (ac && ac.stages && ac.stages.churches) || {};
  const tags = (ac && ac.tags) || {};
  const churches = (ch.has_program || 0) + (ch.no_program || 0) + (ch.referred || 0) + (tags['Partner: prospect'] || 0);
  return [
    { key: 'friend', label: 'Brought by a friend', count: friend.length, of: roster.length, from: 'the referred-by line on the agreement, and a witness who took a step of their own', members: friend.map(r => nm(r) + (r.cameAsWitness ? ' (came as a witness)' : '')), ask: 'Who was brought by a friend, and by whom?' },
    { key: 'group', label: 'Looking for a group', count: group.length, of: roster.length, from: 'Breaking Free on the agreement, a seat, or the wait list', members: group.map(nm), ask: 'Who came looking for a group?' },
    { key: 'coach', label: 'Wants a coach', count: coach.length, of: roster.length, from: 'the one-on-one door', members: coach.map(nm), ask: 'Who wants one-on-one coaching?' },
    { key: 'sent', label: 'Sent by a wife or a pastor', count: sent.length, of: roster.length, from: 'a referred-by line naming a spouse, a pastor or a church', members: sent.map(nm), ask: 'Who was sent by a wife or a pastor?' },
    { key: 'alone', label: 'Searching alone, at night', count: pain, of: null, unit: 'searches this month', from: 'the pain phrases on the Search profile (ring 2)', members: painPhrases, ask: 'Which pain searches showed our pages this month?' },
    { key: 'church', label: 'Church partners', count: churches, of: null, unit: 'churches', from: 'the church reply tags and partner prospects in ActiveCampaign', members: [], ask: 'Which churches replied, and what did they say?' }
  ];
}

