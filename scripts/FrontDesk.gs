// ---- a card untouched for 30 days asks Drop or keep; unanswered for seven more, it drops itself ----
/** { days, dropOn } for an open card the script owns that has waited CARD_STALE_DAYS_ since it was first seen or last kept; null otherwise. */
function staleOf_(key, baseIso, today) {
  const k = String(key || '');
  if (!baseIso || !SCRIPT_ACTION_KEY.test(k) || WORKSHOP_KEY_.test(k) || !today) return null;
  const base = dayOf_(baseIso), age = daysBetween_(base, today);
