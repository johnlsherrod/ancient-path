// ---- build 29 · four more presses from the new desk: after_set, team_note, notice_set, and move_set that can make its own row ----
const AFTER_ANSWERS_ = { 'opened up': 'opened', 'quietly': 'quiet', 'not reached': 'none', 'opened': 'opened', 'quiet': 'quiet', 'none': 'none' };
const AFTER_DID_ = { opened: 'It opened something', quiet: 'It landed quietly', none: 'We did not get to it' };
