/** yyyy-MM-dd (Central) for a Date or a date-like cell. */
function dayOf_(v) { return Utilities.formatDate(toDate_(v), FD.TZ, 'yyyy-MM-dd'); }
/** build 25: a room's day lives only on the Rooms tab. These read it; none of them carries a weekday as a word. */
function utcNoon_(day) { const p = String(day).split('-').map(Number); return new Date(Date.UTC(p[0], p[1] - 1, p[2], 12)); }
/** A yyyy-MM-dd shown as its own calendar day ('EEEE' = the day name, 'MMM d' = the date), the same on any clock. */
function fmtDay_(day, pat) { return Utilities.formatDate(utcNoon_(day), 'GMT', pat); }
/** "<days>, 7:00 PM Central" → { text: '7:00 PM', short: '7:00' }, or null when the Rooms tab names no hour. */
function hourOf_(meets) {
  const m = /(\d{1,2})(?::(\d{2}))?\s*([ap])\.?m\b/i.exec(String(meets || ''));
  if (!m) return null;
  const mm = m[2] || '00';
  return { text: Number(m[1]) + ':' + mm + ' ' + m[3].toUpperCase() + 'M', short: Number(m[1]) + ':' + mm };
}
/** The date of a Weeks row's night: the "night" column, or (a sheet not yet renamed) the second column. */
function nightOf_(r) {
  if (!r) return null;
  const d = nightDate_(r['night']);
  if (d) return d;
  const ks = Object.keys(r);
  return ks.length > 1 ? nightDate_(r[ks[1]]) : null;
}
/** build 28.3: a day cell as a Date — a real date, "Wed Nov 4, 2026" (a day in words) or 2026-11-04 — or null. Words and ISO days come back at noon UTC, so dayOf_ (Central) gives the same calendar day. */
function nightDate_(v) {
  if (v instanceof Date) return isNaN(v) ? null : v;
  const t = String(v === undefined || v === null ? '' : v).trim();
  if (!t) return null;
  const iso = /^(\d{4})-(\d{2})-(\d{2})$/.exec(t);
  if (iso) return new Date(Date.UTC(Number(iso[1]), Number(iso[2]) - 1, Number(iso[3]), 12));
  const w = /([A-Za-z]{3,9})\.?\s+(\d{1,2}),?\s+(\d{4})/.exec(t);
  if (!w) return null;
  const mo = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'].indexOf(w[1].slice(0, 3).toLowerCase());
  return mo < 0 ? null : new Date(Date.UTC(Number(w[3]), mo, Number(w[2]), 12));
}
/** The room whose nights the reminder follows: the one named on Config as the cohort, else the first cohort on the Rooms tab. */
function reminderRoom_(ss, cfg) {
  const rs = rooms_(ss);
  return rs.find(r => sameRoom_(r.room, cfg.cohortName)) || rs.find(r => r.kind === 'cohort') || null;
}
/** A room's nights as yyyy-MM-dd: its first night, then every seven days for its weeks. */
function roomNights_(rm) {
  if (!rm || !rm.firstNight) return [];
  const out = [];
  for (let k = 0; k < Math.max(1, rm.weeks || 1); k++) out.push(addDays_(rm.firstNight, 7 * k));
  return out;
}
/** The date of Week N for a room, from the Weeks tab ('' when the row is not there). */
function weekNight_(ss, room, week) {
  const sh = ss.getSheetByName('Weeks');
  if (!sh) return '';
  const rs = rooms_(ss);
  const hit = rows_(sh).filter(r => nightOf_(r) && Number(r['week']) === Number(week))
    .find(r => String(r['room'] || '').trim() ? sameRoom_(r['room'], room) : (rs.length && sameRoom_(rs[0].room, room)));
  return hit ? dayOf_(nightOf_(hit)) : '';
}
/** yyyy-MM-dd plus n days, by the calendar (no clock-change drift). */
function addDays_(day, n) { const p = day.split('-').map(Number); return new Date(Date.UTC(p[0], p[1] - 1, p[2] + n)).toISOString().slice(0, 10); }
/** A yyyy-MM-dd as a Date at noon Central-ish, safe to show as a day. */
function dayDate_(day) { const p = day.split('-').map(Number); return new Date(p[0], p[1] - 1, p[2], 12); }

/** Makes the Weeks tab and seeds both tabs the first time a run finds them empty. Never writes over a row somebody filled. */
