const CLOSED_PROVEN_ = 'Proven', CLOSED_SAID_ = 'Said done', CLOSED_DROPPED_ = 'Dropped', CLOSED_LAPSED_ = 'Lapsed', CLOSED_WATCHED_ = 'Watched';
const CARD_STALE_DAYS_ = 30, CARD_STALE_GRACE_DAYS_ = 7;
// build 34: Folded is a row the script folded into another card or record (a stale hold row, an older Workshop card, a page move redrawn on The Moves). It is not a press.
const LAPSE_KEY_ = /^(add|road|search|fu|prom|research):/;

/** The Actions tab's two new columns: "closed how" and "kept on" (the day Keep was pressed on a card untouched for 30 days). Made once, after the columns it has. */
function ensureBuild33_(ss) {
