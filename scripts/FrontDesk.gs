// ───────────────────────────── build 31 · the Workshop on Your Desk ─────────────────────────────
// John, Nov 4, 2026: no fifth view. A partner's question and the weekday update card are cards in Today's lane (a waiting partner first); a partner's need is a signal in
// Signals Waiting (Add · Set aside); the Through a Partner row shows what partners see. The record is the Partner Signals tab of the Research Engine sheet
// (date · part · answer · words · who · item · our answer), copied every weekday at 6:52 AM. This script only ever writes the "our answer" cell, one row at a time, found by its item key.

const PS_UNDO_MS_ = 10 * 60 * 1000;      // a press can be taken back for ten minutes; the server holds the minute, not the page
const PS_TTL_ = 660;
const PS_WHYS_ = { covered: 'Covered', notours: 'Not ours', notnow: 'Not now' };
const PS_NOW_DAYS_ = 30;                 // Not now comes back a month on, as every other signal does
const WORKSHOP_KEY_ = /^workshop:\d{4}-\d{2}-\d{2}$/;
const WORKSHOP_URL_ = 'https://claude.ai/artifact/YZ2Mn9nRNx8pnP3hk8qVWm';

/** Partner Signals, found by header words. Returns { sh, C: column positions, rows: [{ r (sheet row), date, part, answer, words, who, item, ours }] }, or null when the tab is not there. */
function psRead_() {
  const sh = SpreadsheetApp.openById(RESEARCH_SHEET_ID_).getSheetByName('Partner Signals');
  if (!sh) return null;
  const data = sh.getDataRange().getValues();
  if (!data.length) return null;
  const at = (re) => data[0].findIndex(h => re.test(String(h || '').trim().toLowerCase()));
  const C = { date: at(/^date$/), part: at(/^part$/), answer: at(/^answer$/), words: at(/^words$/), who: at(/^who$/), item: at(/^item$/), ours: at(/^our answer$/) };
  if (C.item < 0 || C.ours < 0 || C.answer < 0 || C.part < 0) return null;
  const cell = (row, i) => i >= 0 ? String(row[i] == null ? '' : (row[i] instanceof Date ? Utilities.formatDate(row[i], FD.TZ, 'MMM d, yyyy') : row[i])).trim() : '';
  const rows = [];
  for (let i = 1; i < data.length; i++) {
    const item = cell(data[i], C.item);
    if (!item) continue;
    rows.push({ r: i + 1, date: cell(data[i], C.date), part: cell(data[i], C.part), answer: cell(data[i], C.answer), words: cell(data[i], C.words), who: cell(data[i], C.who), item: item, ours: cell(data[i], C.ours) });
  }
  return { sh: sh, C: C, rows: rows };
}
function psDay_(text) { try { const d = new Date(text); return isNaN(d) ? '' : dayOf_(d); } catch (e) { return ''; } }
/** An optional tab on the Research Engine sheet as rows by header words (the weekday Workshop update keeps these two tabs in step with the Workshop page). */
function psTab_(name) {
  try {
    const sh = SpreadsheetApp.openById(RESEARCH_SHEET_ID_).getSheetByName(name);
    return sh && sh.getLastRow() > 1 ? rows_(sh) : [];
  } catch (e) { return []; }
}
function psPartRow_(name) {
  const want = String(name || '').trim().toLowerCase();
  return psTab_('Workshop parts').find(p => String(p['name'] || '').trim().toLowerCase() === want) || null;
}
/** The reply a partner reads when we answer a need. Each line follows the part's state, so it is true on the day (John, Nov 4). */
function psReply_(choice, partName, state) {
  const P = String(partName || '').trim(), s = String(state || '').trim().toLowerCase();
  if (choice === 'notours') return 'This sits outside what we’re building. We’d be glad to talk it through with you.';
  if (choice === 'notnow') return 'It’s on our list for later, and we’ll come back to it.';
  if (!P || !s) throw { code: 'no_state' };
  const live = s === 'live' || s === 'early', build = s === 'in build' || s === 'starting', plan = s === 'planned';
  if (!live && !build && !plan) throw { code: 'no_state' };
  if (choice === 'add') return live ? 'Thank you. We’re carrying this into the next ' + P + ' release.'
    : build ? 'Thank you. We’re carrying this into the ' + P + ' build.'
    : 'Thank you. We’re carrying this into the ' + P + ' plan.';
  if (choice === 'covered') return live ? P + ' already does this. You can walk it on The Work.'
    : build ? P + ' is being built to do this. You can follow it on The Work.'
    : P + ' is planned to do this. You can follow it on The Work.';
  throw { code: 'bad_action' };
}
/** What the desk shows for the Workshop, admins only. Every part is read on its own, so a tab that cannot be read drops only its own key. */
function partnersX_() {
  const out = { read: false, owner: '', uses: [], asks: [], needs: [], stats: { use: {}, asks: 0, needs: 0, needsAnswered: 0, starts: 0 }, starts: [], parts: [], rels: [], url: WORKSHOP_URL_ };
  let ps = null;
  try { ps = psRead_(); } catch (e) { ps = null; }
  if (ps) {
    out.read = true;
    const week = new Date(Date.now() - 7 * 864e5), pdm = psDoneMap_();
    ps.rows.forEach(r => {
      const day = psDay_(r.date);
      if (r.answer === 'Ask') { out.stats.asks++; if (!r.ours) out.asks.push({ item: r.item, date: r.date, day: day, who: r.who, words: r.words, part: r.part }); }
      else if (r.answer === 'Need') {
        out.stats.needs++;
        if (r.ours) { const pk = pdm[r.item]; if (pk && pk.kind === 'need' ? pk.at >= week.getTime() : (day && new Date(day) >= week)) out.stats.needsAnswered++; }
        else { const pr = psPartRow_(r.part) || {}; out.needs.push({ item: r.item, date: r.date, day: day, who: r.who, words: r.words, part: r.part, state: String(pr['state'] || ''), when: String(pr['when'] || ''), line: String(pr['line'] || '') }); }
      } else if (/^(use|maybe|not yet)$/i.test(r.answer)) {
        const u = out.stats.use[r.part] || (out.stats.use[r.part] = { Use: 0, Maybe: 0, 'Not yet': 0 });
        const k = r.answer.toLowerCase() === 'use' ? 'Use' : r.answer.toLowerCase() === 'maybe' ? 'Maybe' : 'Not yet';
        u[k]++;
        out.uses.push({ part: r.part, answer: k, who: r.who, date: r.date, day: day });
      } else if (r.part === 'Getting Started') { out.stats.starts++; out.starts.push({ date: r.date, who: r.who, offer: r.answer, courses: r.words.replace(/^Courses:\s*/i, '') }); }
    });
    out.uses.sort((a, b) => (b.day || '').localeCompare(a.day || '')); out.uses = out.uses.slice(0, 40); out.starts.sort((a, b) => String(b.date).localeCompare(String(a.date))); out.starts = out.starts.slice(0, 40);
    out.asks.sort((a, b) => (a.day || '').localeCompare(b.day || ''));
    out.needs.sort((a, b) => (b.day || '').localeCompare(a.day || ''));
  }
  try { out.owner = teamOwner_(); } catch (e) {}
  try { out.parts = psTab_('Workshop parts').map(p => ({ name: String(p['name'] || ''), state: String(p['state'] || ''), when: String(p['when'] || '') })).filter(p => p.name); } catch (e) {}
  try { out.rels = psTab_('Workshop releases').map(p => ({ date: String(p['date'] || ''), part: String(p['part'] || ''), text: String(p['text'] || '') })).filter(p => p.text); } catch (e) {}
  return out;
}

function psStamp_(item, o) { try { CacheService.getScriptCache().put('ps:' + item, JSON.stringify(o), PS_TTL_); } catch (e) {} psDoneSet_(item, o); }
function psStampGet_(item) { let v = null; try { v = JSON.parse(CacheService.getScriptCache().get('ps:' + item) || 'null'); } catch (e) { v = null; } return v || psDoneGet_(item); }
function psFind_(ps, item, answer) {
  const row = ps && ps.rows.find(r => r.item === item);
  if (!row) throw { code: 'none' };
  if (answer && row.answer !== answer) throw { code: 'bad_action' };
  return row;
}
function psAdmin_(who) { if (!who || who.role !== 'admin') throw { code: 'not_yours' }; }

/** partner_answer — Send on a partner's question. Writes the "our answer" cell of that row, once. b: { item, text }. */
function partnerAnswer_(who, b) {
  psAdmin_(who);
  const item = String(b.item || '').trim(), text = bwmSan_(b.text, 1500);
  if (!item || item.length > 120) throw { code: 'bad_action' };
  if (!text) throw { code: 'empty' };
  return pressLock_('partner_answer', who, b, () => {
    const ps = psRead_(); if (!ps) throw { code: 'no_sheet' };
    const row = psFind_(ps, item, 'Ask');
    if (row.ours) return { ok: true, already: true, item: item, text: row.ours };
    ps.sh.getRange(row.r, ps.C.ours + 1).setValue(text);
    const now = new Date();
    const rec = { at: now.getTime(), kind: 'answer', by: pressBy_(who), owner: teamOwner_(), part: row.part };
    psStamp_(item, rec);
    const done = partnerDoneEntry_(item, rec, Object.assign({}, row, { ours: text }), { people: peopleSafe_() });
    psFeedDone_(done);
    relLog_(SpreadsheetApp.openById(RESEARCH_SHEET_ID_), 'partner', 'answered ' + item + ' (' + row.part + ')');
    return { ok: true, item: item, at: now.toISOString(), by: rec.by, done: done, text: text, where: 'Your answer is kept with their question on the Partner Signals tab. At 7:15 AM the next weekday it shows under their question on their own Listening view.' };
  });
}
/** partner_need — Add or Set aside on a partner's need. Add makes the move (For Us to Do) and writes the reply line; Set aside writes the reason on the Moves tab and the reply line. b: { item, choice: add|covered|notours|notnow }. */
function partnerNeed_(who, b) {
  psAdmin_(who);
  const item = String(b.item || '').trim(), choice = String(b.choice || '').trim();
  if (!item || item.length > 120 || ['add', 'covered', 'notours', 'notnow'].indexOf(choice) < 0) throw { code: 'bad_action' };
  return pressLock_('partner_need', who, b, () => {
    const ps = psRead_(); if (!ps) throw { code: 'no_sheet' };
    const row = psFind_(ps, item, 'Need');
    if (row.ours) return { ok: true, already: true, item: item };
    const pr = psPartRow_(row.part) || {};
    const reply = psReply_(choice, row.part, pr['state']);
    const ss = SpreadsheetApp.openById(FD.SHEET_ID), cfg = readConfig_();
    const moveKey = 'own:partner-' + String(item).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 70);
    const signal = 'A partner’s need on ' + row.part + ': “' + bwmSan_(row.words, 220) + '”';
    const from = 'Partners · ' + row.part;
    const owner = teamOwner_();
    let made = null;
    try {
      if (choice === 'add') {
        try { made = moveAdd_(who, { moveKey: moveKey, move: 'partner need', signal: signal, from: from, owner: owner, link: WORKSHOP_URL_ }); }
        catch (e) {
          if (!(e && e.code === 'have')) throw e;
          // the move was added before and taken back (Undo): it comes back to taken, with the reason and the day it came back cleared
          try { const mvs = ss.getSheetByName('Moves'); if (mvs) ensureMovesCols_(mvs); moveStatus_(ss, moveKey, 'taken', { reason: '', 'comes back': '' }); } catch (e2) {}
          made = { ok: true, key: moveKey, owner: owner };
        }
      } else {
        const comes = choice === 'notnow' ? addDays_(dayOf_(new Date()), PS_NOW_DAYS_) : '';
        moveSetDo_(who, { moveKey: moveKey, status: 'dropped', reason: PS_WHYS_[choice], comes: comes, signal: signal, from: from, move: 'partner need', owner: owner, link: WORKSHOP_URL_ });
        made = { ok: true, key: moveKey, owner: owner, comes: comes };
      }
    } catch (e) { throw e && e.code ? e : { code: 'failed' }; }
    ps.sh.getRange(row.r, ps.C.ours + 1).setValue(reply);
    const now = new Date();
    let card = null;
    if (choice === 'add') { try { card = psMoveCard_(ss, cfg, moveKey); } catch (e) { card = null; } }
    const rec = { at: now.getTime(), kind: 'need', choice: choice, moveKey: moveKey, by: pressBy_(who), owner: owner, part: row.part, due: made && made.due || '', check: made && made.check || '', comes: made && made.comes || '' };
    psStamp_(item, rec);
    const done = partnerDoneEntry_(item, rec, Object.assign({}, row, { ours: reply }), { people: peopleSafe_() });
    psFeedDone_(done);
    relLog_(SpreadsheetApp.openById(RESEARCH_SHEET_ID_), 'partner', 'need ' + item + ' (' + row.part + '): ' + (choice === 'add' ? 'added' : 'set aside, ' + PS_WHYS_[choice]));
    return { ok: true, item: item, choice: choice, at: now.toISOString(), by: rec.by, card: card, done: done, reply: reply, moveKey: moveKey, owner: owner, due: made && made.due || '', check: made && made.check || '', comes: made && made.comes || '' };
  });
}
/** partner_undo — takes back an answer or a need's press within ten minutes (the cache holds the minute). */
function partnerUndo_(who, b) {
  psAdmin_(who);
  const item = String(b.item || '').trim(); if (!item) throw { code: 'bad_action' };
  const st = psStampGet_(item);
  if (!st) throw { code: 'late' };
  if (psReopens_(st) ? psCarried_(st.at) : Date.now() - st.at > PS_UNDO_MS_) throw { code: 'late' };
  return pressLock_('partner_undo', who, b, () => {
    const ps = psRead_(); if (!ps) throw { code: 'no_sheet' };
    const row = psFind_(ps, item);
    ps.sh.getRange(row.r, ps.C.ours + 1).setValue('');
    if (st.kind === 'need' && st.moveKey) {
      const ss = SpreadsheetApp.openById(FD.SHEET_ID);
      try { const mvs = ss.getSheetByName('Moves'); if (mvs) ensureMovesCols_(mvs); moveStatus_(ss, st.moveKey, 'dropped', { reason: 'Undone', 'comes back': dayOf_(new Date()) }); } catch (e) {}
      try { const a = ss.getSheetByName('Actions'), H = headerIndex_(a), d = a.getDataRange().getValues(); for (let i = 1; i < d.length; i++) if (String(d[i][H['key']] || '') === 'move:' + st.moveKey && d[i][H['status']] !== 'done') { a.getRange(i + 1, H['mark done by hand'] + 1).setValue(true); a.getRange(i + 1, H['status'] + 1).setValue('done'); a.getRange(i + 1, H['done at'] + 1).setValue(new Date()); } dropFromFeed_('move:' + st.moveKey); } catch (e) {}
    }
    try { CacheService.getScriptCache().remove('ps:' + item); } catch (e) {}
    psDoneDrop_(item);
    psFeedUndone_(st.kind === 'need' ? 'psig:' + item : 'pask:' + item, st.kind === 'need' && st.choice === 'add' ? st.moveKey : '');
    relLog_(SpreadsheetApp.openById(RESEARCH_SHEET_ID_), 'partner', 'undone ' + item);
    return { ok: true, item: item, kind: st.kind };
  });
}

/** workshop_send — Send on the weekday update card (key workshop:<yyyy-mm-dd>, rule WS1). Writes the lines kept into the row's "because" cell, one per line, the form the 7:15 AM run publishes from,
 *  and closes the card the way Done does (done by, Done this week, Undo for ten minutes, Reopen for the week). The lines left out never reach a partner. b: { actionKey, keep: [line numbers, 0-based] }.
 *  Build 32: the original lines are kept in the script property wsorig:<key> so Undo and Reopen (undo, build 30's core) bring every line back; the property is removed once they are restored,
 *  and any older than eight days is removed on each send, so the properties never fill up. */
function workshopSend_(who, b) {
  psAdmin_(who);
  const key = String(b.actionKey || '').trim();
  if (!WORKSHOP_KEY_.test(key)) throw { code: 'bad_action' };
  const keep = Array.isArray(b.keep) ? b.keep.map(Number).filter(n => isFinite(n)) : [];
  return pressLock_('workshop_send', who, b, () => {
    const ss = SpreadsheetApp.openById(FD.SHEET_ID);
    ensureBuild30_(ss);
    const sh = ss.getSheetByName('Actions'), H = headerIndex_(sh), data = sh.getDataRange().getValues();
    for (let i = 1; i < data.length; i++) {
      if (String(data[i][H['key']] || '').trim() !== key) continue;
      if (data[i][H['status']] === 'done') return { ok: true, already: true, key: key };
      const all = String(data[i][H['because']] || '').split(/\n/).map(l => l.trim()).filter(Boolean);
      const lines = keep.filter((n, j) => keep.indexOf(n) === j && n >= 0 && n < all.length).sort((x, y) => x - y).map(n => all[n].replace(/(\w)'(\w)/g, '$1’$2'));
      workshopKeepOrig_(key, all.join('\n'));
      sh.getRange(i + 1, H['because'] + 1).setValue(lines.join('\n'));
      const word = lines.length ? changedHow_(key) : CLOSED_DROPPED_; // build 33: the word is what the press did
      const went = lines.length ? 'The card’s row keeps the lines you left in and is marked done. At 7:15 AM the next weekday, What’s New shows them to every partner.' : 'The card’s row is marked done with no lines. Nothing reaches What’s New.';
      let closed;
      try { closed = actionClose_(who, key, { word: word, went: went, how: lines.length ? changedHow_(key) : CLOSED_DROPPED_ }); }
      catch (e) { sh.getRange(i + 1, H['because'] + 1).setValue(all.join('\n')); throw e; } // the row is not left half written
      relLog_(SpreadsheetApp.openById(RESEARCH_SHEET_ID_), 'workshop', key + ': ' + lines.length + ' of ' + all.length + ' lines kept for What’s New');
      return { ok: true, key: key, kept: lines.length, of: all.length, at: closed.at, by: closed.by, undoUntil: closed.undoUntil };
    }
    throw { code: 'none' };
  });
}
/** The original lines of a weekday update card, kept so Undo and Reopen can bring them back. Properties older than eight days are removed here. */
function workshopKeepOrig_(key, text) {
  try {
    const p = PropertiesService.getScriptProperties();
    p.setProperty('wsorig:' + key, text);
    const oldest = addDays_(dayOf_(new Date()), -8);
    p.getKeys().forEach(k => { const m = /^wsorig:workshop:(\d{4}-\d{2}-\d{2})$/.exec(k); if (m && m[1] < oldest) p.deleteProperty(k); });
  } catch (e) {}
}
function workshopOrig_(key) { try { return PropertiesService.getScriptProperties().getProperty('wsorig:' + key) || ''; } catch (e) { return ''; } }
function workshopOrigDrop_(key) { try { PropertiesService.getScriptProperties().deleteProperty('wsorig:' + key); } catch (e) {} }

/**
 * action_reopen — build 31's call, kept as a thin alias so a desk page still on build 31 works. It goes through undo, build 30's core: ten minutes or less after the press is Undo, after that
 * Reopen (until the end of the seventh day). Answers { ok, key, undone, card }; a press that is too old answers the code late, the word build 31's page knows.
 */
function actionReopen_(who, b) {
  const key = String(b.actionKey || '').trim();
  if (!/^[a-z]+:\S+$/.test(key) || key.length > 200) throw { code: 'bad_action' };
  let mode = 'reopen';
  try {
    const row = rows_(SpreadsheetApp.openById(FD.SHEET_ID).getSheetByName('Actions')).find(r => String(r['key'] || '').trim() === key);
    const at = row && row['done at'] ? toDate_(row['done at']) : null;
    if (at && new Date().getTime() - at.getTime() <= CARD_UNDO_MS_) mode = 'undo';
  } catch (e) {}
  let r;
  try { r = actionUndo_(who, { actionKey: key, mode: mode }); }
  catch (e) { if (e && (e.code === 'undo_expired' || e.code === 'reopen_expired')) throw { code: 'late' }; throw e; }
  return { ok: true, key: key, undone: mode === 'undo', already: !!(r && r.already), card: (r && r.card) || null, queued: !!(r && r.queued) };
}

// ───────────────────────────── build 32 · round 2 ─────────────────────────────
// What the desk keeps of a press on a partner's question or need, so Done this week still has it after a reload (psdone:<item> in the script properties, kept eight days),
// the card a partner's need makes (returned at once), and one owner name for a person (the first name the People tab holds).

const PS_KEEP_DAYS_ = 8;
function pressBy_(who) { return firstOf_(who && who.name) || firstOf_(String((who && who.email) || '').split('@')[0]); }
function psDoneSet_(item, rec) {
  try {
    const p = PropertiesService.getScriptProperties();
    p.setProperty('psdone:' + item, JSON.stringify(rec));
    const all = p.getProperties(), cut = Date.now() - PS_KEEP_DAYS_ * 864e5;
    Object.keys(all).forEach(k => {
      if (k.indexOf('psdone:') !== 0 || k === 'psdone:' + item) return;
      let r = null; try { r = JSON.parse(all[k]); } catch (e) { r = null; }
      if (!r || !(r.at > cut)) p.deleteProperty(k);
    });
  } catch (e) {}
}
function psDoneGet_(item) { try { const v = PropertiesService.getScriptProperties().getProperty('psdone:' + item); return v ? JSON.parse(v) : null; } catch (e) { return null; } }
function psDoneDrop_(item) { try { PropertiesService.getScriptProperties().deleteProperty('psdone:' + item); } catch (e) {} }
/** The weekday whose 7:15 AM run carries an answer given at ms: the same day when it was given before 7:15 AM on a weekday, else the next weekday. */
function psCarryDay_(ms) {
  const d = new Date(ms);
  let day = fmtC_(d, 'yyyy-MM-dd');
  if (fmtC_(d, 'HH:mm') >= '07:15') day = addDays_(day, 1);
  for (let i = 0; i < 3; i++) { const wd = new Date(day + 'T12:00:00Z').getUTCDay(); if (wd !== 0 && wd !== 6) break; day = addDays_(day, 1); }
  return day;
}
function psCarried_(ms) { return fmtC_(new Date(), 'yyyy-MM-dd HH:mm') >= psCarryDay_(ms) + ' 07:15'; }
const PS_TAIL_ = ' At 7:15 AM the next weekday the partner reads the line we wrote on their own Listening view, which only they see.';
/** The Done this week entry for one press on the Partner Signals tab (a question we answered, or a need we added or set aside). */
function partnerDoneEntry_(item, rec, row, ctx) {
  const at = new Date(rec.at), owner = ownerFirst_(rec.owner || '', (ctx && ctx.people) || []);
  const base = { owner: owner, for: '', because: '', link: '', firstSeen: at.toISOString(), rule: '', doneAt: at.toISOString(), by: rec.by || '', undoUntil: new Date(rec.at + PS_UNDO_MS_).toISOString() };
  if (rec.kind === 'answer') {
    const carried = psCarried_(rec.at), who = row.who || 'a partner';
    const went = carried ? 'Shown to them ' + fmtDay_(psCarryDay_(rec.at), 'EEEE') + ', 7:15 AM.' : 'Your answer is kept with their question on the Partner Signals tab. At 7:15 AM the next weekday it shows under their question on their own Listening view, which only they see.';
    return Object.assign(base, { key: 'pask:' + item, do: 'Answer ' + who + '’s question', title: 'Answer ' + who + '’s question', kind: 'A Partner Asked', word: 'Changed Partner Signals', went: went, text: row.ours, canReopen: !carried,
      pask: { item: item, who: row.who || '', words: row.words, part: row.part, date: row.date, day: psDay_(row.date) } });
  }
  const pr = psPartRow_(row.part) || {}, add = rec.choice === 'add';
  let went;
  if (add) went = 'The Moves has it, Open' + (rec.owner ? ', for ' + ownerFirst_(rec.owner, (ctx && ctx.people) || []) : '') + (rec.due ? ', due ' + fmtDay_(rec.due, 'EEEE, MMMM d') : '') + (rec.check ? ', checked ' + fmtDay_(rec.check, 'EEEE, MMMM d') : '') + '. Its card is in For Us to Do.' + PS_TAIL_;
  else if (psCarried_(rec.at)) went = 'Shown to them ' + fmtDay_(psCarryDay_(rec.at), 'EEEE') + ', 7:15 AM.';
  else went = 'The Moves keeps it with your reason.' + (rec.choice === 'notnow' && rec.comes ? ' It comes back ' + fmtDay_(rec.comes, 'EEEE, MMMM d') + '.' : '') + PS_TAIL_;
  return Object.assign(base, { key: 'psig:' + item, do: 'A partner’s need on ' + row.part, title: 'A partner’s need on ' + row.part, kind: 'A Partner’s Need', word: 'Changed The Moves', went: (add ? 'Added. ' : 'Set aside · ' + PS_WHYS_[rec.choice] + '. ') + went, text: row.ours, canReopen: !add && !psCarried_(rec.at),
    psig: { item: item, part: row.part, state: String(pr['state'] || ''), when: String(pr['when'] || ''), line: String(pr['line'] || ''), words: row.words, who: row.who || '', date: row.date, day: psDay_(row.date), choice: rec.choice, moveKey: rec.moveKey || '' } });
}
/** Every press on the Partner Signals tab from the last seven days that is still in force (the row still holds our answer), as Done this week entries. */
function partnerDoneWeek_(ctx) {
  const out = [];
  let recs = [];
  try { const all = PropertiesService.getScriptProperties().getProperties(); Object.keys(all).forEach(k => { if (k.indexOf('psdone:') === 0) { try { recs.push({ item: k.slice(7), rec: JSON.parse(all[k]) }); } catch (e) {} } }); } catch (e) { recs = []; }
  const since = ctx.now.getTime() - CARD_REOPEN_MS_;
  recs = recs.filter(x => x.rec && x.rec.at >= since);
  if (!recs.length) return out;
  const ps = psRead_(); if (!ps) return out;
  recs.forEach(x => { const row = ps.rows.find(r => r.item === x.item); if (row && row.ours) out.push(partnerDoneEntry_(x.item, x.rec, row, ctx)); });
  return out;
}
/** The stored feed takes a partner press into Done this week at once, and gives it back on Undo, as dropFromFeed_ does for a card (the next five-minute run writes the same). */
function psFeedDone_(entry) {
  try {
    const cell = feedCell_(SpreadsheetApp.openById(FD.SHEET_ID)), feed = JSON.parse(cell.getValue() || 'null');
    if (!feed) return;
    const had = (feed.doneWeek || []).some(d => d.key === entry.key);
    feed.doneWeek = [entry].concat((feed.doneWeek || []).filter(d => d.key !== entry.key)).slice(0, CARD_DONE_MAX_);
    if (!had) feed.doneThisWeek = (feed.doneThisWeek || 0) + 1;
    cell.setValue(JSON.stringify(feed));
  } catch (e) {}
}
function psFeedUndone_(key, moveKey) {
  try {
    const cell = feedCell_(SpreadsheetApp.openById(FD.SHEET_ID)), feed = JSON.parse(cell.getValue() || 'null');
    if (!feed) return;
    if ((feed.doneWeek || []).some(d => d.key === key)) { feed.doneWeek = feed.doneWeek.filter(d => d.key !== key); feed.doneThisWeek = Math.max(0, (feed.doneThisWeek || 0) - 1); }
    if (moveKey) {
      feed.actions = (feed.actions || []).filter(a => a.key !== 'move:' + moveKey);
      if (feed.moves) feed.moves.taken = (feed.moves.taken || []).filter(t => t.key !== moveKey);
    }
    cell.setValue(JSON.stringify(feed));
  } catch (e) {}
}
/** A partner's need that was added: its card in For Us to Do, made now, not at the next five-minute run. Writes the Actions row the run would write, reopens one that was closed by an Undo, and puts the card in the stored feed. Returns the presented card, or null. */
function psMoveCard_(ss, cfg, moveKey) {
  const mvSh = ss.getSheetByName('Moves');
  const m = mvSh ? rows_(mvSh).find(r => String(r['key'] || '') === moveKey) : null;
  if (!m) return null;
  const now = new Date(), todayDay = dayOf_(now);
  const due = m['due'] instanceof Date ? dayOf_(m['due']) : '', chk = m['check'] instanceof Date ? dayOf_(m['check']) : '';
  const w = moveWant_(m, due, chk, '', todayDay, 'https://docs.google.com/spreadsheets/d/' + FD.SHEET_ID + '/edit#gid=' + movesGid_(ss));
  ensureBuild30_(ss);
  const sh = ss.getSheetByName('Actions'), H = headerIndex_(sh), data = sh.getDataRange().getValues();
  let at = -1;
  for (let i = 1; i < data.length; i++) if (String(data[i][H['key']] || '').trim() === w.key) { at = i; break; }
  if (at < 0) {
    const row = actionsBlankRow_(sh);
    row[H['key']] = w.key; row[H['first seen']] = now; row[H['owner']] = w.owner; row[H['do this']] = w.do; row[H['for']] = w.for; row[H['because']] = w.because; row[H['link']] = w.link; row[H['status']] = 'open'; row[H['mark done by hand']] = false; row[H['rule']] = w.rule;
    sh.appendRow(row);
  } else if (String(data[at][H['status']]) === 'done') {
    sh.getRange(at + 1, H['status'] + 1).setValue('open'); sh.getRange(at + 1, H['done at'] + 1).setValue(''); sh.getRange(at + 1, H['mark done by hand'] + 1).setValue(false); sh.getRange(at + 1, H['first seen'] + 1).setValue(now);
    if (H['done by'] !== undefined) sh.getRange(at + 1, H['done by'] + 1).setValue('');
  }
  let feed = null;
  const cell = feedCell_(ss);
  try { feed = JSON.parse(cell.getValue() || 'null'); } catch (e) { feed = null; }
  const card = presentAction_({ key: w.key, owner: w.owner, do: w.do, for: w.for, because: w.because, link: w.link, firstSeen: now.toISOString(), rule: w.rule }, cardCtx_(ss, cfg, feed || {}));
  if (feed) {
    if (!(feed.actions || []).some(a => a.key === card.key)) feed.actions = [card].concat(feed.actions || []);
    if (feed.moves && !(feed.moves.taken || []).some(t => t.key === moveKey)) feed.moves.taken = (feed.moves.taken || []).concat([{ key: moveKey, signal: String(m['signal'] || ''), from: String(m['from'] || ''), move: String(m['move'] || ''), owner: String(m['owner'] || ''), due: due, check: chk, status: 'taken', written: null, by: '', note: '', link: String(m['link'] || '') }]);
    try { cell.setValue(JSON.stringify(feed)); } catch (e) {}
  }
  return card;
}
/** One owner, one name: the first name the People tab holds for the person, whether the card names him by email, by full name or by first name ("John Sherrod" is "John"). A name the tab does not hold stays as written. */
function ownerFirst_(owner, people) {
  const o = String(owner || '').trim();
  if (!o) return o;
  const low = o.toLowerCase(), L = people || [];
  let hit = L.find(p => p.email === low || String(p.name || '').toLowerCase() === low);
  if (!hit) { const same = L.filter(p => sameName_(p.name, o)); if (same.length === 1) hit = same[0]; }
  return hit && hit.name ? firstOf_(hit.name) : o;
}
function peopleSafe_() { try { return people_(); } catch (e) { return []; } }
/** The card the five-minute pass writes for a taken move (also made at once when our team adds a partner's need). */
function moveWant_(m, due, chk, comes, todayDay, movesUrl) {
  return { key: 'move:' + m['key'], owner: m['owner'] || 'John', do: 'Make the move: ' + m['move'], for: String(m['signal'] || ''),
    because: 'Taken ' + (m['written'] ? fmt_(m['written']) : '') + ' from ' + (m['from'] || 'the desk') + '; due ' + (due ? Utilities.formatDate(dayDate_(due), FD.TZ, 'MMM d') : '') + '. Press Made when it is made; the check comes ' + (chk ? Utilities.formatDate(dayDate_(chk), FD.TZ, 'MMM d') : 'later') + '.',
