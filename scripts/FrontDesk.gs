  return rows.filter(a => (a['status'] === 'done' || waitingDraft_(a)) && a['done at'] && toDate_(a['done at']).getTime() >= since && !undoneMove_(a, ctx) && closedHowOf_(a) !== CLOSED_WATCHED_ && closedHowOf_(a) !== CLOSED_FOLDED_)
    .sort((p, q) => toDate_(q['done at']) - toDate_(p['done at'])).slice(0, CARD_DONE_MAX_)
    .map(a => {
      const key = String(a['key']), at = toDate_(a['done at']), how = waitingDraft_(a) ? 'Waiting' : closedHowOf_(a);
      const card = doneOutcome_(presentAction_(rawAction_(a), ctx), ctx);
      const o = Object.assign({}, card, { doneAt: at.toISOString(), by: String(a['done by'] || ''), undoUntil: new Date(at.getTime() + CARD_UNDO_MS_).toISOString(),
        canReopen: a['mark done by hand'] === true && (!/^voice:/.test(key) || !!voiceUndoGet_(key)), how: how });
