/** The week's closed cards by how they closed, for the Friday scorecard line and the desk: { proven, saidDone, changed, dropped, lapsed }. Watched is not counted. */
function closedCounts_(rows, since) {
  const c = { proven: 0, saidDone: 0, changed: 0, dropped: 0, lapsed: 0 };
  rows.forEach(a => {
    if (a['status'] !== 'done' || !a['done at'] || toDate_(a['done at']) < since) return;
    const h = closedHowOf_(a);
    if (h === CLOSED_PROVEN_) c.proven++; else if (h === CLOSED_SAID_) c.saidDone++; else if (/^Changed /.test(h)) c.changed++; else if (h === CLOSED_DROPPED_) c.dropped++; else if (h === CLOSED_LAPSED_) c.lapsed++;
  });
