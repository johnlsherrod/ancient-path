function cardAct_(who, b) {
  const key = String(b.actionKey || ''), act = String(b.act || '');
  if (!/^[a-z]+:\S+$/.test(key) || key.length > 200 || !CARD_ACT_OK_[act]) throw { code: 'bad_action' };
