  if (seen !== null && seen !== undefined) return seen === '1';
  let ok = false;
  try { const r = UrlFetchApp.fetch(addr, { muteHttpExceptions: true, followRedirects: true }); ok = r.getResponseCode() === 200 && String(r.getContentText() || '').length > 500; } catch (e) { ok = false; }
  try { cache.put(ck, ok ? '1' : '0', PUB_PROOF_TTL_); } catch (e) {}
