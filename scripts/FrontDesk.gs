// ---- the floor: the page a page move is about ----
function movePagePath_(m) {
  let path = String(m['signal'] || '').split(' — ')[0].trim();
  if (path.charAt(0) !== '/') path = pathOf_(m['link']);
  return path;
}

// ---- an ask card closes as Proven when the ask is in sent mail to his address from our team ----
/**
 * Called by rebuildActions_ before the merge. For each open ask card the desk already had a row for (bwm, agr, askans, wl), Gmail is asked whether a message
 * to his address, from our team's own address, about the agreement (or the questions), was sent after the card was first seen. Gmail's day-only "after:" is
 * checked again against the message's own time. A card that is proven is taken out of `want` (so the merge closes it) and the answer is kept for fifteen minutes
 * (the cache), so five-minute runs do not ask Gmail again. A mail search that fails leaves the card open.
 */
function proveAsks_(want, existing, H) {
  const mine = FD.FOUNDERS.map(f => f[0]);
  const cache = CacheService.getScriptCache();
  for (let i = want.length - 1; i >= 0; i--) {
    const w = want[i], kind = (/^(bwm|agr|askans|wl|seat):/.exec(w.key) || [])[1]; // build 36: the seat email in sent mail closes the seat card as Proven
    if (!kind) continue;
    const ex = existing.get(w.key), em = keyEmail_(w.key);
    if (!ex || !em || !ex[H['first seen']]) continue;
    // a row already closed is read too: otherwise the merge would reopen it at the next run (the gap persists). A card brought back by Undo or Reopen needs a newer mail than the day it came back.
    let since = toDate_(ex[H['first seen']]);
    if (H['kept on'] !== undefined && ex[H['kept on']]) { const k = toDate_(ex[H['kept on']]); if (k > since) since = k; }
    const ck = 'fd:ask33:' + w.key + ':' + since.getTime();
    let hit = null;
    try { hit = cache.get(ck); } catch (e) { hit = null; }
    let proven;
    if (hit === '1' || hit === '0') proven = hit === '1';
    else {
      proven = askInSentMail_(em, kind, since, mine);
      try { cache.put(ck, proven ? '1' : '0', 900); } catch (e) {}
    }
    if (proven) want.splice(i, 1);
  }
}
function askInSentMail_(email, kind, since, mine) {
  const words = kind === 'seat' ? seatMailWords_() : kind === 'askans' ? '(answers OR questions)' : kind === 'wl' ? '(agreement OR link OR Jotform)' : '(agreement OR "before we meet" OR Jotform)';
  const day = Utilities.formatDate(since, FD.TZ, 'yyyy/MM/dd');
  const q = 'to:' + email + ' (' + mine.map(a => 'from:' + a).join(' OR ') + ') after:' + day + ' ' + words;
  const threads = GmailApp.search(q, 0, 5);
  for (let i = 0; i < threads.length; i++) {
    const msgs = threads[i].getMessages();
    for (let j = 0; j < msgs.length; j++) {
      const m = msgs[j];
      if (m.getDate().getTime() < since.getTime()) continue;
      const from = String(m.getFrom() || '').toLowerCase(), to = (String(m.getTo() || '') + ',' + String(m.getCc() || '') + ',' + String(m.getBcc() || '')).toLowerCase();
