  try {
    const m = GmailApp.getMessageById(id); if (!m) return null;
    const text = String(m.getPlainBody() || '').replace(/https?:\/\/\S+/g, '').replace(/[ \t]+/g, ' ').replace(/\n{3,}/g, '\n\n').trim().slice(0, 1500);
    let lines = null; try { lines = contactLines_(contactFields_(m.getBody() || '', m.getPlainBody() || '')); } catch (e) { lines = null; } // build 39: each form field on its own line
    const o = { from: String(m.getFrom() || ''), subject: String(m.getSubject() || ''), at: m.getDate().toISOString(), text: lines ? lines.join('\n').slice(0, 1500) : text };
    try { cache.put(ck, JSON.stringify(o), 21600); } catch (e) {}
    return o;
  } catch (e) { return null; }
}
/** Pure: where a reply goes. The man's own address from the Inbound row when the mail was sent for him (a form's no-reply address); else the mail's reply-to. */
function replyTarget_(replyTo, from, inboundEmail) {
  const pick = (s) => (/[A-Za-z0-9._%+-]+@[A-Za-z0-9-]+(?:\.[A-Za-z0-9-]+)+/.exec(String(s || '')) || [''])[0].toLowerCase();
  const rt = pick(replyTo), fr = pick(from), man = pick(inboundEmail);
