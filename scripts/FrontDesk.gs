/** The approved text out of the email John sent Jason: the lines between the first two "---" rules after its "Subject:" line. Google's link wrappers are taken off. Pure; null when the shape is not there. */
function seatEmailParse_(text) {
  const lines = String(text || '').split(/\r?\n/);
  const si = lines.findIndex(l => /^\s*Subject:\s*\S/.test(l));
  if (si < 0) return null;
  const subject = lines[si].replace(/^\s*Subject:\s*/, '').trim();
  let a = si + 1; while (a < lines.length && !/^\s*---\s*$/.test(lines[a])) a++;
  let b = a + 1; while (b < lines.length && !/^\s*---\s*$/.test(lines[b])) b++;
  if (a >= lines.length || b >= lines.length) return null;
  const unwrap = (s) => s.replace(/https:\/\/www\.google\.com\/url\?q=([^&\s]+)(?:&[^\s]*?sa=E)?/g, (m, u) => { try { return decodeURIComponent(u); } catch (e) { return u; } });
  const body = unwrap(lines.slice(a + 1, b).join('\n')).trim();
  return body ? { subject: subject, body: body } : null;
}
/** The approved seat email, read from john@ sent mail (cached an hour). Null when it is not there. */
function seatEmailApproved_() {
  const cache = CacheService.getScriptCache();
  try { const v = cache.get('fd:seatmail'); if (v) return JSON.parse(v); } catch (e) {}
  const th = GmailApp.search('in:sent subject:"' + SEAT_EMAIL_SUBJECT_ + '"', 0, 3);
  if (!th.length) return null;
  const msgs = th[0].getMessages();
  const t = seatEmailParse_(msgs[0].getPlainBody());
  if (t) { try { cache.put('fd:seatmail', JSON.stringify(t), 3600); } catch (e) {} }
  return t;
}
function longDayPlain_(iso, withWeekday) {
  const p = String(iso).split('-').map(Number), d = new Date(Date.UTC(p[0], p[1] - 1, p[2], 12));
  return (withWeekday ? WEEKDAYS_LONG_[d.getUTCDay()] + ', ' : '') + MONTHS_LONG_[p[1] - 1] + ' ' + p[2];
}
function numWord_(n, cap) { const w = NUM_WORDS_[n] || String(n); return cap ? w.charAt(0).toUpperCase() + w.slice(1) : w; }
/** The approved text with the room's dates, seat count and weeks filled from the record. Pure. Throws seat_email_stale when the text no longer has the places the record fills. */
function seatEmailFill_(tpl, nights, seats, first) {
  if (!nights || !nights.length) throw { code: 'no_room_dates' };
  let body = tpl.body, hits = 0;
  const sub = (re, fn) => { body = body.replace(re, function () { hits++; return fn.apply(null, arguments); }); };
  sub(/\b[A-Z][a-z]+ men, [a-z]+ Wednesdays/, () => numWord_(seats, true) + ' men, ' + numWord_(nights.length) + ' Wednesdays');
  sub(/Wednesday, [A-Z][a-z]+ \d{1,2}(?=, \d{1,2}:\d{2})/, () => longDayPlain_(nights[0], true));
  sub(/[A-Z][a-z]+ \d{1,2} through [A-Z][a-z]+ \d{1,2}/, () => longDayPlain_(nights[0]) + ' through ' + longDayPlain_(nights[nights.length - 1]));
  if (hits < 3) throw { code: 'seat_email_stale' };
  body = body.replace(/\b[a-z]+ Wednesdays now/, () => numWord_(nights.length) + ' Wednesdays now');
  body = body.replace(/^Hello,/, first ? first + ',' : 'Hello,');
  return { subject: tpl.subject, body: body };
}
