/** The card kinds that wait on a word to a man, so a word already sent is worth marking. */
const TOUCH_KINDS_ = /^(hand|contact|bwm|agr|askans|wl|seat|first|fu|call):/;
/**
 * The record marks a card (ruled Oct 15, 2026): for every open card that names a man, anything the record can already see since the card
 * opened — a note to him from john@, his reply into john@, a booking with him — becomes a line on the card ("john@ wrote to him Oct 15") with
 * Done one press away. Nothing new is asked of anyone. Mail is searched at most ten cards a run and the answer kept thirty minutes.
 */
function touchActions_(cfg, feed, coaching) {
  const props = PropertiesService.getScriptProperties();
  const me = String(Session.getEffectiveUser().getEmail() || '').toLowerCase();
  let searches = 0;
  (feed.actions || []).forEach(a => {
    if (!TOUCH_KINDS_.test(String(a.key || ''))) return;
    const em = keyEmail_(a.key); if (!em) return;
    const since = a.firstSeen ? new Date(a.firstSeen) : null; if (!since) return;
    const touches = [];
    (coaching || []).forEach(c => {
      if (String(c['email'] || '').toLowerCase() !== em || c['status'] === 'canceled' || !c['booked']) return;
      const at = toDate_(c['booked']); if (at > since) touches.push({ what: 'He booked ' + String(c['session'] || 'a session'), when: at.toISOString() });
    });
    const ck = 'touch:' + a.key;
    let cached = null; try { cached = JSON.parse(props.getProperty(ck) || 'null'); } catch (e) { cached = null; }
    const fresh = cached && cached.checked && (Date.now() - new Date(cached.checked)) < 30 * 60e3 && cached.since === a.firstSeen;
    if (cached && cached.hit && cached.since === a.firstSeen) touches.push(cached.hit);
    else if (!fresh && searches < 10) {
      searches++;
      let hit = null;
      try {
        const day = Utilities.formatDate(since, 'UTC', 'yyyy/MM/dd');
        const msgs = GmailApp.search('((to:' + em + ' in:sent) OR from:' + em + ') after:' + day, 0, 8);
        msgs.forEach(t => t.getMessages().forEach(m => {
          if (m.getDate() <= since) return;
          const from = String(m.getFrom() || '').toLowerCase();
          const mine = from.indexOf(me) >= 0 || /@ancientpathcoaching\.com/.test(from);
          const h = { what: mine ? 'john@ wrote to him' : 'He wrote to john@', when: m.getDate().toISOString() };
          if (!hit || h.when > hit.when) hit = h;
        }));
      } catch (e) { /* mail unreadable this run: the card stays as it is */ }
      try { props.setProperty(ck, JSON.stringify({ checked: new Date().toISOString(), since: a.firstSeen, hit: hit })); } catch (e) {}
      if (hit) touches.push(hit);
    }
    if (touches.length) { touches.sort((x, y) => y.when.localeCompare(x.when)); a.touched = touches[0]; }
  });
}

