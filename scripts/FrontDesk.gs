// ───────────────────────────── build 21 · the facilitator desk ─────────────────────────────

/** The Rooms tab: one row per room — the cohort today, a client as a room of one later. Seeded once with Breaking Free. */
const ROOMS_SEED_ = [["Breaking Free — Jeremiah's Journey", 'cohort', 'Wednesdays, 7:00 PM Central', '2026-10-07', 12, 'student-course', FD.FAC_FOLDER_ID, 'the first room']];
function ensureBuild21_(ss) {
  let rm = ss.getSheetByName('Rooms');
  if (!rm) {
    rm = ss.insertSheet('Rooms');
    rm.getRange(1, 1, 1, FD.TABS.Rooms.length).setValues([FD.TABS.Rooms]);
    rm.setFrozenRows(1);
