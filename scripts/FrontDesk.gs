function pressDrain_() {
  const p = PropertiesService.getScriptProperties();
  if (!p.getKeys().some(k => k.indexOf(PRESS_PREFIX_) === 0)) return;
  const lock = LockService.getScriptLock();
  if (!lock.tryLock(3000)) return;
  PRESS_HELD_ = true;
  try { pressFlush_(); } finally { PRESS_HELD_ = false; lock.releaseLock(); }
}
function pressKeep_(op, who, b, kept) {
  const body = JSON.parse(JSON.stringify(b || {}));
  delete body.key; // the desk key is never kept (the press is replayed as the person who pressed it); the build stays: page_check reads it
  const rec = JSON.stringify({ op: op, who: who || null, b: body, at: Date.now() });
  const id = PRESS_PREFIX_ + String(Date.now()).padStart(13, '0') + '-' + ('00' + (PRESS_SEQ_++ % 1000)).slice(-3) + '-' + Utilities.getUuid().slice(0, 8);
  const props = {};
  for (let i = 0, n = 0; i < rec.length; i += PRESS_CHUNK_, n++) props[id + ':' + ('00' + n).slice(-3)] = rec.slice(i, i + PRESS_CHUNK_);
  PropertiesService.getScriptProperties().setProperties(props, false);
  return Object.assign({ ok: true }, kept || {}, { queued: true });
}
/** Writes every kept press, oldest first, as the person who pressed it. Call only while holding the lock (PRESS_HELD_). A press that no longer applies (a card already handled, an Undo that ran out) is logged and dropped; it is never replayed twice. Returns how many were written. */
function pressFlush_() {
  const p = PropertiesService.getScriptProperties();
  const keys = p.getKeys().filter(k => k.indexOf(PRESS_PREFIX_) === 0).sort();
  if (!keys.length) return 0;
  const groups = [], at = {};
  keys.forEach(k => { const id = k.slice(0, k.lastIndexOf(':')); if (!(id in at)) { at[id] = groups.length; groups.push({ id: id, keys: [] }); } groups[at[id]].keys.push(k); });
  let written = 0;
  groups.forEach(g => {
    let rec = null;
    try { rec = JSON.parse(g.keys.map(k => p.getProperty(k) || '').join('')); } catch (e) { rec = null; }
    try {
      if (rec && PRESS_OPS_[rec.op] && (Date.now() - Number(rec.at || 0)) < PRESS_KEEP_MS_) { PRESS_OPS_[rec.op](rec.who, rec.b); written++; }
    } catch (e) {
      try { relLog_(SpreadsheetApp.openById(RESEARCH_SHEET_ID_), 'press kept', (rec && rec.op) + ' not written: ' + ((e && e.code) || e)); } catch (x) {}
    }
    g.keys.forEach(k => { try { p.deleteProperty(k); } catch (e) {} });
  });
  return written;
}

// ---- the contact form (LearnWorlds "New Contact Form") ----
/**
 * The form's fields by label, read from the email's HTML where each label is its own <b>label:</b> and the value follows, so a value that runs straight into the next
 * label ("...@gmail.commessage:...") still splits. The plain text is the fallback: the five labels the form has are found wherever they stand, with or without a space before them.
 */
function contactFields_(html, plain) {
  const out = {};
  const h = String(html || '');
  const re = /<b>\s*([A-Za-z][A-Za-z _-]{0,30}?)\s*:\s*<\/b>([\s\S]*?)(?=<b>\s*[A-Za-z][A-Za-z _-]{0,30}?\s*:\s*<\/b>|<img\b|$)/gi;
  let m;
  while ((m = re.exec(h))) {
    const k = m[1].toLowerCase().replace(/[^a-z]/g, '');
    const v = decodeEntities_(m[2].replace(/<br\s*\/?>/gi, ' ').replace(/<[^>]+>/g, ' ')).replace(/\s+/g, ' ').trim();
    if (k && !(k in out)) out[k] = v;
  }
  if (out.email || out.message || out.firstname) return out;
  const t = String(plain || '');
  const labels = ['firstname', 'lastname', 'email', 'message', 'phone'];
  const hits = [];
  const lre = /(firstname|lastname|email|message|phone):/gi;
  let l;
  while ((l = lre.exec(t))) hits.push({ k: l[1].toLowerCase(), at: l.index, end: l.index + l[0].length });
  hits.forEach((x, i) => { if (!(x.k in out)) out[x.k] = t.slice(x.end, i + 1 < hits.length ? hits[i + 1].at : t.length).replace(/\s+/g, ' ').trim(); });
  return out;
}
const SPAM_KIND_ = 'Contact form (looks like spam)';

// ---- the wait-list form (LearnWorlds "New Marketing Form Submission") ----
/** "User <name> submitted the form "<title>" via <page>" · "An anonymous user submitted ..." → { who, form, page }, or null. */
function marketingParts_(text) {
  const t = String(text || '').replace(/&quot;/g, '"').replace(/[“”]/g, '"').replace(/\s+/g, ' ');
  const m = t.match(/(?:User\s+(.+?)|(An anonymous user))\s+submitted the form\s+"([^"]+)"(?:\s+via\s+(\S+))?/i);
  if (!m) return null;
  return { who: m[2] ? '' : String(m[1] || '').trim(), form: m[3].trim(), page: String(m[4] || '').replace(/[.,]+$/, '') };
}
/** The one email a name stands for on the record (Roster, the Names tab, Account made notices), or '' when there is none or more than one. */
function emailByName_(ss, name) {
  const want = String(name || '').toLowerCase().replace(/\s+/g, ' ').trim();
  if (!want) return '';
  const found = new Set();
  const take = (nm, em) => { if (String(nm || '').toLowerCase().replace(/\s+/g, ' ').trim() === want && /@/.test(String(em || ''))) found.add(String(em).toLowerCase().trim()); };
  try { rows_(ss.getSheetByName('Roster')).forEach(r => take(r['name'], r['email'])); } catch (e) {}
  try { const hand = names_(ss); Object.keys(hand).forEach(em => take(hand[em], em)); } catch (e) {}
  try { rows_(ss.getSheetByName('Inbound')).forEach(r => { if (r['kind'] === 'Account made') take(r['name'], r['email']); }); } catch (e) {}
  return found.size === 1 ? Array.from(found)[0] : '';
}

// ---- one row per submission (Inbound) ----
const SUBMISSION_WINDOW_MS_ = 10 * 60e3;
const SUBMISSION_KINDS_ = /^(Contact form|Agreement signed|Wait list|After We Talk|Form: |Bug report|Testimony offered)/;
/** The same form sent again within ten minutes with the same address, name and words is one submission, whatever the number of emails it made (a bot sends three; Jotform sends two). */
function sameSubmission_(a, b) {
  if (!SUBMISSION_KINDS_.test(String(a.kind)) || String(a.kind) !== String(b.kind) || String(a.source) !== String(b.source)) return false;
  const norm = (s) => String(s || '').toLowerCase().replace(/\s+/g, ' ').trim();
  if (norm(a.email) !== norm(b.email) || norm(a.name) !== norm(b.name) || norm(a.summary).slice(0, 300) !== norm(b.summary).slice(0, 300)) return false;
  return Math.abs(toDate_(a.received).getTime() - toDate_(b.received).getTime()) <= SUBMISSION_WINDOW_MS_;
}
/** Spam contact forms for the desk: one entry per Central day, counting submissions, not emails. [{ day, n, received, link }], newest day first. */
function spamDays_(rows, since) {
  const spam = rows.filter(r => r['kind'] === SPAM_KIND_ && toDate_(r['received']) >= since).sort((a, b) => toDate_(a['received']) - toDate_(b['received']));
  const subs = [];
  spam.forEach(r => {
    const cur = { kind: SPAM_KIND_, source: r['source'], email: r['email'], name: r['name'], summary: r['summary'], received: r['received'], link: r['open in Gmail'] };
    const prev = subs[subs.length - 1];
    if (prev && sameSubmission_(prev, cur)) { prev.received = cur.received; prev.link = cur.link; return; }
    subs.push(cur);
  });
  const byDay = {}, order = [];
  subs.forEach(s => { const d = Utilities.formatDate(toDate_(s.received), FD.TZ, 'yyyy-MM-dd'); if (!byDay[d]) { byDay[d] = []; order.push(d); } byDay[d].push(s); });
  return order.sort().reverse().map(d => { const l = byDay[d], last = l[l.length - 1]; return { day: d, n: l.length, received: toDate_(last.received).toISOString(), link: last.link }; });
}

// ---- helpers for the Inbound write (build 32.2) ----
const OUR_ACCOUNTS_ = ['ancientpath']; // our own LearnWorlds account: its test submissions stay on Inbound, marked ours
let BF322_PENDING_ = false; // the one-time read of the wait-list notices the desk never searched (a different LearnWorlds sender)
function markBackfill_() { if (BF322_PENDING_) { PropertiesService.getScriptProperties().setProperty('bf322', new Date().toISOString()); BF322_PENDING_ = false; } }
/** Message ids this script saw and did not write because the same submission was already on Inbound. Kept so the next run does not read them again. */
function dupIds_() { try { return JSON.parse(PropertiesService.getScriptProperties().getProperty('inboundDupIds') || '[]'); } catch (e) { return []; } }
function dupIdsAdd_(ids) { PropertiesService.getScriptProperties().setProperty('inboundDupIds', JSON.stringify(dupIds_().concat(ids).slice(-350))); }
/** The last n rows of Inbound as { kind, source, email, name, summary, received }, to compare a new message with what was just written. */
function recentInbound_(sh, n) {
  const last = sh.getLastRow();
  if (last < 2) return [];
  const H = headerIndex_(sh), from = Math.max(2, last - n + 1);
  const vals = sh.getRange(from, 1, last - from + 1, sh.getLastColumn()).getValues();
  const g = (r, k) => (H[k] === undefined ? '' : r[H[k]]);
  return vals.map(r => ({ kind: g(r, 'kind'), source: g(r, 'source'), email: g(r, 'email'), name: g(r, 'name'), summary: g(r, 'summary'), received: g(r, 'received') }));
}

/** The Research Engine's Answers tab (made with its eight headers when it is not there, as the Research reader does). */
function reAnswers_(rs) {
  let sh = rs.getSheetByName('Answers');
  if (!sh) { sh = rs.insertSheet('Answers'); sh.getRange(1, 1, 1, 8).setValues([['when', 'who', 'entry id', 'action', 'text', 'more', 'room', 'build']]); sh.setFrozenRows(1); }
  return sh;
}
/** One Answers row the way the Research reader's growthAnswer_ writes it: when, who (email), entry id, action, text, more, room, build. */
function reAnswerRow_(rs, who, id, action, text, more, room) {
  reAnswers_(rs).appendRow([relStamp_(new Date()), String(who.email || '').toLowerCase().trim(), id, action, text, more, room, FD.BUILD]);
}
/** The room a caller writes for: a facilitator, his own; an admin, the one named (a Rooms row) or his own. */
function roomFor_(ss, who, named) {
  const want = String(named || '').trim();
  if (who.role !== 'admin') {
    if (!who.room) throw { code: 'no_room' };
    if (want && !sameRoom_(want, who.room)) throw { code: 'not_yours' };
    return who.room;
  }
  if (!want) { if (!who.room) throw { code: 'no_room' }; return who.room; }
  const hit = rooms_(ss).find(r => sameRoom_(r.room, want));
  if (!hit) throw { code: 'no_room' };
  return hit.room;
}
/** The piece the room was served for a week: an id the caller names, else the newest released entry whose "week served" is that week (a bare number or Course:number pairs, the course matching the room first). */
function afterEntry_(entries, week, room, id) {
  if (id) { const e = entries.find(x => x.id === id); if (!e) throw { code: 'no_entry' }; return e; }
  const initials = String(room).toLowerCase().split(/\s+[—–-]\s+/)[0].split(/\s+/).map(w => w[0] || '').join(''), flat = String(room).toLowerCase().replace(/[^a-z0-9]/g, '');
  const scored = [];
  entries.forEach(e => {
    if (e.status !== 'released' && !e.brought) return; // build 36
    const t = String(e.week || '').toLowerCase().trim();
    let hit = false, score = 0;
    if (/^\d+$/.test(t)) hit = Number(t) === week;
    else t.split(/\s*[·,;|]\s*/).forEach(p => {
      const m = p.match(/^([a-z][\w\s]*?)\s*[:=]\s*(\d+|any)$/i);
      if (!m || m[2] === 'any' || Number(m[2]) !== week) return;
      hit = true;
      const k = m[1].replace(/[^a-z0-9]/g, '');
      if (k && (k === initials || flat.indexOf(k) >= 0)) score = 1;
    });
    if (hit) { let w = ''; try { w = e.written ? dayOf_(e.written) : ''; } catch (x) { w = ''; } scored.push({ e: e, s: score, w: w }); }
  });
  if (!scored.length) throw { code: 'no_entry' };
  scored.sort((a, b) => (b.s - a.s) || b.w.localeCompare(a.w) || (b.e.row - a.e.row));
  return scored[0].e;
}
/**
 * after_set {room, week, answer, line}: what the room did with the piece, after it met. Facilitator or admin.
 * Writes one Answers row as growthAnswer_ writes kind 'after' (entry id, 'after', the line as text, the answer key opened/quiet/none as more, room),
 * and the room's Signals row on the Room Signals sheet the same way (no names). Logs the press.
 */
function afterSet_(who, b) {
  const ans = AFTER_ANSWERS_[String(b.answer || '').toLowerCase().trim()];
  if (!ans) throw { code: 'bad_answer' };
  const week = Number(b.week);
  if (!week || week < 1 || week > 99 || week !== Math.floor(week)) throw { code: 'bad_action' };
  const line = String(b.line == null ? '' : b.line).replace(/\s+$/, '').slice(0, 1500);
  const id = String(b.id || '').trim().slice(0, 40);
  return pressLock_('after_set', who, b, () => {
    const ss = SpreadsheetApp.openById(FD.SHEET_ID), rs = SpreadsheetApp.openById(RESEARCH_SHEET_ID_);
    const room = roomFor_(ss, who, b.room);
    const en = rs.getSheetByName('Entries');
    if (!en) throw { code: 'no_entries' };
    const e = afterEntry_(relLoad_(en).entries, week, room, id);
    reAnswerRow_(rs, who, e.id, 'after', line, ans, room);
    let signal = true;
    try {
      const sid = String(readConfig_().signalsSheetId || FD.SIGNALS_SHEET_ID || '');
      if (sid) {
        const ssh = SpreadsheetApp.openById(sid).getSheetByName('Signals'), H = headerIndex_(ssh);
        let night = ''; try { night = weekNight_(ss, room, week); } catch (x) { night = ''; }
        const sr = [];
        sr[H['cohort']] = room; sr[H['week']] = week; sr[H['session']] = night ? fmtDay_(night, 'MMM d, yyyy') : relStamp_(new Date()); sr[H['section opened']] = '';
        sr[H['signal (the room\'s words, no names)']] = line; sr[H['construct']] = e.construct && !/none in the registry/i.test(e.construct) ? e.construct : ''; sr[H['kind']] = 'facilitator, after the room';
        sr[H['speaks to it (our shelf)']] = e.move; sr[H['what the facilitator did with it']] = AFTER_DID_[ans]; sr[H['course move it suggests']] = ''; sr[H['source page']] = 'Your Desk'; sr[H['coded']] = '';
        for (let c = 0; c < ssh.getLastColumn(); c++) if (sr[c] === undefined) sr[c] = '';
        ssh.appendRow(sr);
      }
    } catch (x) { signal = false; relLog_(rs, 'after', 'signals row not written · ' + room + ' · week ' + week); }
    relLog_(rs, 'after', room + ' · week ' + week + ' · ' + ans + ' · ' + e.id);
    return { ok: true, id: e.id, answer: ans, signal: signal };
  });
}
/** The first admin's name, the owner of a card for our team. */
function teamOwner_() { const a = people_().filter(p => p.role === 'admin')[0]; return a ? (a.name || a.email) : 'John Sherrod'; }
/**
