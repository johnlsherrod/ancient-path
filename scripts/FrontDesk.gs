/** "james choiniere" — a whole name, letters only, for matching a notice's display name to a man. */
function wholeName_(s) { return String(s || '').toLowerCase().replace(/[^a-z\s]/g, ' ').replace(/\s+/g, ' ').trim(); }

/**
 * The pieces the men have written on the site, as activity only: which form, by whom, when. Never the words — the notice carries none.
 * Source: the "New Course Form Submission" notices (Inbound kind "Story piece saved"). A notice names the man by his display name, so he is
 * matched to a roster or room man by his whole name, or by first name when only one man has it.
 * Returns { byMan: { email: [{ piece, at (first save), last, saves }] }, unmatched: [{ name, piece, at }] }.
 */
function piecesFeed_(ss, cfg, feed, inbound) {
  const men = [];
  const add = (name, email) => { const e = String(email || '').toLowerCase().trim(); if (!e || !name) return; if (!men.some(m => m.email === e)) men.push({ email: e, whole: wholeName_(name), first: wholeName_(name).split(' ')[0] }); };
  (feed.roster || []).forEach(r => add(r.name, r.email));
  ((feed.room && feed.room.men) || []).forEach(r => add(r.name, r.email));
  const hand = names_(ss); Object.keys(hand).forEach(e => add(hand[e], e));
  const byMan = {}, unmatched = [];
  (inbound || []).filter(r => r['kind'] === 'Story piece saved' && r['received']).forEach(r => {
    const who = String(r['name'] || '').trim();
    const sm = /^(.*?)\s*\(([^)]*)\)\s*$/.exec(String(r['summary'] || ''));
    const piece = (sm ? sm[1] : String(r['summary'] || '')).trim();
    if (!piece || !who || isOurs_(cfg, '', who) || /^ancientpath$/i.test(who)) return;
    const w = wholeName_(who);
    let man = men.find(m => m.whole === w) || null;
    if (!man) { // build 24.2: "Will Thomson" is "William Thomson" — same last name, one first name the start of the other (three letters or more)
      const first = w.split(' ')[0], last = w.split(' ').slice(-1)[0];
      const f = men.filter(m => m.whole.split(' ').slice(-1)[0] === last && m.whole.indexOf(' ') > 0 && first.length >= 3 && m.first.length >= 3 && (m.first.indexOf(first) === 0 || first.indexOf(m.first) === 0));
      if (f.length === 1) man = f[0];
    }
    if (!man) { const f = men.filter(m => m.first === w.split(' ')[0]); if (f.length === 1) man = f[0]; }
    const at = toDate_(r['received']).toISOString();
    if (!man) { unmatched.push({ name: who, piece: piece, at: at }); return; }
    const list = byMan[man.email] = byMan[man.email] || [];
    const have = list.find(x => x.piece.toLowerCase() === piece.toLowerCase());
    if (have) { have.saves++; if (at < have.at) have.at = at; if (at > have.last) have.last = at; }
    else list.push({ piece: piece, at: at, last: at, saves: 1 });
  });
  Object.keys(byMan).forEach(e => byMan[e].sort((a, b) => a.at.localeCompare(b.at)));
  return { byMan: byMan, unmatched: unmatched.slice(-20) };
}
/** Does a form name ("Lament") belong to a piece the weeks name ("Write a Lament")? Key words, not exact titles. */
function samePiece_(form, piece) {
  const k = (s) => wholeName_(s).replace(/^(write a|set a|a|the)\s+/, '').trim();
  const a = k(form), b = k(piece);
  if (!a || !b) return false;
  if (a === b || a.indexOf(b) >= 0 || b.indexOf(a) >= 0) return true;
  const stone = /stone/, from = /where i\s?a?m from/;
  return (stone.test(a) && stone.test(b)) || (from.test(a) && from.test(b));
}
/** build 24: the pieces this room's weeks have opened so far (through this week's room), each with how many men have written it. */
function roomPieces_(wk, cur, men, piecesTab) {
  const today = dayOf_(new Date());
  const upTo = (wk || []).filter(w => dayOf_(nightOf_(w)) <= today || (cur && Number(w['week']) === Number(cur['week'])));
  const out = [];
  upTo.forEach(w => {
    const names = String(w['piece introduced'] || '').split(/\s*,\s*then\s+|\s*,\s*|\s+then\s+|\s+and\s+/).map(s => s.trim()).filter(Boolean);
    const addrs = String(w['piece address'] || '').split(/\s*\n\s*/).map(s => s.trim()).filter(s => /^https?:\/\//.test(s));
    names.forEach((n, i) => {
      if (out.some(p => p.name.toLowerCase() === n.toLowerCase())) return;
      const tab = (piecesTab || []).find(x => String(x['name'] || '').toLowerCase() === n.toLowerCase());
      const url = addrs[i] || addrs[0] || (tab ? String(tab['address'] || '') : '');
      const who = men.filter(m => (m.written || []).some(x => samePiece_(x.piece, n)));
      out.push({ name: n, week: Number(w['week']), count: who.length, of: men.length, url: url, men: who.map(m => m.name || m.email) });
    });
  });
  return out;
}
/** The one line the reminder adds when a piece is introduced: his words are his; the facilitator sees that he wrote, never what. */
function piecesLine_(cfg, week) {
  if (!cfg.piecesLine || !pieceLines_(week).length) return [];
  return ['What you write there is yours. Your facilitator and our team can see that you wrote it, never what you wrote.', ''];
