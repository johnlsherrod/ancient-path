// ---- x: what the new desk reads beyond the feed ----
/**
 * The desk answer's x (build 29). One part at a time: a part that cannot be read drops only its own key, and deskX_ never throws.
 * A facilitator's x holds his room, its weeks, the story pieces and his own moves; no address of any spreadsheet is in it.
 */
function deskX_(who, ss) {
  const x = { build: FD.BUILD, today: '', nowIso: '', releaser: false };
  try {
    const now = new Date();
    x.today = dayOf_(now); x.nowIso = now.toISOString();
    x.releaser = !!(who && who.role === 'admin');
  } catch (e) {}
  const admin = !!(who && who.role === 'admin');
  let weeksMemo = null;
  const weeksOf = () => {
    if (weeksMemo) { if (weeksMemo.err) throw weeksMemo.err; return weeksMemo; }
    try {
      const wkSh = ss.getSheetByName('Weeks'), pcSh = ss.getSheetByName('Pieces');
      weeksMemo = { weeks: wkSh ? rows_(wkSh).filter(w => nightOf_(w)) : [], pieces: pcSh ? rows_(pcSh) : [] };
    } catch (e) { weeksMemo = { err: e }; throw e; }
    return weeksMemo;
  };
  const part = (key, fn) => { try { const v = fn(); if (v !== undefined) x[key] = v; } catch (e) {} };
  const splitNames = (s) => String(s || '').split(/\s*,\s*then\s+|\s*,\s*|\s+then\s+|\s+and\s+/).map(n => n.trim()).filter(Boolean);
  const links = (s) => String(s || '').split(/\s*\n\s*/).map(l => l.trim()).filter(l => /^https?:\/\//.test(l));
  const titleOf = (opens) => { const m = /Week\s*\d+\s*[—–-]\s*([\s\S]+)$/i.exec(opens); return m ? m[1].trim() : opens; };
  const roomWeeks = (allRooms, ri) => {
    const rm = allRooms[ri];
    return weeksOf().weeks.filter(w => (String(w['room'] || '').trim() ? sameRoom_(w['room'], rm.room) : ri === 0)).sort((a, b) => nightOf_(a) - nightOf_(b));
  };
  const mineRoom = (rm) => admin || (!!who.room && sameRoom_(rm.room, who.room));
  if (admin) part('partners', () => partnersX_()); // build 31: the Workshop, for our team only

  part('rooms', () => {
    const cfg = readConfig_(), all = rooms_(ss), people = people_(), out = [];
    all.forEach((rm, ri) => {
      if (!mineRoom(rm)) return;
      const men = roomMen_(ss, cfg, rm.room).length;
      const lead = people.filter(p => p.room && sameRoom_(p.room, rm.room))[0];
      const named = weeksOf().pieces.find(p => String(p['address'] || '').replace(/\/+$/, '').split('?')[0].toLowerCase().endsWith('/course/' + String(rm.course || '').toLowerCase()));
      out.push({ key: slug_(rm.room), name: rm.room, course: named ? String(named['name']) : String(rm.room).split(/\s+[—–-]\s+/)[0], courseSlug: rm.course, meets: rm.meets,
        leader: lead ? lead.name : '', firstNight: rm.firstNight, size: sameRoom_(rm.room, cfg.cohortName) ? cfg.roomSize : men, seated: men,
        weeks: roomWeeks(all, ri).map(w => {
          const opens = String(w['what opens'] || '').trim(), names = splitNames(w['piece introduced']), holds = roadHolds_(w['he can open it from']);
          const from = names.length ? (names.map(n => holds.by[roadNorm_(n)] || '').filter(Boolean)[0] || holds.all || '') : '';
          return { week: Number(w['week']), night: dayOf_(nightOf_(w)), title: titleOf(opens), opens: opens, piece: String(w['piece introduced'] || '').trim(),
            pieceAddress: String(w['piece address'] || '').trim(), pieceOpensFrom: from, ask: String(w["facilitator's one ask"] || '').trim(), fits: String(w['how it fits'] || '').trim() };
        }) });
    });
    return out;
  });

  part('storyPieces', () => {
    const all = rooms_(ss), out = [], seen = {};
    all.forEach((rm, ri) => {
      if (!mineRoom(rm)) return;
      roomWeeks(all, ri).forEach(w => {
        const names = splitNames(w['piece introduced']), addrs = links(w['piece address']), holds = roadHolds_(w['he can open it from']);
        names.forEach((n, i) => {
          const k = roadNorm_(n) + '|' + Number(w['week']);
          if (seen[k]) return; seen[k] = true;
          const pc = weeksOf().pieces.find(p => roadNorm_(p['name']) === roadNorm_(n));
          const address = addrs.length === names.length ? addrs[i] : (names.length === 1 && addrs.length ? addrs[0] : (pc ? String(pc['address'] || '').trim() : ''));
          out.push({ name: n, address: address || (pc ? String(pc['address'] || '').trim() : ''), week: Number(w['week']), opensFrom: holds.by[roadNorm_(n)] || holds.all || '' });
        });
      });
    });
    return out;
  });

  part('moves', () => {
    const sh = ss.getSheetByName('Moves');
    const rows = sh ? rows_(sh).filter(r => r['key']) : [];
    return rows.filter(r => admin || sameName_(who.name, r['owner'])).map(r => {
      const key = String(r['key']), link = String(r['link'] || '');
      return { key: key, kind: key.split(':')[0], signal: String(r['signal'] || ''), from: String(r['from'] || ''), move: String(r['move'] || ''), owner: String(r['owner'] || ''),
        due: dayCell_(r['due']), check: dayCell_(r['check']), status: String(r['status'] || ''), before: String(r['before'] || ''), now: '', answer: String(r['answer'] || ''),
