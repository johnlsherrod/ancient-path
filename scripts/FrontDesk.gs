function voiceDo_(who, key, kind, id, choice) {
  const rs = SpreadsheetApp.openById(RESEARCH_SHEET_ID_), sh = rs.getSheetByName('Sources');
  if (!sh || sh.getLastRow() < 2) throw { code: 'no_sources' };
