// ---- Review the concerns (concerns:<month>): one line per suggestion ----
/** Pure: the suggestions in a concerns row's because text: Retire "X" · Open "X" · Rename "X" to "Y", each with its reason. */
function concernLines_(because) {
  const s = String(because || ''), out = [];
  const re = /(Retire|Open|Rename)\s+[“"]([^”"]+)[”"](?:\s+to\s+[“"]([^”"]+)[”"])?\s*:\s*([\s\S]*?)(?=\s+(?:Retire|Open|Rename)\s+[“"][^”"]+[”"]|\s+Each line is a tick|$)/g;
  let m;
  while ((m = re.exec(s))) out.push({ i: out.length, verb: m[1], concern: m[2].trim(), to: (m[3] || '').trim(), why: m[4].trim() });
  return out;
}
function normC_(s) { return String(s || '').toLowerCase().replace(/[’‘]/g, "'").replace(/\s+/g, ' ').trim(); }
function concernState_(key) { try { return JSON.parse(PropertiesService.getScriptProperties().getProperty(CONCERN_PROP_ + key) || '{}'); } catch (e) { return {}; } }
function concernStateSet_(key, st) { const p = PropertiesService.getScriptProperties(); if (st && Object.keys(st).length) p.setProperty(CONCERN_PROP_ + key, JSON.stringify(st)); else p.deleteProperty(CONCERN_PROP_ + key); }
/** The lines of the concerns card as the page draws them: each with what has been ruled and, inside ten minutes, whether Undo is still there. */
function concernCardLines_(key, because) {
  const st = concernState_(key), now = Date.now();
  return concernLines_(because).map(l => {
    const s = st[l.i];
    return Object.assign({}, l, { state: s ? s.a : '', undo: !!(s && now - s.at <= CARD_UNDO_MS_) });
  });
}
/** Writes one line onto the Concerns tab of the Guide sheet. Returns what was there, so Undo can put it back. */
function concernWrite_(line) {
  const sh = SpreadsheetApp.openById(GUIDE_SHEET_ID_).getSheetByName('Concerns');
  if (!sh) throw { code: 'no_concerns_sheet' };
  const H = headerIndex_(sh), d = sh.getDataRange().getValues();
  if (H['concern'] === undefined || H['open'] === undefined) throw { code: 'no_concerns_sheet' };
  let r = -1;
  for (let i = 1; i < d.length; i++) if (normC_(d[i][H['concern']]) === normC_(line.concern)) { r = i; break; }
  if (r < 0) {
    if (line.verb !== 'Open') throw { code: 'no_such_concern' };
    const row = new Array(sh.getLastColumn()).fill('');
    row[H['concern']] = line.concern; row[H['order']] = d.length; row[H['open']] = true;
    if (H['asking'] !== undefined) row[H['asking']] = false;
    sh.appendRow(row);
    return { col: 'open', row: sh.getLastRow(), was: false };
  }
  const col = line.verb === 'Rename' ? 'rename to' : 'open';
  if (H[col] === undefined) throw { code: 'no_concerns_sheet' };
  const cell = sh.getRange(r + 1, H[col] + 1), was = cell.getValue();
  cell.setValue(line.verb === 'Open' ? true : line.verb === 'Retire' ? false : line.to);
  return { col: col, row: r + 1, was: was };
}
function concernUndo_(rec) {
  const sh = SpreadsheetApp.openById(GUIDE_SHEET_ID_).getSheetByName('Concerns'); if (!sh) throw { code: 'no_concerns_sheet' };
  const H = headerIndex_(sh);
  sh.getRange(rec.row, H[rec.col] + 1).setValue(rec.was);
}
function concernPress_(who, key, row, act, idx) {
