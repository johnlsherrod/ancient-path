}
/** The Search profile's Pages tab by page address and month, the searches Google showed a page for and nobody clicked, and the title the Profile tab holds for a page. */
function searchReads_(cfg) {
  const sp = SpreadsheetApp.openById(cfg.searchSheetId || FD.SEARCH_SHEET_ID);
  const table = (name) => { const t = sp.getSheetByName(name); if (!t || t.getLastRow() < 2) return []; const d = t.getDataRange().getDisplayValues(), H = d[0]; return d.slice(1).filter(r => r.some(v => v !== '')).map(r => { const o = {}; H.forEach((h, i) => { o[h] = r[i]; }); return o; }); };
  const out = { pages: {}, queries: {}, titles: {} };
  const pages = table('Pages');
  pages.forEach(r => {
    const mk = monthKey_(r['month']); if (!mk) return;
    const p = pathOf_(r['page']);
    (out.pages[p] = out.pages[p] || []).push({ month: mk, imp: numOr_(r['impressions']) || 0, clk: numOr_(r['clicks']) || 0, pos: numOr_(r['position']), asOf: dayCell_(r['numbers as of']) });
  });
  const cur = Array.from(new Set(pages.map(r => monthKey_(r['month'])).filter(Boolean))).sort().pop() || '';
  const qs = {};
  table('Queries seen').forEach(r => {
    if (monthKey_(r['month']) !== cur || (numOr_(r['clicks']) || 0) !== 0 || /ancient path/i.test(String(r['search'] || ''))) return;
    const p = pathOf_(r['page it showed']), phrase = String(r['search'] || '').trim();
    if (phrase) (qs[p] = qs[p] || []).push({ phrase: phrase, imp: numOr_(r['impressions']) || 0 });
  });
  Object.keys(qs).forEach(p => { out.queries[p] = qs[p].sort((a, b) => b.imp - a.imp).slice(0, 4).map(q => q.phrase); });
  table('Profile').forEach(r => {
    const addr = String(r['Address'] || '').trim(), t = String(r['Holds it'] || '').trim();
