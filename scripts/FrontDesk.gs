}
/** The Weeks tab as { room word: { week number: { day, title } } }, for "Tonight, Week 5". */
function weekTable_(ss) {
  const out = {}, sh = ss.getSheetByName('Weeks');
  if (!sh) return out;
  const rs = rooms_(ss);
  rows_(sh).filter(w => nightOf_(w)).forEach(w => {
    const room = String(w['room'] || '').trim() || (rs[0] ? rs[0].room : '');
    const word = roomWord_(room);
    (out[word] = out[word] || {})[Number(w['week'])] = { day: dayOf_(nightOf_(w)), title: String(w['what opens'] || '').replace(/^Week\s+\d+\s*[—–:-]\s*/i, '').trim() };
  });
