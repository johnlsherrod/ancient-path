  else if (!note) { lines.push('The Sources row holds no note for this voice yet.'); hi = 2; }
  else if (note.length > brief.length) { lines.push(note); hi = 2; }
  const out = { why: !src ? 'The Sources list could not be read just now, so its note is not shown.' : note ? brief : none, when: waitingSince_(x),
    from: { head: 'From the Sources list', lines: lines, hi: hi, src: 'Research Engine, Sources ' + id + ' · ' + x.src }, wordBy: CARD_VOICE_WORDS_ };
  if (k === 'add') { out.title = 'Add ' + name + (lane ? ' to ' + lane : '') + '?'; out.button = 'Add'; out.word = 'Added'; out.then = 'Changes it: Add puts it on the Sources list as read, and the log keeps the line. Pass sets it aside as not recommended. Undo stays ten minutes.'; }
  else if (k === 'paused') { out.title = 'Keep ' + name + ' paused, or restore it?'; out.button = 'Keep paused'; out.word = 'Kept paused'; out.then = 'Changes it: Keep paused leaves it paused. Restore puts it back on the Sources list. The log keeps the line, and Undo stays ten minutes.'; }
  else { out.title = 'Restore ' + name + ', or wait?'; out.button = 'Restore'; out.word = 'Restored'; out.then = 'Changes it: Restore puts it back on the Sources list. Wait leaves it paused for thirty days. The log keeps the line, and Undo stays ten minutes.'; }
