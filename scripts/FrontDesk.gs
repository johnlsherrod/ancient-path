      row[H['for']] = 'Ask Our Team · Your Growth'; row[H['because']] = text.slice(0, 400); row[H['link']] = 'mailto:' + email; row[H['status']] = 'open'; row[H['mark done by hand']] = false; row[H['rule']] = 'RE16';
