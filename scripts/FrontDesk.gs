  voice_set: (w, b) => voiceSet_(w, b),
  release_set: (w, b) => releaseSet_(w, b),
  move_set: (w, b) => moveSet_(w, b),
  undo: (w, b) => actionUndo_(w, b),
  after_set: (w, b) => afterSet_(w, b),
  team_note: (w, b) => teamNote_(w, b),
  notice_set: (w, b) => noticeSet_(w, b),
  partner_answer: (w, b) => partnerAnswer_(w, b),
  partner_need: (w, b) => partnerNeed_(w, b),
  partner_undo: (w, b) => partnerUndo_(w, b),
