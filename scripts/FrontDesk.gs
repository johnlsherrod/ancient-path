    send: kind === 'seat' || kind === 'note' || (kind === 'road' && lever === 'referral'), reach: kind === 'ans' || kind === 'add', nothing: kind === 'ans' || kind === 'add',
    reply: kind === 'contact', approve: kind === 'draft' || kind === 'art', change: kind === 'draft', redraw: kind === 'art', accept: kind === 'concerns', aside: kind === 'concerns', lineundo: kind === 'concerns', write: kind === 'search', watch: kind === 'search', publish: kind === 'testimony', hold: kind === 'testimony', decline: kind === 'testimony' };
  if (!okFor[act]) throw { code: 'bad_action' };
