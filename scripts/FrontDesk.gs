  const p = dayOf_(nightOf_(hit)).split('-').map(Number);
  return ['Coming up', '', 'Week ' + hit['week'] + ', ' + MONTHS_[p[1] - 1] + ' ' + p[2] + ': ' + piece + ', the ' + ordinalWord_(k) + ' story piece. It will be on your page that week.', ''];
