/** build 30: writes the card words onto feed.actions and builds feed.doneWeek. The cards' own fields are not touched. */
function presentFeed_(ss, cfg, feed, actionRows) {
  const ctx = cardCtx_(ss, cfg, feed);
  feed.actions = (feed.actions || []).map(a => a && a.key === 'voices:open' ? a : presentAction_(a, ctx)); // build 34: the folded voices card is already drawn; each line inside it was presented before it was folded
  feed.doneWeek = doneWeekFrom_(actionRows, ctx);
  try { foldVoices_(feed); } catch (e) { alert_('The voices could not be folded into one card: ' + e + '\n' + (e.stack || '')); } // build 34 (RE12)
  feed.actless = {}; (feed.actions || []).forEach(a => { if (a && a.noAct && !/^research:hold:/.test(String(a.key || ''))) { const k = (/^([a-z]+):/.exec(String(a.key || '')) || [, '?'])[1]; feed.actless[k] = (feed.actless[k] || 0) + 1; } }); // build 34: the kinds with no act yet, for the ten-line check
  try { // build 32: a partner's question answered or a need added or set aside from the desk stays in Done this week, and in its count
    const pd = partnerDoneWeek_(ctx);
    if (pd.length) { feed.doneWeek = feed.doneWeek.concat(pd).sort((p, q) => Date.parse(q.doneAt) - Date.parse(p.doneAt)).slice(0, CARD_DONE_MAX_); feed.doneThisWeek = (feed.doneThisWeek || 0) + pd.length; }
  } catch (e) {}
}

// ---- Done: who pressed it and when ----
/** The desk's Done button: ticks "mark done by hand" on a card, and writes the day, the first name of who pressed it and, for a check card, his answer. */
function actionDone_(who, b) {
  const key = String(b.actionKey || '');
  if (!/^[a-z]+:\S+$/.test(key) || key.length > 200) throw { code: 'bad_action' };
  const answer = b.answer === undefined || b.answer === null ? '' : String(b.answer);
  if (answer && MOVE_ANSWERS_.indexOf(answer) < 0) throw { code: 'bad_action' };
  if (!canClose_(who, key)) throw { code: 'not_yours' }; // build 21: a facilitator closes only a card that carries his name
  return actionClose_(who, key, { answer: /^check:/.test(key) ? answer : '' });
}
/**
 * Closes one card. opt: answer (a check card's helped or nochange), keepMove (Wait and Drop: the Moves row has just been set, so it is not set to done),
 * word and went (what the Done this week row says when the press was a Wait or a Drop). A card that is already done is answered, not written again.
 */
function actionClose_(who, key, opt) {
  const o = opt || {};
  const ss = SpreadsheetApp.openById(FD.SHEET_ID);
  ensureBuild30_(ss);
  const sh = ss.getSheetByName('Actions');
  const H = headerIndex_(sh), data = sh.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][H['key']] || '').trim() !== key) continue;
    if (String(data[i][H['status']]) === 'done') { // pressed twice, or closed by the script a moment ago: answer, write nothing
      const was = data[i][H['done at']] ? toDate_(data[i][H['done at']]) : new Date();
      return { ok: true, at: was.toISOString(), by: H['done by'] !== undefined ? String(data[i][H['done by']] || '') : '', undoUntil: new Date(was.getTime() + CARD_UNDO_MS_).toISOString() };
    }
    const at = new Date(), by = firstOf_(who && who.name) || firstOf_(String((who && who.email) || '').split('@')[0]);
    sh.getRange(i + 1, H['mark done by hand'] + 1).setValue(true);
    sh.getRange(i + 1, H['status'] + 1).setValue('done');
    sh.getRange(i + 1, H['done at'] + 1).setValue(at);
    if (H['done by'] !== undefined) sh.getRange(i + 1, H['done by'] + 1).setValue(by);
    const how = o.how || changedHow_(key); // build 33: how it closed, kept on the row
    if (H['closed how'] !== undefined) sh.getRange(i + 1, H['closed how'] + 1).setValue(how);
    try { dropFromFeed_(key, { at: at, by: by, word: o.word, went: o.went, how: how, noUndo: !!o.noUndo }); } catch (e) { /* the next 5-minute run writes the feed anyway */ }
    // build 20: Done on a move card also moves the row on the Moves tab along; build 30: a check card carries his answer
    try {
      if (/^move:/.test(key)) { if (!o.keepMove) moveStatus_(ss, key.slice(5), 'done'); }
      else if (/^check:/.test(key)) {
        if (o.answer) { const mv = ss.getSheetByName('Moves'); if (mv) ensureMovesCols_(mv); moveStatus_(ss, key.slice(6), 'checked', { answer: o.answer }); }
        else moveStatus_(ss, key.slice(6), 'checked');
      }
    } catch (e) {}
    return { ok: true, at: at.toISOString(), by: by, undoUntil: o.noUndo ? new Date(at.getTime() - 36e5).toISOString() : new Date(at.getTime() + CARD_UNDO_MS_).toISOString() }; // build 36: a sent mail has no Undo
  }
  throw { code: 'none' };
}

/** build 18: take a closed card out of the stored feed at once, so every desk shows it gone without waiting for the next run. build 30: and into Done this week. */
function dropFromFeed_(key, meta) {
  const cell = feedCell_(SpreadsheetApp.openById(FD.SHEET_ID));
  const feed = JSON.parse(cell.getValue() || 'null');
  if (!feed || !Array.isArray(feed.actions)) return;
  let card = feed.actions.filter(a => a.key === key)[0], fromLine = false;
  if (!card && VOICE_KEY_ANY_.test(key)) { card = voiceLineOut_(feed, key); fromLine = !!card; } // build 34: a voice ruled leaves the folded voices card
  if (!card) return;
  if (!fromLine) feed.actions = feed.actions.filter(a => a.key !== key);
  feed.doneThisWeek = (feed.doneThisWeek || 0) + 1;
  if (meta && meta.at) {
    const entry = Object.assign({}, card, { doneAt: meta.at.toISOString(), by: meta.by || '', undoUntil: meta.noUndo ? new Date(meta.at.getTime() - 36e5).toISOString() : new Date(meta.at.getTime() + CARD_UNDO_MS_).toISOString(), canReopen: !meta.noUndo && (!/^voice:/.test(key) || !!voiceUndoGet_(key)) });
    if (entry.story) entry.story = storyBare_(entry.story); // build 36.2: the words of a story are not kept in Done this week
    if (meta.word) { entry.was = { word: card.word, went: card.went, fwent: card.fwent }; entry.word = meta.word === CLOSED_SENT_ ? 'Sent' : meta.word; entry.went = meta.went || card.went; entry.fwent = meta.went || card.fwent; }
    if (meta.how) { entry.how = meta.how; delete entry.stale; if (/^(Proven|Dropped|Lapsed)$/.test(meta.how)) { const h = honestRow_(Object.assign({}, entry), meta.how); entry.word = h.word; entry.went = h.went; entry.fwent = h.fwent; } }
    feed.doneWeek = [entry].concat((feed.doneWeek || []).filter(d => d.key !== key)).slice(0, CARD_DONE_MAX_);
  }
  cell.setValue(JSON.stringify(feed));
}

// ---- Wait keeps the floor rule: on the check day the desk makes a new card only if the numbers mean something ----
/**
 * Called by rebuildActions_ for a taken move whose "comes back" day has arrived. For a page move, when the page's latest showings in the Search profile are still under
 * Config "signal floor" (default 100), no card is made and "comes back" moves forward by another Config "move check days" (30), written to the Moves row; returns true.
 * At or over the floor, or when the showings cannot be read, it returns false and the card returns.
 */
function moveWaitHolds_(ss, cfg, m, todayDay) {
  if (!/^page:/.test(String(m['key'] || ''))) return false;
  let path = String(m['signal'] || '').split(' \u2014 ')[0].trim();
  if (path.charAt(0) !== '/') path = pathOf_(m['link']);
  let reads;
  try { reads = searchReadsOnce_(cfg); } catch (e) { return false; }
  const rows = ((reads && reads.pages && reads.pages[path]) || []).slice().sort((a, b) => a.month.localeCompare(b.month));
  if (!rows.length || rows[rows.length - 1].imp >= (cfg.signalFloor || 100)) return false;
  const mv = ss.getSheetByName('Moves');
  if (mv) ensureMovesCols_(mv);
  return moveStatus_(ss, String(m['key']), 'taken', { 'comes back': addDays_(todayDay, cfg.moveCheckDays || 30) });
}

// ---- Wait and Drop on a move: the move's card closes at once ----
function closeMoveCard_(who, moveKey, status, ex) {
  const ck = 'move:' + moveKey;
  if (!canClose_(who, ck)) return;
  let card = null;
  try { const feed = JSON.parse(feedCell_(SpreadsheetApp.openById(FD.SHEET_ID)).getValue() || 'null'); card = feed ? (feed.actions || []).filter(a => a.key === ck)[0] : null; } catch (e) { card = null; }
  let word, went;
  if (status === 'dropped') { word = 'Changed The Moves'; const why = ex['reason'] || CARD_DROP_REASON_; went = card && card.dropWent && why === CARD_DROP_REASON_ ? card.dropWent : 'The Moves keeps it as Dropped, with the reason “' + why + '”.'; }
  else { word = 'Changed The Moves'; went = card && card.rec && card.rec.kind === 'wait' ? card.went : 'The Moves keeps it as waiting. It comes back ' + dayLong_(ex['comes back']) + '.'; }
  actionClose_(who, ck, { keepMove: true, word: word, went: went });
}

// ---- Undo for ten minutes, Reopen for the week ----
const CARD_UNDO_KEY_ = 'fd:undo:voice:';
function voiceUndoSave_(key, rec) { try { CacheService.getScriptCache().put(CARD_UNDO_KEY_ + key, JSON.stringify(rec), REL_UNDO_TTL_); } catch (e) {} }
function voiceUndoGet_(key) { try { const v = CacheService.getScriptCache().get(CARD_UNDO_KEY_ + key); return v ? JSON.parse(v) : null; } catch (e) { return null; } }
/** Puts a voice's Sources status and note back to what they were at the press. A voice ruled by hand since is not overwritten. */
function voiceUndoRun_(key, rec) {
  if (!rec || rec.noop) return;
  const rs = SpreadsheetApp.openById(RESEARCH_SHEET_ID_), sh = rs.getSheetByName('Sources');
  if (!sh || sh.getLastRow() < 2) return;
  const data = sh.getDataRange().getValues(), C = voiceCols_(data[0]);
  if (C.id < 0 || C.status < 0 || C.note < 0) return;
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][C.id] || '').trim() !== rec.id) continue;
    if (String(data[i][C.status] || '').trim().toLowerCase() !== String(rec.to || '').toLowerCase()) return;
    sh.getRange(i + 1, C.status + 1).setValue(rec.from);
    sh.getRange(i + 1, C.note + 1).setValue(rec.note);
    try { relLog_(rs, 'voice', rec.id + ': ruling undone (' + rec.to + ' back to ' + rec.from + '), card ' + key); } catch (e) {}
    return;
  }
}
function actionUndo_(who, b) { return pressLock_('undo', who, b, () => actionUndoDo_(who, b)); }
/**
 * undo { actionKey, mode: 'undo' | 'reopen' } → { ok, card }. Undo works for ten minutes after the press, Reopen for seven days; after that the answer is
 * { error: 'undo_expired' } or { error: 'reopen_expired' }. The Actions row goes back to open (done at, done by and mark done by hand cleared); a move or check card puts its
 * Moves row back; a voice card puts the Sources status and note back from what voiceDo_ kept at the press, and cannot be reopened once that is gone.
 * The card goes back into the stored feed at once, out of Done this week, and the count of done this week goes down by one.
 */
function actionUndoDo_(who, b) {
  const key = String(b.actionKey || ''), mode = String(b.mode || '');
  if (!/^[a-z]+:\S+$/.test(key) || key.length > 200 || (mode !== 'undo' && mode !== 'reopen')) throw { code: 'bad_action' };
  if (!canClose_(who, key)) throw { code: 'not_yours' };
  const ss = SpreadsheetApp.openById(FD.SHEET_ID);
  ensureBuild30_(ss);
  const sh = ss.getSheetByName('Actions');
  const H = headerIndex_(sh), data = sh.getDataRange().getValues();
  for (let i = 1; i < data.length; i++) {
    if (String(data[i][H['key']] || '').trim() !== key) continue;
    if (String(data[i][H['status']]) !== 'done') {
      if (/^draft:/.test(key) && data[i][H['mark done by hand']] === true) { // build 36.1: an approved draft waiting for its article; the tick comes off
        const dAt = data[i][H['done at']] ? toDate_(data[i][H['done at']]) : null, dAge = dAt ? Date.now() - dAt.getTime() : Infinity;
        if (mode === 'undo' && !(dAge <= CARD_UNDO_MS_)) throw { code: 'undo_expired' };
        if (mode === 'reopen' && !(dAge <= CARD_REOPEN_MS_)) throw { code: 'reopen_expired' };
        draftUnapprove_(sh, H, i);
        const dcard = cardBackToFeed_(ss, key, data[i], H);
        cardLog_(mode === 'undo' ? 'card undo' : 'card reopen', key, who);
        return { ok: true, card: dcard };
      }
      return { ok: true, already: true, card: cardFromFeed_(ss, key) }; // pressed twice: it is open
    }
    const doneAt = data[i][H['done at']] ? toDate_(data[i][H['done at']]) : null;
    const age = doneAt ? new Date().getTime() - doneAt.getTime() : Infinity;
    if (mode === 'undo' && !(age <= CARD_UNDO_MS_)) throw { code: 'undo_expired' };
    if (mode === 'reopen' && !(age <= CARD_REOPEN_MS_)) throw { code: 'reopen_expired' };
    if (H['closed how'] !== undefined && String(data[i][H['closed how']] || '') === CLOSED_SENT_) throw { code: mode === 'undo' ? 'undo_expired' : 'reopen_expired' }; // build 36: a sent mail cannot be taken back
    let vrec = null;
    if (/^voice:/.test(key)) { vrec = voiceUndoGet_(key); if (!vrec) throw { code: 'reopen_expired' }; }
    if (vrec) voiceUndoRun_(key, vrec);
    let arec = null; // build 34: Bring it, Not for the room and Filed changed a record outside the Actions tab; Undo and Reopen put it back
    if (H['closed how'] !== undefined && /^(Changed This Week|Changed the Research Engine|Changed the inbox|Changed the follow-ups|Changed the words for Claude|Changed Our Stories|Changed the testimony sheet)$/.test(String(data[i][H['closed how']] || ''))) { arec = actUndoGet_(key); if (!arec) throw { code: 'reopen_expired' }; actUndoRun_(key, arec); }
    if (/^concerns:/.test(key)) { // build 36.1: reopening a concerns card takes back the line ruled last
      const cst = concernState_(key), last = Object.keys(cst).sort((p, q) => cst[q].at - cst[p].at)[0];
      if (last !== undefined) { if (cst[last].a === 'accept' && cst[last].rec) concernUndo_(cst[last].rec); delete cst[last]; concernStateSet_(key, cst); }
    }
    if (WORKSHOP_KEY_.test(key)) { // build 32: the weekday update card's lines, as they were before Send, come back from what workshop_send kept
      const orig = workshopOrig_(key);
      if (orig) { sh.getRange(i + 1, H['because'] + 1).setValue(orig); data[i][H['because']] = orig; workshopOrigDrop_(key); }
    }
    const mv = ss.getSheetByName('Moves');
    if (/^move:/.test(key)) { if (mv) ensureMovesCols_(mv); moveStatus_(ss, key.slice(5), 'taken', { 'comes back': '', answer: '', reason: '' }); }
    else if (/^check:/.test(key)) { if (mv) ensureMovesCols_(mv); moveStatus_(ss, key.slice(6), 'done', { answer: '' }); }
    sh.getRange(i + 1, H['status'] + 1).setValue('open');
    sh.getRange(i + 1, H['done at'] + 1).setValue('');
    sh.getRange(i + 1, H['mark done by hand'] + 1).setValue(false);
    if (H['done by'] !== undefined) sh.getRange(i + 1, H['done by'] + 1).setValue('');
    if (H['closed how'] !== undefined) sh.getRange(i + 1, H['closed how'] + 1).setValue('');
    if (H['kept on'] !== undefined) sh.getRange(i + 1, H['kept on'] + 1).setValue(new Date()); // a card he reopened is touched: the 30 days start again
    try { unproveWords_(ss, key); } catch (e) { /* the words stay as the page proved them */ }
    if (vrec) { try { CacheService.getScriptCache().remove(CARD_UNDO_KEY_ + key); } catch (e) {} }
    if (arec) actUndoDrop_(key);
    const card = cardBackToFeed_(ss, key, data[i], H);
    cardLog_(mode === 'undo' ? 'card undo' : 'card reopen', key, who); // build 30: the brief's measures (Undo and Reopen used) are read from the Log tab
    return { ok: true, card: card };
  }
  throw { code: 'none' };
}
function cardFromFeed_(ss, key) {
  try { const feed = JSON.parse(feedCell_(ss).getValue() || 'null'); return feed ? ((feed.actions || []).filter(a => a.key === key)[0] || null) : null; } catch (e) { return null; }
}
/** The card goes back into feed.actions (first in line) and out of feed.doneWeek; the count of done this week goes down by one. Returns the card. */
function cardBackToFeed_(ss, key, row, H) {
  const cell = feedCell_(ss);
  let feed = null;
  try { feed = JSON.parse(cell.getValue() || 'null'); } catch (e) { feed = null; }
  const raw = { key: key, owner: row[H['owner']], do: row[H['do this']], for: row[H['for']], because: row[H['because']], link: row[H['link']], firstSeen: row[H['first seen']] ? toDate_(row[H['first seen']]).toISOString() : null, rule: row[H['rule']], keptOn: new Date().toISOString() };
  let card = null;
  if (feed) {
    const inDone = (feed.doneWeek || []).filter(d => d.key === key)[0];
    if (inDone && !WORKSHOP_KEY_.test(key) && !/^testimony:/.test(key)) { // build 32: an update card comes back from its restored lines, not from the Done this week entry
      card = Object.assign({}, inDone);
      if (card.was) { card.word = card.was.word; card.went = card.was.went; card.fwent = card.was.fwent; }
      ['doneAt', 'by', 'undoUntil', 'canReopen', 'was'].forEach(f => { delete card[f]; });
      Object.keys(card).forEach(f => { if (card[f] === undefined) delete card[f]; });
    }
  }
  if (!card) { try { card = presentAction_(raw, cardCtx_(ss, readConfig_(), feed || {})); } catch (e) { card = raw; } }
  if (feed) {
    feed.doneWeek = (feed.doneWeek || []).filter(d => d.key !== key);
    if (!(feed.actions || []).some(a => a.key === key)) feed.actions = [card].concat(feed.actions || []);
    if (VOICE_KEY_ANY_.test(key)) { try { foldVoices_(feed); } catch (e) {} } // build 34: a voice put back joins the folded card
    feed.doneThisWeek = Math.max(0, (feed.doneThisWeek || 0) - 1);
    if (feed.moves && /^(move|check):/.test(key)) { // a dropped move was out of the list; the row is back
      const mk = key.replace(/^(move|check):/, '');
      if (!(feed.moves.taken || []).some(t => t.key === mk)) {
        const m = movesByKey_(ss)[mk];
        if (m) feed.moves.taken = (feed.moves.taken || []).concat([{ key: m.key, signal: m.signal, from: m.from, move: m.move, owner: m.owner, due: m.due, check: m.check, status: m.status, written: null, by: '', note: '', link: m.link, before: m.before, answer: m.answer, comes: m.comes, reason: m.reason }]);
      }
    }
    cell.setValue(JSON.stringify(feed));
  }
  return card;
}

// ---- the whole facilitator page, on the desk ----
/**
 * notes_page { pageKey } → { ok, title, when, url (admins only), secs: [[heading, [lines]], ...] }. The key is the Drive file id a card's "from.page.key" carries.
 * Only a facilitator page in the facilitator notes folder is read; any other id is refused. A facilitator reads his own room's pages; our team reads them all.
 */
function notesPage_(who, b) {
  const id = String(b.pageKey || '').trim();
  if (!/^[A-Za-z0-9_-]{10,100}$/.test(id)) throw { code: 'bad_action' };
  const folder = readConfig_().facFolderId || FD.FAC_FOLDER_ID;
  let file;
  try { file = DriveApp.getFileById(id); } catch (e) { throw { code: 'none' }; }
  let inFolder = false;
  const ps = file.getParents();
  while (ps.hasNext()) { if (ps.next().getId() === folder) { inFolder = true; break; } }
  const m = /^(.+?)\s+—\s+Week\s+(\d+)\s+—\s+for the facilitator/i.exec(file.getName());
  if (!inFolder || !m) throw { code: 'not_yours' };
  if (who.role !== 'admin' && !(who.room && sameRoom_(m[1].trim(), who.room))) throw { code: 'not_yours' };
  const cache = CacheService.getScriptCache(), ck = 'fd:page2:' + id + ':' + file.getLastUpdated().getTime();
  let page = null;
  try { const hit = cache.get(ck); if (hit) page = JSON.parse(hit); } catch (e) {}
  if (!page) {
    page = facPage_(DocumentApp.openById(id).getBody().getText());
    try { cache.put(ck, JSON.stringify(page), 6 * 3600); } catch (e) {}
  }
  let names = {}; try { names = heldNames_(null); } catch (e) { names = {}; }
  const out = { ok: true, title: file.getName(), when: page.session ? String(page.session).split('.')[0] : 'Week ' + m[2], secs: (page.secs || []).map(s => [s[0], holdRoom_(s[0], s[1], names)]) };
  if (who.role === 'admin') out.url = 'https://docs.google.com/document/d/' + id + '/edit';
  cardLog_('notes page', id, who); // build 30: whole page opened
  return out;
}

// ───────────────────────────── the feed the page reads ─────────────────────────────

function writeFeed_(ss, cfg, captured, cal, search, themes) {
  const now = new Date();
  const roster = rows_(ss.getSheetByName('Roster'));
  const inbound = rows_(ss.getSheetByName('Inbound'));
  const payments = rows_(ss.getSheetByName('Payments'));
  const coaching = rows_(ss.getSheetByName('Coaching'));
  const actions = rows_(ss.getSheetByName('Actions'));
  const d7 = new Date(now - 7 * 864e5), d30 = new Date(now - 30 * 864e5);
  const iso = (d) => d ? toDate_(d).toISOString() : null;
  // build 22
  const notesMap = notes_(ss), handledMap = handled_(ss), acNow = acLatest_();
  const raisedAt = {}; ((acNow && acNow.carrying_tags) || []).forEach(t => { if (/hand raised/i.test(String(t.tag || ''))) raisedAt[String(t.email || '').toLowerCase()] = t.tag_added || null; });

  const seated = roster.filter(r => r['seated']).length;
  const theirsAll = inbound.filter(r => !String(r['handling']).includes('ours'));
  const theirs = theirsAll.filter(r => r['kind'] !== SPAM_KIND_); // build 32.2: a form that looks like spam is not a row; the day shows one line (inbound.spam)
  const byKind7 = {};
  theirs.filter(r => toDate_(r['received']) >= d7).forEach(r => { byKind7[r['kind']] = (byKind7[r['kind']] || 0) + 1; });

  // Coaching sessions still ahead: the session's own time (Central, from the Calendly subject) decides, not the day the email came.
  // A session that started up to 90 minutes ago still counts as "now". Soonest first.
  const ahead = coaching
    .filter(r => r['status'] !== 'canceled' && !isTrackingTest_(r['session']) && !isTrackingTest_(r['name'])) // build 33: a Tracking Test event is the desk's own test, not a session
    .map(r => Object.assign({ at: whenToDate_(r['when (Central)']) }, r))
    .filter(r => !r.at || (now - r.at) < 90 * 60e3)
    .sort((a, b) => (a.at ? a.at : new Date(8.64e15)) - (b.at ? b.at : new Date(8.64e15)))
    .slice(0, 30);
  // build 9: sessions on John's Google calendars, folded in with the Calendly ones (a Calendly booking that is also on
  // the calendar shows once — the calendar copy is dropped when a Calendly session starts within ten minutes of it).
  // build 20: coaching only — a roster man is a guest or named in the title, or the title says coaching or session; never the cohort's night.
  const normN = (s) => String(s || '').toLowerCase().replace(/[^a-z]/g, '');
  const rosterNames = roster.map(r => normN(r['name'])).filter(n => n.length > 3), rosterMails = new Set(roster.map(r => String(r['email']).toLowerCase()));
  const cohortWord = String(cfg.cohortName || 'Breaking Free').split('—')[0].trim().toLowerCase();
  const isCoaching = (ev) => {
    const t = String(ev.title || '').toLowerCase();
    if (cohortWord && t.indexOf(cohortWord) >= 0) return false;
    if ((ev.guests || []).some(g => rosterMails.has(g))) return true;
    if (rosterNames.some(n => normN(t).indexOf(n) >= 0)) return true;
    return /coaching|session/.test(t);
  };
  const calAhead = ((cal && cal.events) || [])
    .filter(isCoaching)
    .filter(ev => !isTrackingTest_(ev.title))
    .filter(ev => (now - ev.start) < 90 * 60e3)
