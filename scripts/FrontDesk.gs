function roadNorm_(s) { return String(s || '').toLowerCase().replace(/[^a-z0-9]/g, ''); }
/** A day cell or a day in words → yyyy-MM-dd (Central), or ''. */
function roadDay_(v) {
  const d = nightDate_(v);
  if (d) return dayOf_(d);
  const t = String(v || '').trim();
  const g = t ? new Date(t) : null;
  return g && !isNaN(g) ? dayOf_(g) : '';
}
/** The "he can open it from" cell → { all: day for every piece on the row, by: { normalized piece name: day } }. */
function roadHolds_(cell) {
  const out = { all: '', by: {} };
  if (cell instanceof Date) { out.all = dayOf_(cell); return out; }
  String(cell || '').split(/\n|;/).map(x => x.trim()).filter(Boolean).forEach(line => {
    const m = /^(.*?)\s*[:=]\s*(.+)$/.exec(line);
    if (m && roadDay_(m[2]) && !/^\d{4}$/.test(m[1].trim()) && m[1].trim()) { out.by[roadNorm_(m[1])] = roadDay_(m[2]); return; }
    const d = roadDay_(line);
    if (d) out.all = d;
  });
  return out;
}

/**
 * The road of every course that has a room with Weeks rows. Public: the course, its nights, each piece. Never a man's name.
 * Each road: { course, name, room: { meets }, weeks: [{ week, day, title }], pieces: [...] } (pieces as build 24 shaped them).
 */
function roadFeed_() {
  const cache = CacheService.getScriptCache();
  const ckey = 'fd:road:' + FD.BUILD;
  const hit = cache.get(ckey);
  if (hit) return JSON.parse(hit);
  const ss = SpreadsheetApp.openById(FD.SHEET_ID);
  const rooms = rooms_(ss);
  const wkSh = ss.getSheetByName('Weeks'), pcSh = ss.getSheetByName('Pieces');
  const weeks = wkSh ? rows_(wkSh).filter(w => nightOf_(w)) : [];
  const pieces = pcSh ? rows_(pcSh) : [];
  const links = (s) => String(s || '').split(/\s*\n\s*/).map(x => x.trim()).filter(x => /^https?:\/\//.test(x));
  const roads = [], done = {};
  rooms.forEach((rm, ri) => {
    if (!rm.course || done[rm.course]) return;
    const wk = weeks.filter(w => (String(w['room'] || '').trim() ? sameRoom_(w['room'], rm.room) : ri === 0)).sort((a, b) => nightOf_(a) - nightOf_(b));
    if (!wk.length) return;
    done[rm.course] = true;
    const named = pieces.find(p => String(p['address'] || '').replace(/\/+$/, '').split('?')[0].toLowerCase().endsWith('/course/' + rm.course.toLowerCase()));
    const road = { course: rm.course, name: named ? String(named['name']) : rm.course, room: { meets: rm.meets }, weeks: [], pieces: [] };
    wk.forEach(w => {
      const num = Number(w['week']), day = dayOf_(nightOf_(w));
      road.weeks.push({ week: num, day: day, title: String(w['what opens'] || '').trim() });
      const names = String(w['piece introduced'] || '').split(/\s*,\s*then\s+|\s*,\s*|\s+then\s+/).map(x => x.trim()).filter(Boolean);
      const addrs = links(w['piece address']);
      const holds = roadHolds_(w['he can open it from']);
      names.forEach((n, i) => {
        const pc = pieces.find(p => roadNorm_(p['name']) === roadNorm_(n));
        const url = addrs.length === names.length ? addrs[i] : (names.length === 1 && addrs.length ? addrs[0] : (pc ? String(pc['address'] || '').trim() : ''));
        road.pieces.push({ week: num, day: day, name: n, url: url || (pc ? String(pc['address'] || '').trim() : ''), asks: pc ? String(pc['what this asks of you'] || '').trim() : '', opens: holds.by[roadNorm_(n)] || holds.all || '' });
      });
    });
    roads.push(road);
  });
  const out = { ok: true, build: FD.BUILD, roads: roads };
  cache.put(ckey, JSON.stringify(out), 120);
  return out;
}

