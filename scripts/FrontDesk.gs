  } catch (e) { /* the card keeps its own lines */ }
  return out;
}

// ---- a press on a move that was set to Wait or Dropped reads as that, not as Made ----
function doneOutcome_(card, ctx) {
  const mk = /^move:(.+)$/.exec(String(card.key || ''));
  if (!mk) return card;
  const m = ctx.moves[mk[1]];
  if (!m) return card;
  if (m.status === 'dropped') {
    const why = m.reason || CARD_DROP_REASON_;
    const went = card.dropWent && why === CARD_DROP_REASON_ ? card.dropWent : 'The Moves keeps it as Dropped, with the reason “' + why + '”.';
    return Object.assign({}, card, { word: 'Changed The Moves', went: went, fwent: went, was: { word: card.word, went: card.went, fwent: card.fwent } });
  }
  if (m.status === 'taken' && m.comes && m.comes > ctx.today) {
    const went = card.rec && card.rec.kind === 'wait' ? card.went : 'The Moves keeps it as waiting. It comes back ' + dayLong_(m.comes) + '.';
    return Object.assign({}, card, { word: 'Changed The Moves', went: went, fwent: went, was: { word: card.word, went: card.went, fwent: card.fwent } });
  }
  return card;
}

// ───────────────────────────── build 30 · the card standard: the sheet side ─────────────────────────────
// What presenter.gs needs from the record, the Actions tab's new column, the Done press that says who and when, and the three new calls:
// undo (Undo for ten minutes, Reopen for the week), notes_page (the whole facilitator page, drawn on the desk) and, in moveSetDo_, Wait and Drop.

/**
 * Adds the "done by" column to the Actions tab, after the columns it has, the first time it is needed, and the Config row "signal floor" once.
 * Nothing is reordered. A sheet that already has the column is left as it is. Called by run() before rebuildActions_ and by the Done and Undo presses.
 */
function ensureBuild30_(ss) {
  const sh = ss.getSheetByName('Actions');
  if (!sh) return false;
  let added = false;
  if (headerIndex_(sh)['done by'] === undefined) {
    const col = Math.max(1, sh.getLastColumn()) + 1;
    if (sh.getMaxColumns() < col) sh.insertColumnsAfter(sh.getMaxColumns(), col - sh.getMaxColumns());
    sh.getRange(1, col).setValue('done by');
    added = true;
  }
  const props = PropertiesService.getScriptProperties();
  if (props.getProperty('fd:b30') !== '1') { ensureConfig_(); props.setProperty('fd:b30', '1'); }
  try { if (ensureBuild33_(ss)) added = true; } catch (e) { /* the columns are made by the next call */ }
  return added;
}

// ---- what the card words read from the record ----
/** Every row on the Moves tab by key, dropped ones included (movesFeed_ leaves those out). */
function movesByKey_(ss) {
  const sh = ss.getSheetByName('Moves'), out = {};
  if (!sh) return out;
  rows_(sh).forEach(r => {
    if (!r['key']) return;
    out[String(r['key'])] = { key: String(r['key']), signal: String(r['signal'] || ''), from: String(r['from'] || ''), move: String(r['move'] || ''), owner: String(r['owner'] || ''),
      due: dayCell_(r['due']), check: dayCell_(r['check']), status: String(r['status'] || '').toLowerCase(), comes: dayCell_(r['comes back']),
      answer: String(r['answer'] || ''), reason: String(r['reason'] || ''), before: String(r['before'] || ''), link: String(r['link'] || '') };
