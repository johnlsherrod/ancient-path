// ---- stale rows close themselves (the foreign rows the script does not own) ----
/**
 * Called by rebuildActions_ with the rows about to be written. Four sweeps, each closing a row as Folded (not a press: Done this week never lists it) or Proven:
 *   research:hold:<id>  the Release List's own row. Closed when its piece is no longer a candidate (released, held, or gone). A piece still a candidate keeps its card, because
 *                       a closed hold card HOLDS the piece (relState_), so the sweep never touches a candidate.
 *   workshop:<date>     a newer open update card absorbs the older open ones: their lines join the newest card's lines, once each, and the older rows close.
 *   publish:<slug>      the Publisher's Fix row closes as Proven when the article's address answers.
 */
function foldSweep_(ss, cfg, out, H, now) {
  const open = (row) => String(row[H['status']]) === 'open';
  const key = (row) => String(row[H['key']] || '').trim();
  const close = (row, how) => { row[H['status']] = 'done'; row[H['done at']] = now; setHowCell_(row, H, how); };
  // research:hold
  const holds = out.filter(r => open(r) && /^research:hold:/.test(key(r)));
  if (holds.length) {
    let ctx = null;
    try { ctx = relLoad_(SpreadsheetApp.openById(RESEARCH_SHEET_ID_).getSheetByName('Entries')); } catch (e) { ctx = null; }
    if (ctx) holds.forEach(r => { const id = key(r).slice('research:hold:'.length), e = ctx.entries.filter(x => x.id === id)[0]; if (!e || e.status !== 'candidate') close(r, CLOSED_FOLDED_); });
  }
  // workshop
  const ws = out.filter(r => open(r) && WORKSHOP_KEY_.test(key(r))).sort((a, b) => key(a).localeCompare(key(b)));
  if (ws.length > 1) {
    const newest = ws[ws.length - 1], lines = [];
    const take = (r) => String(r[H['because']] || '').split(/\n/).map(l => l.trim()).filter(Boolean).forEach(l => { if (lines.indexOf(l) < 0) lines.push(l); });
    ws.forEach(take);
    newest[H['because']] = lines.join('\n');
    ws.slice(0, -1).forEach(r => close(r, CLOSED_FOLDED_));
  }
  // publish
  out.filter(r => open(r) && /^publish:/.test(key(r))).forEach(r => { try { if (publishAnswers_(cfg, r, H)) close(r, CLOSED_PROVEN_); } catch (e) { /* the row stays open; the next run asks again */ } });
  // build 36.1: an approved draft closes as Proven when its article answers at a live address; the search refresh folds into a row under Through Search
  out.filter(r => open(r) && /^draft:/.test(key(r)) && r[H['mark done by hand']] === true).forEach(r => { try { if (draftLive_(key(r).slice('draft:'.length))) close(r, CLOSED_PROVEN_); } catch (e) { /* stays Waiting; the next run asks again */ } });
  out.filter(r => open(r) && /^refresh:/.test(key(r))).forEach(r => close(r, CLOSED_FOLDED_));
  // build 36: the found-episode link cards were retired Nov 5 (RE18); a "Post: <title>" row folds into the Publisher's card when that card exists
  out.filter(r => open(r) && /^research:link:/.test(key(r))).forEach(r => close(r, CLOSED_FOLDED_));
  const pubSlugs = {}; out.forEach(r => { const k = key(r); if (/^publish:/.test(k)) pubSlugs[k.slice('publish:'.length)] = 1; });
  out.filter(r => open(r) && /^post:/.test(key(r))).forEach(r => { if (pubSlugs[key(r).slice('post:'.length)]) close(r, CLOSED_FOLDED_); });
}
function setHowCell_(row, H, how) { if (H['closed how'] !== undefined) row[H['closed how']] = how; }
/** The article's address: the row's link (the reading site) and the slug, or Config "publisher address" with {slug} in it. */
function publishAddress_(row, H) {
  const slug = String(row[H['key']] || '').trim().slice('publish:'.length);
  let pat = '';
  try { const sh = SpreadsheetApp.openById(FD.SHEET_ID).getSheetByName('Config'); (sh.getDataRange().getValues().slice(1)).forEach(r => { if (String(r[0]).trim() === 'publisher address') pat = String(r[1] || '').trim(); }); } catch (e) {}
  if (pat) return pat.replace('{slug}', slug);
  const base = String(row[H['link']] || '').trim().replace(/\/+$/, '');
  return /^https?:\/\//.test(base) ? base + '/' + slug : '';
}
/** True when the address answers 200 with a page. Asked at most once in ten minutes per article (the cache). Never throws. */
function publishAnswers_(cfg, row, H) {
  const addr = publishAddress_(row, H);
