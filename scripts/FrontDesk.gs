    } catch (e) {}
  }
  return { ok: true, act: act, line: line.i, state: (st[line.i] || {}).a || '', lines: all, closed: !!closed, card: card, at: new Date().toISOString(), by: byOf_(who),
    did: ruled ? (accepted ? CLOSED_CONCERNS_ : 'Set aside') : '',
    went: act === 'accept' ? 'Written on the Concerns tab of the Guide sheet: ' + line.verb + ' “' + line.concern + '”' + (line.to ? ' to “' + line.to + '”' : '') + '. The Read door follows within ten minutes.' : act === 'aside' ? 'Set aside. Nothing was written.' : 'Taken back.' };
}

