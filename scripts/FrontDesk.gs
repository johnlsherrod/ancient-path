/** { from, subject, at, text } for the contact-form mail, kept six hours in the cache. Null when the mail cannot be read. */
const CONTACT_LABELS_ = { firstname: 'First name', lastname: 'Last name', email: 'Email', phone: 'Phone', message: 'Message' };
