    rm.getRange(2, 4, 200, 1).setNumberFormat('ddd mmm d, yyyy');
    rm.getRange(2, 8, 200, 1).setNumberFormat('mmm d, yyyy');
    [300, 80, 220, 130, 70, 160, 300, 120, 260].forEach((w, i) => rm.setColumnWidth(i + 1, w));
    rm.getRange(2, 1, 200, 9).setVerticalAlignment('top').setWrap(true);
  }
  if (rm.getLastRow() < 2) {
    const now = new Date();
    rm.getRange(2, 1, ROOMS_SEED_.length, 9).setValues(ROOMS_SEED_.map(r => [r[0], r[1], r[2], dayDate_(r[3]), r[4], r[5], r[6], now, r[7]]));
  }
  // the Weeks tab gains a room column (blank = the first room), so a second cohort is twelve rows that name theirs
  const wk = ss.getSheetByName('Weeks');
  if (wk && String(wk.getRange(1, 8).getValue() || '').trim() !== 'room') { wk.getRange(1, 8).setValue('room'); wk.setColumnWidth(8, 220); }
  const props = PropertiesService.getScriptProperties();
  if (props.getProperty('fd:b21') !== '1') { ensureConfig_(); props.setProperty('fd:b21', '1'); }
}
/** "Breaking Free — Jeremiah's Journey" → "breaking free": the word every record of a room shares (People, the Room tab, the notes' file names). */
function roomWord_(s) { return String(s || '').toLowerCase().split(/\s+[—–-]\s+/)[0].replace(/\s+/g, ' ').trim(); }
function sameRoom_(a, b) {
  const la = String(a || '').toLowerCase().replace(/\s+/g, ' ').trim(), lb = String(b || '').toLowerCase().replace(/\s+/g, ' ').trim();
  if (!la || !lb) return false;
  return la === lb || la.indexOf(lb) >= 0 || lb.indexOf(la) >= 0 || roomWord_(la) === roomWord_(lb);
}
function sameName_(a, b) { const f = (s) => String(s || '').trim().split(/\s+/)[0].toLowerCase(); return !!f(a) && f(a) === f(b); }
function rooms_(ss) {
  const sh = ss.getSheetByName('Rooms');
  return sh ? rows_(sh).filter(r => r['room']).map(r => ({
    room: String(r['room']).trim(), word: roomWord_(r['room']), kind: String(r['kind'] || 'cohort').toLowerCase(), meets: String(r['meets'] || ''),
    firstNight: nightDate_(r['first night']) ? dayOf_(nightDate_(r['first night'])) : '', // build 28.3: a date or a day in words
    weeks: Number(r['weeks'] || 0), course: String(r['course'] || '').trim(), folder: String(r['notes folder id'] || '').trim()
  })) : [];
}
/** The men of a room, from the Room tab (its room cell, or the cohort name when blank). */
function roomMen_(ss, cfg, room) {
  const sh = ss.getSheetByName('Room');
  return sh ? rows_(sh).filter(r => r['email'] && sameRoom_(r['room'] || cfg.cohortName, room)) : [];
}
/** Can this person touch this man from the desk? An admin, always; a facilitator, when the man sits in his room. */
function canTouchMan_(who, email) {
  if (who.role === 'admin') return true;
  if (!who.room) return false;
  const e = String(email || '').toLowerCase().trim();
  return roomMen_(SpreadsheetApp.openById(FD.SHEET_ID), readConfig_(), who.room).some(r => String(r['email']).toLowerCase().trim() === e);
}

/** The whole "for the facilitator" page, read by its fixed frame: Last week · What the room carried · Who to follow up with · What was promised · This week's room. */
function facPage_(text) {
  const lines = String(text || '').split('\n').map(s => s.trim());
  const heads = { 'last week': 'lastWeek', 'what the room carried': 'carried', 'who to follow up with': 'follow', 'what was promised': 'promised', "this week's room": 'thisRoom' };
  const lastHead = (k) => /^this [a-z]{3,9}day$/.test(k) ? 'thisRoom' : ''; // build 25: a page written with the older last heading is read the same
  const secs = {}, order = []; let cur = '';
  lines.forEach(l => {
    const k = l.toLowerCase().replace(/\u2019/g, "'").replace(/[:.]$/, ''), h = heads[k] || lastHead(k);
    if (h) { cur = h; secs[cur] = []; order.push([({ lastWeek: 'Last Week', carried: 'What the Room Carried', follow: 'Who to Follow Up With', promised: 'What Was Promised' })[h] || l.replace(/[:.]$/, ''), secs[cur]]); return; }
    if (!cur || !l) return;
    if (/^for the facilitator only/i.test(l)) { cur = ''; return; }
    secs[cur].push(l.replace(/^[\-•*]\s*/, ''));
  });
  const session = (lines.find(l => /^session:/i.test(l)) || '').replace(/^session:\s*/i, '');
  const followUps = [], attendance = { line: '', absent: [] };
  (secs.follow || []).forEach(l => {
    const m = /^([A-Z][^—:]{0,40}?)\s+[—–-]\s+(.+)$/.exec(l);
    if (m) followUps.push({ name: m[1].trim(), reason: m[2].trim() });
    else {
      attendance.line = (attendance.line ? attendance.line + ' ' : '') + l;
      const ab = /absent:?\s+(.+)$/i.exec(l) || /^(.+?)\s+(?:was|were)\s+not\s+in\s+the\s+room/i.exec(l);
      if (ab) attendance.absent = ab[1].replace(/\.$/, '').split(/\s*,\s*|\s+and\s+/).map(s => s.trim()).filter(s => s && !/^(no one|nobody)$/i.test(s));
    }
  });
  const promised = [];
  (secs.promised || []).forEach(l => {
    const m = /^([^:]{1,40}):\s*(.+)$/.exec(l);
    if (!m) return;
    promised.push({ owner: m[1].trim(), items: m[2].split(/;\s*/).map(s => s.trim().replace(/\.$/, '')).filter(Boolean) });
  });
  return { session: session, lastWeek: (secs.lastWeek || []).join(' '), themes: roomThemes_(text), followUps: followUps, attendance: attendance, promised: promised, thisRoom: (secs.thisRoom || []).join('\n'), secs: order };
}
/** Follow-ups and promises from the latest pages become cards: fu: for the room's facilitator, prom: for whoever said it (rules R20, R21). */
function facilitatorCards_(ss, cfg, want) {
  const pages = FAC_PAGES_ || [];
  if (!pages.length) return;
  const people = people_();
  const roomRows = rows_(ss.getSheetByName('Room'));
  const handledMap = handled_(ss); // build 22
  const byRoom = {};
  pages.forEach(p => { const w = roomWord_(p.room); (byRoom[w] = byRoom[w] || []).push(p); });
  Object.keys(byRoom).forEach(w => {
    const pg = byRoom[w].sort((a, b) => b.week - a.week);
    const recent = pg.filter(p => p.week >= pg[0].week - 1);
    const facs = people.filter(p => p.room && roomWord_(p.room) === w);
    const owner = facs.length ? facs[0].name : cfg.groupOwner;
    const men = roomRows.filter(r => r['email'] && roomWord_(r['room'] || cfg.cohortName) === w);
    const manFor = (name) => men.find(r => sameName_(r['name'], name)) || null;
    const seen = new Set(want.map(w => w.key));
    const push = (w) => { if (seen.has(w.key)) return; seen.add(w.key); want.push(w); }; // the newest page's wording wins; one card per man or promise
    recent.forEach(p => {
      const pageWhen = p.page.session ? p.page.session.split('.')[0] : 'Week ' + p.week;
      (p.page.followUps || []).forEach(f => {
        const man = manFor(f.name), em = man ? String(man['email']).toLowerCase() : '';
        if (em && /agreement/i.test(f.reason) && (want.some(x => /^(bwm|agr|askans):/.test(x.key) && keyEmail_(x.key) === em) || (handledMap[em] && handledMap[em].agreement))) return; // the desk already carries that card, or the agreement was handled another way (build 22)
        push({ key: 'fu:' + (em || slug_(f.name)), owner: owner, do: 'Follow up: ' + f.reason.replace(/\.$/, ''), for: man ? (man['name'] || em) : f.name,
          because: 'From the Week ' + p.week + ' notes (' + pageWhen + ').', link: p.url, rule: 'R20' });
      });
      (p.page.promised || []).forEach(pr => {
        let own = null;
        if (/^our team$/i.test(pr.owner)) own = 'John';
        else { const pp = people.find(x => sameName_(x.name, pr.owner)); own = pp ? pp.name : null; }
        if (!own) return; // "Every man" is the room's, not a card
        pr.items.forEach(item => push({ key: 'prom:' + slug_(item), owner: own, do: item.charAt(0).toUpperCase() + item.slice(1), for: 'Promised in the room · Week ' + p.week + ' · ' + p.room,
          because: 'Said in the room (' + pageWhen + ').', link: p.url, rule: 'R21' }));
      });
    });
  });
}

/** The facilitator desks, one per room, written into the feed as fac.rooms. The page shows a person the room his People row names. */
function facFeed_(ss, cfg, feed, pages) {
  const rooms = rooms_(ss);
  if (!rooms.length) return { rooms: [] };
  const people = people_();
  const wkSh = ss.getSheetByName('Weeks');
  const weeks = wkSh ? rows_(wkSh).filter(w => nightOf_(w)) : [];
  const pcSh = ss.getSheetByName('Pieces');
  const pieces = pcSh ? rows_(pcSh) : [];
  const roster = feed.roster || [], actions = feed.actions || [];
  const props = PropertiesService.getScriptProperties();
  const now = new Date(), today = dayOf_(now);
  const iso = (d) => d ? toDate_(d).toISOString() : null;
  const dayText = (day) => Utilities.formatDate(dayDate_(day), FD.TZ, 'EEEE, MMM d');
  const links = (s) => String(s || '').split(/\s*\n\s*/).map(x => x.trim()).filter(x => /^https?:\/\//.test(x));
  const titled = (s) => { const lines = String(s || '').split(/\n/).map(x => x.trim()).filter(Boolean); const out = []; for (let i = 0; i < lines.length; i++) { if (/^https?:\/\//.test(lines[i])) { if (out.length && !out[out.length - 1].url) out[out.length - 1].url = lines[i]; else out.push({ title: lines[i], url: lines[i] }); } else out.push({ title: lines[i], url: '' }); } return out; };
  return { rooms: rooms.map((rm, ri) => {
    const facs = people.filter(p => p.room && sameRoom_(p.room, rm.room));
    const facNames = facs.map(p => p.name);
    const wk = weeks.filter(w => (String(w['room'] || '').trim() ? sameRoom_(w['room'], rm.room) : ri === 0)).sort((a, b) => toDate_(nightOf_(a)) - toDate_(nightOf_(b)));
    const cur = wk.find(w => dayOf_(nightOf_(w)) >= today) || null;
    const idx = cur ? wk.indexOf(cur) : wk.length;
    const last = idx > 0 ? wk[idx - 1] : null;
    const lastDay = last ? dayOf_(nightOf_(last)) : (rm.firstNight && rm.firstNight <= today ? rm.firstNight : '');
    const roomRowOf = roomRowIndex_(ss); // build 27: the man's own row on the Room tab
    const men = roomMen_(ss, cfg, rm.room).map(r => {
      const email = String(r['email']).toLowerCase().trim();
      const ro = roster.find(x => String(x.email).toLowerCase() === email) || {};
      const needs = actions.filter(a => keyEmail_(a.key) === email && facNames.some(n => sameName_(n, a.owner))).map(a => ({ key: a.key, do: a.do, because: a.because }));
      const written = ((feed.pieces && feed.pieces.byMan && feed.pieces.byMan[email]) || []); // build 24: what he wrote, by name and date only
      return { seat: Number(r['seat'] || 0), name: r['name'] || '', email: email, how: r['how he got in'] || '', when: iso(r['when (Central)']), agreementSigned: ro.agreementSigned || null, answersIn: ro.answersIn || null, phone: ro.phone || '', needs: needs, written: written, rowLink: roomRowOf[email] || '' };
    }).sort((a, b) => ((b.needs.length ? 1 : 0) - (a.needs.length ? 1 : 0)) || (a.seat - b.seat));
    const pg = (pages || []).filter(p => sameRoom_(p.room, rm.room)).sort((a, b) => b.week - a.week);
    const latest = pg[0] || null, prev = pg[1] || null;
    const nameOf = (email) => { const m = men.find(x => x.email === email); return (m && m.name) || (roster.find(x => String(x.email).toLowerCase() === email) || {}).name || email; };
    const since = [];
    if (lastDay) {
      const after = (v) => v && String(v).slice(0, 10) > lastDay;
      men.forEach(m => { if (after(m.when)) since.push(nameOf(m.email) + ' took seat ' + m.seat + ' on ' + Utilities.formatDate(new Date(m.when), FD.TZ, 'MMM d') + '.'); });
      men.forEach(m => { if (after(m.agreementSigned)) since.push(nameOf(m.email) + ' signed the agreement on ' + Utilities.formatDate(new Date(m.agreementSigned), FD.TZ, 'MMM d') + '.'); });
      men.forEach(m => { if (after(m.answersIn)) since.push(nameOf(m.email) + ' answered the twelve questions on ' + Utilities.formatDate(new Date(m.answersIn), FD.TZ, 'MMM d') + '.'); });
      men.forEach(m => { (m.written || []).forEach(w => { if (after(w.at)) since.push(nameOf(m.email) + ' wrote ' + w.piece + ' on ' + Utilities.formatDate(new Date(w.at), FD.TZ, 'MMM d') + '.'); }); }); // build 24
      if (latest && prev) (prev.page.attendance.absent || []).forEach(n => { if (!(latest.page.attendance.absent || []).some(x => sameName_(x, n))) since.push(n + ' was back in the room on Week ' + latest.week + '.'); });
    }
    const question = null; // build 27: the call question is off the desk (the men connect with one another)
    const pieceNames = cur ? String(cur['piece introduced'] || '').split(/\s*,\s*then\s+|\s*,\s*|\s+then\s+|\s+and\s+/).map(s => s.trim()).filter(Boolean) : [];
    const pieceLinks = cur ? links(cur['piece address']) : [];
    const pieceAsk = pieceNames.map(n => { const p = pieces.find(x => sameName_(x['name'], n) || String(x['name'] || '').toLowerCase() === n.toLowerCase()); return p && p['what this asks of you'] ? { name: n, pace: String(p['pace'] || ''), asks: String(p['what this asks of you']) } : null; }).filter(Boolean);
    const curDay = cur ? dayOf_(nightOf_(cur)) : '';
    const tue = curDay ? addDays_(curDay, -1) : '';
    const hr = hourOf_(rm.meets), timeText = hr ? hr.text : ''; // build 25: the hour is the Rooms tab's, never typed here
    const sent = curDay ? props.getProperty('reminderSent:' + curDay) : null;
    // build 27: the road ahead, the story board and the wider voice
    const fitsOf = (w) => String(w['how it fits'] || '').trim();
    const splitNames = (s) => String(s || '').split(/\s*,\s*then\s+|\s*,\s*|\s+then\s+|\s+and\s+/).map(x => x.trim()).filter(Boolean);
    const ahead = wk.slice(idx + 1).map(w => { const d = dayOf_(nightOf_(w)); const names = splitNames(w['piece introduced']); const addrs = links(w['piece address']);
      return { week: Number(w['week']), day: d, dayText: dayText(d), title: String(w['what opens'] || ''), piece: String(w['piece introduced'] || ''), pieceLinks: names.map((n, i) => ({ name: n, url: addrs[i] || addrs[0] || '' })).filter(p => p.url), fits: fitsOf(w) }; });
    const board = roomBoard_(wk, cur, men, pieces, today);
    let voice = null; try { voice = weekVoice_(cfg, cur ? Number(cur['week']) : 0, rm); } catch (e) { voice = null; }
    const sigRows = signalsRows_(cfg);
    let topic = null; try { topic = weekTopic_(cfg, cur ? Object.assign({ voiceId: voice ? voice.id : '' }, cur) : null, rm, sigRows, latest ? latest.week : 0); } catch (e) { topic = null; }
    return {
      room: rm.room, word: rm.word, kind: rm.kind, meets: rm.meets, course: rm.course, courseLink: rm.course ? SITE_ + '/path-player?courseid=' + rm.course : '',
      facilitators: facNames, sheet: 'https://docs.google.com/spreadsheets/d/' + FD.SHEET_ID + '/edit', weeksOf: wk.length,
      this: cur ? { week: Number(cur['week']), day: curDay, dayText: dayText(curDay), time: timeText, title: String(cur['what opens'] || ''), piece: String(cur['piece introduced'] || ''),
        pieceLinks: pieceNames.map((n, i) => ({ name: n, url: pieceLinks[i] || pieceLinks[0] || '' })).filter(p => p.url), pieceAsk: pieceAsk, articles: titled(cur['article (filled by the script)']),
        ask: String(cur["facilitator's one ask"] || '').trim(), reminder: { sent: sent || null, when: tue ? dayText(tue) + ', ' + fmtHour_(REMINDER_HOUR_) : '' }, fits: fitsOf(cur), voice: voice } : null,
      ahead: ahead, board: board, topic: topic,
      last: last ? { week: Number(last['week']), day: lastDay, dayText: dayText(lastDay), time: timeText, title: String(last['what opens'] || '') } : null,
      men: men, counts: { men: men.length, need: men.filter(m => m.needs.length).length, signed: men.filter(m => m.agreementSigned).length, answered: men.filter(m => m.answersIn).length, noName: men.filter(m => !m.name).length },
      pieces: roomPieces_(wk, cur, men, pieces), // build 24: "Write a Lament: 1 of 9 have written it" — the pieces the weeks have opened so far, counted over the room
      signals: latest ? (latest.page.themes || []).map((t, i) => Object.assign({ week: latest.week, key: 'theme:' + latest.week + ':' + slug_(t.theme) }, t, signalCoding_(sigRows, rm, latest.week, t))) : [], // build 24: the room's signals sit with the room; build 27: with their coding from the Room Signals sheet
      
      links: { signals: cfg.signalsSheetId ? 'https://docs.google.com/spreadsheets/d/' + cfg.signalsSheetId + '/edit' : '' },
      notes: latest ? Object.assign({ week: latest.week, url: latest.url, name: latest.name, updated: latest.updated.toISOString() }, latest.page) : null,
      pages: pg.map(p => ({ week: p.week, url: p.url, name: p.name })),
      since: since, sinceDay: lastDay || null, question: question
    };
  }) };
}
/** One room's desk for one person: the room his People row names, plus the cards and moves that carry his name. */
function facFor_(feed, who) {
  const rooms = (feed && feed.fac && feed.fac.rooms) || [];
  const r = rooms.find(x => sameRoom_(x.room, who.room)) || null;
  const mine = (o) => sameName_(who.name, o);
  const actions = ((feed && feed.actions) || []).filter(a => mine(a.owner));
  const doneWeek = ((feed && feed.doneWeek) || []).filter(a => mine(a.owner) && !/^(pask|psig):/.test(String(a.key || ''))); // build 30; build 32: a partner press is for our team only
  const moves = ((feed && feed.moves && feed.moves.taken) || []).filter(t => mine(t.owner));
  if (!r) return { room: who.room, missing: true, name: who.name, actions: actions, doneWeek: doneWeek, moves: moves };
  const keys = (r.signals || []).map(s => s.key); // build 27: the moves this room's signals have, so an add shows at once
  const sig = { taken: ((feed && feed.moves && feed.moves.taken) || []).filter(t => keys.indexOf(t.key) >= 0), proposed: ((feed && feed.moves && feed.moves.proposed) || []).filter(p => keys.indexOf(p.key) >= 0) };
  return Object.assign({}, r, { name: who.name, actions: actions, doneWeek: doneWeek, moves: moves, sigMoves: sig });
}

/** Done from a facilitator's desk: only a card that carries his name. */
function canClose_(who, key) {
  if (who.role === 'admin') return true;
  const sh = SpreadsheetApp.openById(FD.SHEET_ID).getSheetByName('Actions');
  const row = rows_(sh).find(r => String(r['key'] || '').trim() === key);
  return !!row && sameName_(who.name, row['owner']);
}
/** "Who needs a call this week?" — each man picked becomes a call: card on the picker's lane (rule R22). Asked once per session; "no one" closes it too. */
function callPick_(who, b) {
  if (!who.room) throw { code: 'no_room' };
  const week = Number(b.week || 0);
  if (!week || week > 99) throw { code: 'bad_action' };
  const ss = SpreadsheetApp.openById(FD.SHEET_ID), cfg = readConfig_();
  const men = roomMen_(ss, cfg, who.room);
  const emails = (Array.isArray(b.emails) ? b.emails : []).map(e => String(e || '').toLowerCase().trim()).filter(e => men.some(m => String(m['email']).toLowerCase().trim() === e));
  const sh = ss.getSheetByName('Actions'), H = headerIndex_(sh);
  const have = new Set(rows_(sh).filter(r => r['status'] !== 'done').map(r => String(r['key'] || '').trim()));
  const now = new Date(), added = [];
  emails.forEach(e => {
    const key = 'call:' + week + ':' + e;
    if (have.has(key)) return;
    const man = men.find(m => String(m['email']).toLowerCase().trim() === e);
    const card = { key: key, owner: who.name, do: 'Call him this week', for: (man && man['name']) || e, because: 'You picked him after Week ' + week + ', on ' + fmt_(now) + '.', link: '', firstSeen: now.toISOString(), rule: 'R22', asked: null };
    const row = actionsBlankRow_(sh);
    row[H['key']] = key; row[H['first seen']] = now; row[H['owner']] = card.owner; row[H['do this']] = card.do; row[H['for']] = card.for; row[H['because']] = card.because; row[H['link']] = ''; row[H['status']] = 'open'; row[H['mark done by hand']] = false; row[H['rule']] = 'R22';
    append_(sh, [row]); added.push(card);
  });
  PropertiesService.getScriptProperties().setProperty('fd:call:' + roomWord_(who.room) + ':' + week, now.toISOString() + ' · ' + emails.length + ' picked by ' + who.email);
  try {
    const cell = feedCell_(ss);
    const feed = JSON.parse(cell.getValue() || 'null');
    if (feed) {
      feed.actions = (feed.actions || []).concat(added);
      ((feed.fac && feed.fac.rooms) || []).forEach(r => { if (!sameRoom_(r.room, who.room)) return; r.question = null; (r.men || []).forEach(m => { added.forEach(c => { if (keyEmail_(c.key) === m.email) m.needs = (m.needs || []).concat([{ key: c.key, do: c.do, because: c.because }]); }); }); });
      cell.setValue(JSON.stringify(feed));
    }
  } catch (e) {}
  return { ok: true, week: week, added: added };
}
/** The facilitator's one ask for the week, in his words: written to the Weeks row, carried by the reminder. */
function askSet_(who, b) {
  if (!who.room) throw { code: 'no_room' };
  const week = Number(b.week || 0);
  if (!week || week > 99) throw { code: 'bad_action' };
  const text = bwmSan_(b.text, 300);
  if (/[<>{}]/.test(text) || /^[=+\-@]/.test(text)) throw { code: 'bad_text' };
  const ss = SpreadsheetApp.openById(FD.SHEET_ID);
  const rooms = rooms_(ss);
  const sh = ss.getSheetByName('Weeks'), H = headerIndex_(sh), d = sh.getDataRange().getValues();
  const col = H["facilitator's one ask"];
  if (col === undefined) throw { code: 'failed' };
  let done = false;
  for (let i = 1; i < d.length; i++) {
    if (Number(d[i][H['week']]) !== week) continue;
    const rr = H['room'] !== undefined ? String(d[i][H['room']] || '').trim() : '';
    if (rr ? !sameRoom_(rr, who.room) : !(rooms.length && sameRoom_(rooms[0].room, who.room))) continue;
    sh.getRange(i + 1, col + 1).setValue(text); done = true; break;
  }
  if (!done) throw { code: 'none' };
  try {
    const cell = feedCell_(ss);
    const feed = JSON.parse(cell.getValue() || 'null');
    if (feed && feed.fac) { (feed.fac.rooms || []).forEach(r => { if (sameRoom_(r.room, who.room) && r.this && r.this.week === week) r.this.ask = text; }); cell.setValue(JSON.stringify(feed)); }
  } catch (e) {}
  return { ok: true, week: week, text: text };
}

// ───────────────────────────── build 22 · the practice desk does, not shows ─────────────────────────────

function ensureBuild22_(ss) {
  let nt = ss.getSheetByName('Notes');
  if (!nt) {
    nt = ss.insertSheet('Notes');
    nt.getRange(1, 1, 1, FD.TABS.Notes.length).setValues([FD.TABS.Notes]);
    nt.setFrozenRows(1);
    nt.getRange(2, 3, 500, 1).setNumberFormat('mmm d, yyyy h:mm am/pm');
    [260, 520, 170, 220].forEach((w, i) => nt.setColumnWidth(i + 1, w));
    nt.getRange(2, 1, 500, 4).setVerticalAlignment('top').setWrap(true);
  }
  let hd = ss.getSheetByName('Handled');
  if (!hd) {
    hd = ss.insertSheet('Handled');
    hd.getRange(1, 1, 1, FD.TABS.Handled.length).setValues([FD.TABS.Handled]);
    hd.setFrozenRows(1);
    hd.getRange(2, 3, 500, 1).setNumberFormat('mmm d, yyyy h:mm am/pm');
    [260, 110, 170, 220, 300].forEach((w, i) => hd.setColumnWidth(i + 1, w));
  }
  const props = PropertiesService.getScriptProperties();
  if (props.getProperty('fd:b22') !== '1') {
    ensureConfig_();
    // the nightly copy of the three sheets
    if (!ScriptApp.getProjectTriggers().some(t => t.getHandlerFunction() === 'backupNightly')) {
      ScriptApp.newTrigger('backupNightly').timeBased().everyDays(1).atHour(3).inTimezone(FD.TZ).create();
    }
    // Jason's writing surface is his desk: the sheet goes to view-only for him (ruled Oct 12)
    try {
      const j = 'jason@ancientpathcoaching.com';
      if (ss.getEditors().some(u => String(u.getEmail()).toLowerCase() === j)) { ss.removeEditor(j); ss.addViewer(j); }
    } catch (e) { alert_('Could not set Jason to view-only on the Front Desk sheet: ' + e); }
    props.setProperty('fd:b22', '1');
  }
}

/** 3:00 AM Central: a copy of the Front Desk sheet, the Search profile and the AC count into the Backups folder; copies older than "backups keep days" go to the trash. */
function backupNightly() {
  const cfg = readConfig_();
  let folder = null;
  try { if (cfg.backupFolderId) folder = DriveApp.getFolderById(cfg.backupFolderId); } catch (e) { folder = null; }
  if (!folder) {
    const home = DriveApp.getFileById(FD.SHEET_ID).getParents();
    const parent = home.hasNext() ? home.next() : DriveApp.getRootFolder();
    const it = parent.getFoldersByName('Ancient Path — Backups');
    folder = it.hasNext() ? it.next() : parent.createFolder('Ancient Path — Backups');
    const sh = SpreadsheetApp.openById(FD.SHEET_ID).getSheetByName('Config');
    const d = sh.getDataRange().getValues();
    for (let i = 1; i < d.length; i++) if (String(d[i][0]).trim() === 'backup folder id') { sh.getRange(i + 1, 2).setValue(folder.getId()); break; }
  }
  const day = dayStamp_();
  const ids = [FD.SHEET_ID, cfg.searchSheetId, cfg.acSheetId].filter(Boolean);
  const made = [];
  ids.forEach(id => {
    try {
      const f = DriveApp.getFileById(id);
      const name = f.getName() + ' — backup ' + day;
      if (!folder.getFilesByName(name).hasNext()) { f.makeCopy(name, folder); made.push(name); }
    } catch (e) { alert_('Backup of ' + id + ' failed: ' + e); }
  });
  const cutoff = new Date(Date.now() - cfg.backupKeepDays * 864e5);
  let pruned = 0;
  const files = folder.getFiles();
  while (files.hasNext()) { const f = files.next(); if (/ — backup \d{4}-\d{2}-\d{2}$/.test(f.getName()) && f.getDateCreated() < cutoff) { f.setTrashed(true); pruned++; } }
  PropertiesService.getScriptProperties().setProperty('fd:backup:last', JSON.stringify({ at: new Date().toISOString(), made: made, pruned: pruned, folder: folder.getId() }));
}
function backupState_() { try { return JSON.parse(PropertiesService.getScriptProperties().getProperty('fd:backup:last') || 'null'); } catch (e) { return null; } }

// ---- notes: what a man asked for, written on his card ----
function notes_(ss) {
  const out = {};
  const sh = ss.getSheetByName('Notes');
  if (!sh) return out;
  rows_(sh).forEach(r => { const e = String(r['email'] || '').toLowerCase().trim(); if (e && r['note']) out[e] = { note: String(r['note']), written: r['written'] ? toDate_(r['written']).toISOString() : null, by: String(r['by'] || '') }; });
  return out;
}
/** Action note_set: the note on a man's card (hand raised: what he asked for). Admins, or a facilitator for a man in his room. */
function noteSet_(who, b) {
  const email = String(b.email || '').toLowerCase().trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw { code: 'bad_email' };
  if (!canTouchMan_(who, email) && !(who.room && ownsCardFor_(who, email))) throw { code: 'not_yours' };
  const note = bwmSan_(b.note, 400);
  if (/[<>{}]/.test(note) || /^[=+\-@]/.test(note)) throw { code: 'bad_text' };
  const ss = SpreadsheetApp.openById(FD.SHEET_ID);
  ensureBuild22_(ss);
  const sh = ss.getSheetByName('Notes'), H = headerIndex_(sh), d = sh.getDataRange().getValues();
  const now = new Date();
  let found = false;
  for (let i = 1; i < d.length; i++) {
    if (String(d[i][H['email']] || '').toLowerCase().trim() === email) { sh.getRange(i + 1, H['note'] + 1, 1, 3).setValues([[note, now, who.email]]); found = true; break; }
  }
  if (!found) append_(sh, [[email, note, now, who.email]]);
  try {
    const cell = feedCell_(ss);
    const feed = JSON.parse(cell.getValue() || 'null');
    if (feed) {
      feed.notes = feed.notes || {};
      feed.notes[email] = { note: note, written: now.toISOString(), by: who.email };
      (feed.roster || []).forEach(r => { if (String(r.email).toLowerCase() === email) r.note = note; });
      (feed.actions || []).forEach(a => { if (/^hand:/.test(a.key) && keyEmail_(a.key) === email) { a.note = note; a.because = handBecause_(a.raised, note); } });
      cell.setValue(JSON.stringify(feed));
    }
  } catch (e) {}
  return { ok: true, email: email, note: note, written: now.toISOString() };
}
function ownsCardFor_(who, email) {
  const sh = SpreadsheetApp.openById(FD.SHEET_ID).getSheetByName('Actions');
  return rows_(sh).some(r => r['status'] !== 'done' && keyEmail_(r['key']) === email && sameName_(who.name, r['owner']));
}
function handBecause_(raisedIso, note) {
  const when = raisedIso ? Utilities.formatDate(new Date(raisedIso), FD.TZ, 'MMM d') : '';
  return 'Raised a hand' + (when ? ' on ' + when : '') + ' — he replied asking to talk.' + (note ? ' He asked for: ' + note : ' What did he ask for? Write it on the card and the desk holds it.');
}

// ---- handled another way: the agreement signed on paper, the answers given on a call ----
function handled_(ss) {
  const out = {};
  const sh = ss.getSheetByName('Handled');
  if (!sh) return out;
  rows_(sh).forEach(r => { const e = String(r['email'] || '').toLowerCase().trim(), k = String(r['kind'] || '').toLowerCase().trim(); if (!e || !k) return; (out[e] = out[e] || {})[k] = { at: r['handled'] ? toDate_(r['handled']).toISOString() : null, by: String(r['by'] || '') }; });
  return out;
}
/** Action handled: marks the agreement or the answers as handled by hand for a man; his ask cards close and stay closed. */
function handledSet_(who, b) {
  const email = String(b.email || '').toLowerCase().trim();
  const kind = String(b.kind || '').toLowerCase().trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) throw { code: 'bad_email' };
  if (kind !== 'agreement' && kind !== 'answers') throw { code: 'bad_action' };
  if (!canTouchMan_(who, email)) throw { code: 'not_yours' };
  const ss = SpreadsheetApp.openById(FD.SHEET_ID);
  ensureBuild22_(ss);
  const now = new Date();
  append_(ss.getSheetByName('Handled'), [[email, kind, now, who.email, bwmSan_(b.note, 200)]]);
  // close the cards by hand, so they stay closed
  const sh = ss.getSheetByName('Actions'), H = headerIndex_(sh), d = sh.getDataRange().getValues();
  const closed = [];
  const keys = kind === 'agreement' ? /^(bwm|agr|wl|seat):/ : /^askans:/;
  for (let i = 1; i < d.length; i++) {
    const k = String(d[i][H['key']] || '').trim();
    const fuAgr = kind === 'agreement' && /^fu:/.test(k) && /agreement/i.test(String(d[i][H['do this']] || '')); // a follow-up about the agreement
    if ((!keys.test(k) && !fuAgr) || keyEmail_(k) !== email || d[i][H['status']] === 'done') continue;
    sh.getRange(i + 1, H['mark done by hand'] + 1).setValue(true);
    sh.getRange(i + 1, H['status'] + 1).setValue('done');
    sh.getRange(i + 1, H['done at'] + 1).setValue(now);
    closed.push(k);
  }
  try {
    const cell = feedCell_(ss);
    const feed = JSON.parse(cell.getValue() || 'null');
    if (feed) {
      feed.actions = (feed.actions || []).filter(a => closed.indexOf(a.key) < 0);
      (feed.roster || []).forEach(r => { if (String(r.email).toLowerCase() === email) r[kind === 'agreement' ? 'handledAgreement' : 'handledAnswers'] = now.toISOString(); });
      cell.setValue(JSON.stringify(feed));
    }
  } catch (e) {}
  return { ok: true, email: email, kind: kind, at: now.toISOString(), closed: closed };
}

